<Window x:Class="TransferPlus.Views.FamilySourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:TransferPlus.Models"
        mc:Ignorable="d"
        x:Name="SourcesMainWin"
        Title="Family Sources Settings" Height="520" Width="740"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#FAFAFA">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Soft Green Header Banner -->
        <Border Grid.Row="0" Background="#E8F5E9" BorderBrush="#C3E6CB" BorderThickness="0,0,0,1" Padding="16,12">
            <TextBlock Text="This view allows you to manage the sources used for Revit family files in the application. You can add new family sources, edit existing ones, or remove sources that are no longer needed. Each source can be activated or deactivated, and its active status determines which sources will be displayed in the 'Apply transfer from:' list in the main window. Use the controls provided to organize and maintain your family sources efficiently."
                       Foreground="#155724" FontSize="11.5" TextWrapping="Wrap" LineHeight="16"/>
        </Border>

        <!-- Action Toolbar -->
        <Border Grid.Row="1" Padding="16,10,16,6">
            <StackPanel Orientation="Horizontal">
                <!-- Add Button -->
                <Button Content="➕ Add" Command="{Binding AddSourceCommand}" CommandParameter="{Binding ElementName=SourcesMainWin}" Height="28" Padding="12,4" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="Foreground" Value="#007ACC"/>
                            <Setter Property="BorderBrush" Value="#007ACC"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EBF5FC"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Edit Button -->
                <Button Content="✏️ Edit" Command="{Binding EditSourceCommand}" CommandParameter="{Binding ElementName=SourcesMainWin}" Height="28" Padding="12,4" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="Foreground" Value="#2E7D32"/>
                            <Setter Property="BorderBrush" Value="#2E7D32"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Remove Button -->
                <Button Content="🗑️ Remove" Command="{Binding RemoveSourceCommand}" Height="28" Padding="12,4">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="Foreground" Value="#C62828"/>
                            <Setter Property="BorderBrush" Value="#C62828"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFEBEE"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- Data Grid / ListView -->
        <Border Grid.Row="2" Margin="16,4,16,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <ListView ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      BorderThickness="0" Background="Transparent">
                <ListView.View>
                    <GridView>
                        <!-- Active CheckBox Column -->
                        <GridViewColumn Header="Active" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:FamilySourceItemModel}">
                                    <CheckBox IsChecked="{Binding IsActive}" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Name Column -->
                        <GridViewColumn Header="Name" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:FamilySourceItemModel}">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Source Description Column -->
                        <GridViewColumn Header="Source" Width="420">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:FamilySourceItemModel}">
                                    <TextBlock Text="{Binding SourceDescription}" Foreground="#555555" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Footer Buttons -->
        <Border Grid.Row="3" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Command="{Binding SaveCommand}" CommandParameter="{Binding ElementName=SourcesMainWin}" Height="28" Width="90" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#007ACC"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#005999"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Cancel" Command="{Binding CancelCommand}" CommandParameter="{Binding ElementName=SourcesMainWin}" Height="28" Width="90">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="Foreground" Value="#555555"/>
                            <Setter Property="BorderBrush" Value="#CCCCCC"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
