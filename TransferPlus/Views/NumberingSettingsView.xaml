<Window x:Class="TransferPlus.Views.NumberingSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar secuencia de numeración" 
        Height="520" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0"
        FontFamily="Segoe UI"
        FontSize="11.5">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Tipo Selection -->
            <RowDefinition Height="Auto"/> <!-- Configuración Border -->
            <RowDefinition Height="Auto"/> <!-- Secuencia personalizada Title -->
            <RowDefinition Height="*"/>    <!-- Secuencia personalizada TextBox -->
            <RowDefinition Height="Auto"/> <!-- Buttons Row -->
        </Grid.RowDefinitions>

        <!-- Tipo Row -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Label Content="Tipo:" Width="80" FontWeight="SemiBold"/>
            <RadioButton Content="Numérico" IsChecked="{Binding EditNumTypeNumeric, Mode=TwoWay}" GroupName="NumTypeGroup" Margin="0,0,20,0"/>
            <RadioButton Content="Alfanumérico" IsChecked="{Binding EditNumTypeAlphanumeric, Mode=TwoWay}" GroupName="NumTypeGroup"/>
        </StackPanel>

        <!-- Configuración Group Box (Styled Border) -->
        <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,15" Background="#F9F9F9">
            <StackPanel>
                <TextBlock Text="Configuración" FontWeight="Bold" Margin="0,0,0,12" Foreground="#555"/>
                
                <!-- Orden: Ascendente / Descendente -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Orden:" Grid.Column="0"/>
                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <RadioButton Content="Ascendente" IsChecked="{Binding EditNumOrderAscending, Mode=TwoWay}" GroupName="NumOrderGroup" Margin="0,0,15,0"/>
                        <RadioButton Content="Descendente" IsChecked="{Binding EditNumOrderDescending, Mode=TwoWay}" GroupName="NumOrderGroup"/>
                    </StackPanel>
                </Grid>

                <!-- Número mínimo de dígitos -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Número mínimo de dígitos:" Grid.Column="0"/>
                    <TextBox Text="{Binding EditNumMinDigits, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Height="26"/>
                </Grid>

                <!-- Número inicial / Letra inicial on the same row -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Número inicial:" Grid.Column="0"/>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" MinWidth="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding EditNumStartNumber, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Height="26" IsEnabled="{Binding EditNumTypeNumeric}"/>
                        <Label Content="Letra inicial:" Grid.Column="1" Margin="8,0,4,0"/>
                        <TextBox Text="{Binding EditNumStartLetter, UpdateSourceTrigger=PropertyChanged}" Grid.Column="2" Height="26" IsEnabled="{Binding EditNumTypeAlphanumeric}"/>
                    </Grid>
                </Grid>

                <!-- Prefijo -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Prefijo:" Grid.Column="0"/>
                    <TextBox Text="{Binding EditNumPrefix, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Height="26"/>
                </Grid>

                <!-- Sufijo -->
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Sufijo:" Grid.Column="0"/>
                    <TextBox Text="{Binding EditNumSuffix, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Height="26"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Secuencia personalizada Title -->
        <Label Content="Secuencia personalizada:" Grid.Row="2" FontWeight="SemiBold" Margin="0,0,0,5"/>

        <!-- Secuencia personalizada TextBox -->
        <Grid Grid.Row="3" Margin="0,0,0,20">
            <TextBox x:Name="CustomSeqTextBox" Text="{Binding EditNumCustomSequence, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="70" VerticalContentAlignment="Top" Padding="6"/>
            <TextBlock Text="e.g. A1, B2, C3, D4..." Foreground="#AAAAAA" IsHitTestVisible="False" Margin="10,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=CustomSeqTextBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Buttons Row -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Aceptar" Click="Accept_Click" Grid.Column="1" Width="90" Height="28" Margin="0,0,10,0" FontWeight="SemiBold" IsDefault="True">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#007ACC"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Style.Resources>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Cancelar" Click="Cancel_Click" Grid.Column="2" Width="90" Height="28" IsCancel="True">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#E1E1E1"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="BorderBrush" Value="#707070"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Style.Resources>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>
