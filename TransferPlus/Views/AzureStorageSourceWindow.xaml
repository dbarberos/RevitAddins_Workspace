<Window x:Class="TransferPlus.Views.AzureStorageSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Name="AzureSourceWin"
        Title="Family source settings" Height="520" Width="640"
        Icon="pack://application:,,,/TransferPlus;component/Resources/Icons/TransferPlus32x32.png"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FAFAFA">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Soft Green Header Banner -->
        <Border Grid.Row="0" Background="#E8F5E9" BorderBrush="#C3E6CB" BorderThickness="0,0,0,1" Padding="14,12">
            <TextBlock Text="This view allows you to configure an Azure Storage source for Revit family files. Enter the necessary connection details, such as the storage account, container name, and Connection String, to access your files stored in Azure. You can activate or deactivate this source as needed. Use these settings to securely manage and organize your cloud-based family sources within the application."
                       Foreground="#155724" FontSize="11.5" TextWrapping="Wrap" LineHeight="16"/>
        </Border>

        <!-- Form Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>
                <!-- 2-Column Grid for main options -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 0: Left Fields -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Name" FontWeight="SemiBold" FontSize="12" Foreground="#333333" Margin="0,0,0,4">
                            <TextBlock.ToolTip>
                                <ToolTip MaxWidth="225">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Name</Bold><LineBreak/>
                                        Friendly label to identify this Azure Storage source in the main selection dropdown.<LineBreak/><LineBreak/>
                                        <Bold>Example:</Bold> Azure Standard Library<LineBreak/>
                                        <Bold>Where to find:</Bold> Arbitrary user-defined text.
                                    </TextBlock>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4"
                                 BorderBrush="#CCCCCC" BorderThickness="1" Background="White" FontSize="12" Margin="0,0,0,12">
                            <TextBox.ToolTip>
                                <ToolTip MaxWidth="225">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Name</Bold><LineBreak/>
                                        Friendly label to identify this Azure Storage source in the main selection dropdown.<LineBreak/><LineBreak/>
                                        <Bold>Example:</Bold> Azure Standard Library<LineBreak/>
                                        <Bold>Where to find:</Bold> Arbitrary user-defined text.
                                    </TextBlock>
                                </ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>

                        <TextBlock Text="Container name" FontWeight="SemiBold" FontSize="12" Foreground="#333333" Margin="0,0,0,4">
                            <TextBlock.ToolTip>
                                <ToolTip MaxWidth="225">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Container Name</Bold><LineBreak/>
                                        Target Azure Storage container name containing Revit family (.rfa) blob files.<LineBreak/><LineBreak/>
                                        <Bold>Example:</Bold> revit-families-2024<LineBreak/>
                                        <Bold>Where to find:</Bold> Azure Portal (portal.azure.com) -> Storage accounts -> Containers tab.
                                    </TextBlock>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBox Text="{Binding ContainerName, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4"
                                 BorderBrush="#CCCCCC" BorderThickness="1" Background="White" FontSize="12" Margin="0,0,0,12">
                            <TextBox.ToolTip>
                                <ToolTip MaxWidth="225">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Container Name</Bold><LineBreak/>
                                        Target Azure Storage container name containing Revit family (.rfa) blob files.<LineBreak/><LineBreak/>
                                        <Bold>Example:</Bold> revit-families-2024<LineBreak/>
                                        <Bold>Where to find:</Bold> Azure Portal (portal.azure.com) -> Storage accounts -> Containers tab.
                                    </TextBlock>
                                </ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>

                        <TextBlock Text="Root path" FontWeight="SemiBold" FontSize="12" Foreground="#333333" Margin="0,0,0,4">
                            <TextBlock.ToolTip>
                                <ToolTip MaxWidth="225">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Root Path (Prefix)</Bold><LineBreak/>
                                        Optional subfolder prefix inside the container to filter specific family files.<LineBreak/><LineBreak/>
                                        <Bold>Example:</Bold> Architecture/Doors/<LineBreak/>
                                        <Bold>Where to find:</Bold> Subfolder path hierarchy inside your Azure container.
                                    </TextBlock>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBox Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4"
                                 BorderBrush="#CCCCCC" BorderThickness="1" Background="White" FontSize="12" Margin="0,0,0,12">
                            <TextBox.ToolTip>
                                <ToolTip MaxWidth="225">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Root Path (Prefix)</Bold><LineBreak/>
                                        Optional subfolder prefix inside the container to filter specific family files.<LineBreak/><LineBreak/>
                                        <Bold>Example:</Bold> Architecture/Doors/<LineBreak/>
                                        <Bold>Where to find:</Bold> Subfolder path hierarchy inside your Azure container.
                                    </TextBlock>
                                </ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>
                    </StackPanel>

                    <!-- Column 2: Right Fields -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Endpoint url" FontWeight="SemiBold" FontSize="12" Foreground="#333333" Margin="0,0,0,4">
                            <TextBlock.ToolTip>
                                <ToolTip MaxWidth="225">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Endpoint URL</Bold><LineBreak/>
                                        Service URL endpoint for Azure Storage API or local Azurite emulator.<LineBreak/><LineBreak/>
                                        <Bold>Example:</Bold> http://127.0.0.1:10000<LineBreak/>
                                        <Bold>Where to find:</Bold> Select preset or Azure Portal Storage Account Overview.
                                    </TextBlock>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <ComboBox ItemsSource="{Binding EndpointPresets}" Text="{Binding EndpointUrl, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" Height="28" Padding="6,2" BorderBrush="#CCCCCC" BorderThickness="1"
                                  Background="White" FontSize="12" Margin="0,0,0,12">
                            <ComboBox.ToolTip>
                                <ToolTip MaxWidth="225">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Endpoint URL</Bold><LineBreak/>
                                        Service URL endpoint for Azure Storage API or local Azurite emulator.<LineBreak/><LineBreak/>
                                        <Bold>Example:</Bold> http://127.0.0.1:10000<LineBreak/>
                                        <Bold>Where to find:</Bold> Select preset or Azure Portal Storage Account Overview.
                                    </TextBlock>
                                </ToolTip>
                            </ComboBox.ToolTip>
                        </ComboBox>

                        <TextBlock Text="Client ID" FontWeight="SemiBold" FontSize="12" Foreground="#333333" Margin="0,0,0,4">
                            <TextBlock.ToolTip>
                                <ToolTip MaxWidth="225">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Client ID (Azure AD)</Bold><LineBreak/>
                                        Application (client) ID registered in Microsoft Entra ID for OAuth.<LineBreak/><LineBreak/>
                                        <Bold>Example:</Bold> 00000000-0000-0000-0000-000000000000<LineBreak/>
                                        <Bold>Where to find:</Bold> Azure Portal -> Microsoft Entra ID -> App registrations.
                                    </TextBlock>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4"
                                 BorderBrush="#CCCCCC" BorderThickness="1" Background="White" FontSize="12" Margin="0,0,0,12">
                            <TextBox.ToolTip>
                                <ToolTip MaxWidth="225">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Client ID (Azure AD)</Bold><LineBreak/>
                                        Application (client) ID registered in Microsoft Entra ID for OAuth.<LineBreak/><LineBreak/>
                                        <Bold>Example:</Bold> 00000000-0000-0000-0000-000000000000<LineBreak/>
                                        <Bold>Where to find:</Bold> Azure Portal -> Microsoft Entra ID -> App registrations.
                                    </TextBlock>
                                </ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>

                        <TextBlock Text="Tenant ID" FontWeight="SemiBold" FontSize="12" Foreground="#333333" Margin="0,0,0,4">
                            <TextBlock.ToolTip>
                                <ToolTip MaxWidth="225">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Tenant ID (Azure AD)</Bold><LineBreak/>
                                        Directory (tenant) ID of your Azure Active Directory instance.<LineBreak/><LineBreak/>
                                        <Bold>Example:</Bold> 11111111-1111-1111-1111-111111111111<LineBreak/>
                                        <Bold>Where to find:</Bold> Azure Portal -> Microsoft Entra ID -> Overview.
                                    </TextBlock>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBox Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4"
                                 BorderBrush="#CCCCCC" BorderThickness="1" Background="White" FontSize="12" Margin="0,0,0,12">
                            <TextBox.ToolTip>
                                <ToolTip MaxWidth="225">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Tenant ID (Azure AD)</Bold><LineBreak/>
                                        Directory (tenant) ID of your Azure Active Directory instance.<LineBreak/><LineBreak/>
                                        <Bold>Example:</Bold> 11111111-1111-1111-1111-111111111111<LineBreak/>
                                        <Bold>Where to find:</Bold> Azure Portal -> Microsoft Entra ID -> Overview.
                                    </TextBlock>
                                </ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>
                    </StackPanel>
                </Grid>

                <!-- Full Width Field: Connection String (Encrypted on Disk via DPAPI) -->
                <TextBlock Text="Connection String (Encrypted securely via DPAPI)" FontWeight="SemiBold" FontSize="12" Foreground="#333333" Margin="0,0,0,4">
                    <TextBlock.ToolTip>
                        <ToolTip MaxWidth="225">
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                <Bold>Connection String</Bold><LineBreak/>
                                Secure authorization string containing storage account key or SAS token.<LineBreak/><LineBreak/>
                                <Bold>Example:</Bold> DefaultEndpointsProtocol=https;AccountName=...<LineBreak/>
                                <Bold>Where to find:</Bold> Azure Portal -> Storage account -> Access keys. Encrypted on disk via DPAPI.
                            </TextBlock>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
                <TextBox Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4"
                         BorderBrush="#CCCCCC" BorderThickness="1" Background="White" FontSize="11.5" FontFamily="Consolas" Margin="0,0,0,12">
                    <TextBox.ToolTip>
                        <ToolTip MaxWidth="225">
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                <Bold>Connection String</Bold><LineBreak/>
                                Secure authorization string containing storage account key or SAS token.<LineBreak/><LineBreak/>
                                <Bold>Example:</Bold> DefaultEndpointsProtocol=https;AccountName=...<LineBreak/>
                                <Bold>Where to find:</Bold> Azure Portal -> Storage account -> Access keys. Encrypted on disk via DPAPI.
                            </TextBlock>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>

                <!-- Active CheckBox and Test Connection Row -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" Content="Active" IsChecked="{Binding IsActive}" FontSize="12" Foreground="#222222" Cursor="Hand" VerticalAlignment="Center">
                        <CheckBox.ToolTip>
                            <ToolTip MaxWidth="225">
                                <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                    <Bold>Active Status</Bold><LineBreak/>
                                    Enables or disables this Azure Storage source in the main application dropdown.<LineBreak/><LineBreak/>
                                    <Bold>Example:</Bold> Checked (Active)<LineBreak/>
                                    <Bold>Where to find:</Bold> User preference toggle.
                                </TextBlock>
                            </ToolTip>
                        </CheckBox.ToolTip>
                    </CheckBox>

                    <!-- Status Indicator -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="👤" FontSize="14" Foreground="#888888" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SignedInStatus}" FontSize="11.5" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Test Connection Button -->
                    <Button Grid.Column="2" Content="⚡ Test Connection" Command="{Binding TestConnectionCommand}" Height="26" Padding="10,2">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#007ACC"/>
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Style.Resources>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EBF5FC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Command="{Binding OkCommand}" CommandParameter="{Binding ElementName=AzureSourceWin}" Height="28" Width="80" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#007ACC"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#005999"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Cancel" Command="{Binding CancelCommand}" CommandParameter="{Binding ElementName=AzureSourceWin}" Height="28" Width="80">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="Foreground" Value="#555555"/>
                            <Setter Property="BorderBrush" Value="#CCCCCC"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
