<Window x:Class="TransferPlus.Views.DirectorySourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Name="DirSourceWin"
        Title="Family source settings" Height="390" Width="540"
        Icon="pack://application:,,,/TransferPlus;component/Resources/Icons/TransferPlus32x32.png"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FAFAFA">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Soft Green Header Banner -->
        <Border Grid.Row="0" Background="#E8F5E9" BorderBrush="#C3E6CB" BorderThickness="0,0,0,1" Padding="14,12">
            <TextBlock Text="This view allows you to configure a directory-based source for Revit family files. Enter a name for the source and select the folder containing your family files. You can activate or deactivate this source as needed. Use the folder button to browse and select the directory. These settings help organize and manage your family sources efficiently within the application."
                       Foreground="#155724" FontSize="11.5" TextWrapping="Wrap" LineHeight="16"/>
        </Border>

        <!-- Form Body -->
        <StackPanel Grid.Row="1" Margin="20,16">
            <!-- Name Field -->
            <TextBlock Text="Name" FontWeight="SemiBold" FontSize="12.5" Foreground="#333333" Margin="0,0,0,4">
                <TextBlock.ToolTip>
                    <ToolTip MaxWidth="225">
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                            <Bold>Name</Bold><LineBreak/>
                            Friendly label to identify this local folder source in the main selection dropdown.<LineBreak/><LineBreak/>
                            <Bold>Example:</Bold> Office Standard Families<LineBreak/>
                            <Bold>Where to find:</Bold> Arbitrary user-defined text.
                        </TextBlock>
                    </ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4"
                     BorderBrush="#CCCCCC" BorderThickness="1" Background="White" FontSize="12.5" Margin="0,0,0,14">
                <TextBox.ToolTip>
                    <ToolTip MaxWidth="225">
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                            <Bold>Name</Bold><LineBreak/>
                            Friendly label to identify this local folder source in the main selection dropdown.<LineBreak/><LineBreak/>
                            <Bold>Example:</Bold> Office Standard Families<LineBreak/>
                            <Bold>Where to find:</Bold> Arbitrary user-defined text.
                        </TextBlock>
                    </ToolTip>
                </TextBox.ToolTip>
            </TextBox>

            <!-- Directory Field -->
            <TextBlock Text="Directory" FontWeight="SemiBold" FontSize="12.5" Foreground="#333333" Margin="0,0,0,4">
                <TextBlock.ToolTip>
                    <ToolTip MaxWidth="225">
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                            <Bold>Directory Path</Bold><LineBreak/>
                            Absolute file system folder path containing Revit family (.rfa) files to load.<LineBreak/><LineBreak/>
                            <Bold>Example:</Bold> C:\BIM_Standards\Revit_Families<LineBreak/>
                            <Bold>Where to find:</Bold> Windows File Explorer or local network shared drive.
                        </TextBlock>
                    </ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding Directory, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4"
                         BorderBrush="#CCCCCC" BorderThickness="1" Background="White" FontSize="12.5">
                    <TextBox.ToolTip>
                        <ToolTip MaxWidth="225">
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                <Bold>Directory Path</Bold><LineBreak/>
                                Absolute file system folder path containing Revit family (.rfa) files to load.<LineBreak/><LineBreak/>
                                <Bold>Example:</Bold> C:\BIM_Standards\Revit_Families<LineBreak/>
                                <Bold>Where to find:</Bold> Windows File Explorer or local network shared drive.
                            </TextBlock>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>
                
                <Button Grid.Column="2" Command="{Binding BrowseDirectoryCommand}" Content="📁" Height="28" Width="36">
                    <Button.ToolTip>
                        <ToolTip MaxWidth="225">
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                <Bold>Browse Folder</Bold><LineBreak/>
                                Opens a folder picker dialog to select a folder from your disk.
                            </TextBlock>
                        </ToolTip>
                    </Button.ToolTip>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="Foreground" Value="#007ACC"/>
                            <Setter Property="BorderBrush" Value="#CCCCCC"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Active CheckBox -->
            <CheckBox Content="Active" IsChecked="{Binding IsActive}" FontSize="12.5" Foreground="#222222" Cursor="Hand">
                <CheckBox.ToolTip>
                    <ToolTip MaxWidth="225">
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                            <Bold>Active Status</Bold><LineBreak/>
                            Enables or disables this local folder source in the main application dropdown.<LineBreak/><LineBreak/>
                            <Bold>Example:</Bold> Checked (Active)<LineBreak/>
                            <Bold>Where to find:</Bold> User preference toggle.
                        </TextBlock>
                    </ToolTip>
                </CheckBox.ToolTip>
            </CheckBox>
        </StackPanel>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Command="{Binding OkCommand}" CommandParameter="{Binding ElementName=DirSourceWin}" Height="28" Width="80" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#007ACC"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#005999"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Cancel" Command="{Binding CancelCommand}" CommandParameter="{Binding ElementName=DirSourceWin}" Height="28" Width="80">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="Foreground" Value="#555555"/>
                            <Setter Property="BorderBrush" Value="#CCCCCC"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
