<Window x:Class="TransferPlus.Views.LevelMappingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:TransferPlus.Models"
        x:Name="ThisWindow"
        Title="Resolve Missing Levels" 
        Height="500" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        
        <!-- Premium Cards style -->
        <Style x:Key="ConflictCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EAEAEA"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DFDFDF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005B9A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title / Info -->
            <RowDefinition Height="*"/>    <!-- Conflict List -->
            <RowDefinition Height="Auto"/> <!-- Footer buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Missing Levels Resolution" FontSize="18" FontWeight="Bold" Foreground="#333333"/>
            <TextBlock Text="The following levels are required by plan views but do not exist in the destination. Please select a mapping or creation policy for each level." 
                       Foreground="#666666" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Conflict List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <ItemsControl ItemsSource="{Binding Conflicts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:LevelConflict}">
                        <Border Style="{StaticResource ConflictCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Card Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M12,2L1,21H23L12,2M12,6L19.53,19H4.47L12,6M11,10V14H13V10H11M11,16V18H13V16H11Z" 
                                              Fill="#E67E22" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Missing Source Level: " FontWeight="SemiBold" FontSize="13" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SourceLevelName}" FontWeight="Bold" FontSize="13" Foreground="#E67E22" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SourceElevationText, StringFormat='Elevation: {0}'}" 
                                               FontStyle="Italic" Foreground="#666666" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Card Options -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Action Selection (RadioButtons) -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <RadioButton Content="Create new level in destination" 
                                                     GroupName="{Binding SourceLevelName}"
                                                     IsChecked="{Binding IsCreateNew}"
                                                     Margin="0,4"
                                                     x:Name="CreateRadio"/>
                                        <TextBox Text="{Binding NewLevelName, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsChecked, ElementName=CreateRadio}"
                                                 Margin="20,2,0,8"
                                                 Width="200" Height="22"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"/>
                                        <RadioButton Content="Map to an existing level" 
                                                     GroupName="{Binding SourceLevelName}"
                                                     IsChecked="{Binding IsMapToExisting}"
                                                     Margin="0,4"
                                                     x:Name="MapRadio"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <!-- Level Selection Dropdown -->
                                        <ComboBox ItemsSource="{Binding AvailableTargetLevels}" 
                                                  SelectedItem="{Binding SelectedTargetLevelName}"
                                                  IsEnabled="{Binding IsChecked, ElementName=MapRadio}"
                                                  Height="26" Width="200" HorizontalAlignment="Left"
                                                  Margin="0,0,0,8"/>
                                        
                                        <!-- Quick Suggestion Buttons -->
                                        <WrapPanel Orientation="Horizontal">
                                            <!-- Exact Match -->
                                            <Button Style="{StaticResource ActionButtonStyle}" 
                                                    Content="Exact Elevation Match" 
                                                    Command="{Binding SelectLevelAndMapCommand}"
                                                    CommandParameter="{Binding ExactMatchLevelName}"
                                                    Visibility="{Binding HasExactMatch, Converter={StaticResource BoolToVisibility}}"/>

                                            <!-- Lower Level -->
                                            <Button Style="{StaticResource ActionButtonStyle}" 
                                                    Content="{Binding ClosestLowerLevelName, StringFormat='Lower: {0}'}" 
                                                    Command="{Binding SelectLevelAndMapCommand}"
                                                    CommandParameter="{Binding ClosestLowerLevelName}"
                                                    Visibility="{Binding HasClosestLower, Converter={StaticResource BoolToVisibility}}"/>

                                            <!-- Upper Level -->
                                            <Button Style="{StaticResource ActionButtonStyle}" 
                                                    Content="{Binding ClosestUpperLevelName, StringFormat='Upper: {0}'}" 
                                                    Command="{Binding SelectLevelAndMapCommand}"
                                                    CommandParameter="{Binding ClosestUpperLevelName}"
                                                    Visibility="{Binding HasClosestUpper, Converter={StaticResource BoolToVisibility}}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button Content="Cancel Transfer" Grid.Column="1" Margin="0,0,10,0" Padding="15,8" FontWeight="SemiBold"
                    Command="{Binding CancelCommand}" CommandParameter="{Binding ElementName=ThisWindow}"
                    Background="#E0E0E0" BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand"/>
            
            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Apply Mapping" Grid.Column="2" 
                    Command="{Binding ApplyCommand}" CommandParameter="{Binding ElementName=ThisWindow}"/>
        </Grid>
    </Grid>
</Window>
