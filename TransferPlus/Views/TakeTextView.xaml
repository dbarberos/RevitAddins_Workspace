<Window x:Class="TransferPlus.Views.TakeTextView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter Text" Height="150" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow" Background="#fafafa">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="PromptLabel" Text="Enter text:" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBox x:Name="InputTextBox" Grid.Row="1" Padding="5" VerticalAlignment="Center"/>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="75" Height="25" IsDefault="True" Click="Ok_Click" Margin="0,0,10,0" Background="#007ACC" Foreground="White" BorderThickness="0"/>
            <Button Content="Cancel" Width="75" Height="25" IsCancel="True" Click="Cancel_Click" Background="#ccc" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
