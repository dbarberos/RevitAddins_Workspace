<Window x:Class="TransferPlus.Views.ConfirmCadDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:TransferPlus.Models"
        Title="Confirm Element Deletion - Active Model"
        Icon="pack://application:,,,/TransferPlus;component/Resources/Icons/TransferPlus32x32.png"
        Height="460" Width="700"
        MinHeight="380" MinWidth="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F0F0F0"
        FontFamily="Segoe UI"
        FontSize="11.5">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Hierarchical Tree -->
            <RowDefinition Height="Auto"/> <!-- Footer / Summary + Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Warning Icon -->
            <Path Grid.Column="0" 
                  Data="M12,2L1,21H23L12,2M12,6L19.53,19H4.47L12,6M11,10V14H13V10H11M11,16V18H13V16H11Z" 
                  Fill="#D32F2F" Width="26" Height="26" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Top"/>

            <!-- Header Text -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Confirm Element Deletion from Active Model" 
                           FontWeight="Bold" FontSize="13" Foreground="#D32F2F" Margin="0,0,0,3"/>
                <TextBlock Text="The following detail/CAD element(s) will be permanently deleted from the active Revit model." 
                           FontSize="11.5" Foreground="#333333" TextWrapping="Wrap"/>
                <TextBlock Text="Parent hierarchical containers (Sheets and Views) will NOT be deleted and remain in the model for reuse." 
                           FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Hierarchical Tree of Elements to Delete -->
        <Border Grid.Row="1" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="3" Margin="0,0,0,12">
            <TreeView x:Name="DeletionTreeView" BorderThickness="0" Background="Transparent" Padding="6">
                <TreeView.Resources>
                    <!-- Sheet Template -->
                    <HierarchicalDataTemplate DataType="{x:Type models:CadDeleteSheetGroup}" ItemsSource="{Binding Views}">
                        <StackPanel Orientation="Horizontal" Margin="2,3,2,3">
                            <Border Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,8,0">
                                <TextBlock Text="Sheet" FontSize="9.5" FontWeight="Bold" Foreground="#1565C0"/>
                            </Border>
                            <TextBlock Text="{Binding SheetName}" FontWeight="SemiBold" Foreground="#222222" VerticalAlignment="Center"/>
                            <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#2E7D32"/>
                            </Border>
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <!-- View Template -->
                    <HierarchicalDataTemplate DataType="{x:Type models:CadDeleteViewGroup}" ItemsSource="{Binding Items}">
                        <StackPanel Orientation="Horizontal" Margin="2,2,2,2">
                            <Border Background="#EDE7F6" BorderBrush="#D1C4E9" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,8,0">
                                <TextBlock Text="View" FontSize="9.5" FontWeight="Bold" Foreground="#512DA8"/>
                            </Border>
                            <TextBlock Text="{Binding ViewName}" Foreground="#333333" VerticalAlignment="Center"/>
                            <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#2E7D32"/>
                            </Border>
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <!-- Leaf CAD Item Template -->
                    <DataTemplate DataType="{x:Type models:CadDeleteItemNode}">
                        <StackPanel Orientation="Horizontal" Margin="2,2,2,2">
                            <TextBlock Text="•" FontWeight="Bold" Foreground="#D32F2F" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#111111" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Category, StringFormat='({0})'}" Foreground="#666666" FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ElementIdText}" Foreground="#888888" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <Border Background="#FFEBEE" BorderBrush="#FFCDD2" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" FontSize="9.5" FontWeight="Bold" Foreground="#D32F2F"/>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </TreeView.Resources>

                <!-- Expand all items by default -->
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True"/>
                        <Setter Property="Padding" Value="2"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </Border>

        <!-- Footer / Summary and Action Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Summary Count -->
            <TextBlock Grid.Column="0" x:Name="SummaryTextBlock" 
                       Text="Total: 0 elements to delete." 
                       FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center"/>

            <!-- Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="90" Height="28" Click="Cancel_Click" 
                        Background="#E0E0E0" BorderBrush="#CCCCCC" BorderThickness="1" FontWeight="SemiBold"
                        IsCancel="True" Cursor="Hand"/>
                <Button Content="Delete Elements" Width="130" Height="28" Margin="10,0,0,0" Click="Delete_Click" 
                        Background="#D32F2F" Foreground="White" BorderThickness="0" FontWeight="Bold"
                        IsDefault="True" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
