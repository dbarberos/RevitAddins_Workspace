<Window x:Class="TransferPlus.Views.AutodeskDocsSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Name="AccSourceWin"
        Title="Autodesk Docs (APS) Family Source Settings" Height="620" Width="660"
        WindowStartupLocation="CenterOwner"
        Background="#FAFAFA">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0" Background="#E8F5E9" BorderBrush="#C3E6CB" BorderThickness="0,0,0,1" Padding="14,12">
            <TextBlock Text="Configure Autodesk Construction Cloud (ACC / BIM 360) as a family source. Click 'Sign In with Autodesk Account' to log in safely, explore your hubs and projects, and select the folder containing your Revit .rfa families."
                       Foreground="#155724" FontSize="11.5" TextWrapping="Wrap" LineHeight="16"/>
        </Border>

        <!-- User-Friendly Authentication Section -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sign In Button -->
                    <Button Grid.Column="0" Command="{Binding SignInWithAutodeskCommand}" Height="36" Width="240" HorizontalAlignment="Left" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#0696D7"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Style.Resources>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#007ACC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔑  Sign In with Autodesk Account" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- User Profile / Status Badge -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="🟢 " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Connected: " FontWeight="Bold" FontSize="12" Foreground="#2E7D32" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ConnectedUserName}" FontWeight="SemiBold" FontSize="12" Foreground="#333333" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#666666" FontStyle="Italic" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Log Out Button -->
                    <Button Grid.Column="2" Content="Log Out / Switch Account" Command="{Binding LogOutCommand}" Height="28" Width="145" Margin="8,0,0,0"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" Background="White" Foreground="#D32F2F" BorderBrush="#EF9A9A" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                </Grid>

                <!-- Advanced Developer Settings Expander -->
                <Expander Header="Advanced Developer Settings (Client ID / Access Tokens)" Margin="0,6,0,0" Foreground="#666" FontSize="11">
                    <Border Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="APS Client ID:" FontWeight="SemiBold" FontSize="11" Foreground="#444" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" Height="22" FontSize="11"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Access Token:" FontSize="11" Foreground="#444" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding AccessToken, UpdateSourceTrigger=PropertyChanged}" Height="22" FontSize="11"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Refresh Token:" FontSize="11" Foreground="#444" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding RefreshToken, UpdateSourceTrigger=PropertyChanged}" Height="22" FontSize="11"/>
                            </Grid>
                            <Button Content="Connect Using Advanced Tokens" Command="{Binding ConnectAndLoadHubsCommand}" Height="24" Width="200" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </Border>

        <!-- Dynamic TreeView Navigation (Hubs -> Projects -> Folders) -->
        <Border Grid.Row="2" Margin="16,12,16,8" BorderBrush="#CCCCCC" BorderThickness="1" Background="White" CornerRadius="4">
            <Grid>
                <TreeView ItemsSource="{Binding TreeNodes}" TreeViewItem.Expanded="TreeView_ItemExpanded" SelectedItemChanged="TreeView_SelectedItemChanged" Margin="4">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="#222"/>
                                <ProgressBar IsIndeterminate="True" Width="14" Height="14" Margin="6,0,0,0"
                                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>

        <!-- Source Options Footer -->
        <StackPanel Grid.Row="3" Margin="16,4,16,8">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Source Display Name:" FontWeight="SemiBold" FontSize="12" Foreground="#333" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Text="{Binding SourceName, UpdateSourceTrigger=PropertyChanged}" Height="24" Padding="4,2"/>
            </Grid>

            <CheckBox Content="Active (Enable this source in TransferPlus)" IsChecked="{Binding IsActive}" FontSize="12" Foreground="#333"/>
        </StackPanel>

        <!-- Action Buttons -->
        <Border Grid.Row="4" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Command="{Binding OkCommand}" CommandParameter="{Binding ElementName=AccSourceWin}" Height="28" Width="80" Margin="0,0,8,0"
                        Background="#007ACC" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" CommandParameter="{Binding ElementName=AccSourceWin}" Height="28" Width="80"
                        Background="White" Foreground="#555" BorderBrush="#CCC" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
