<Window x:Class="TransferPlus.Views.DuplicatesAbortView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transfer Aborted - Duplicate Elements" 
        Height="420" Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F0F0F0"
        FontFamily="Segoe UI"
        FontSize="11.5">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title / Warning icon -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Path Data="M12,2L1,21H23L12,2M12,6L19.53,19H4.47L12,6M11,10V14H13V10H11M11,16V18H13V16H11Z" 
                  Fill="#D32F2F" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="Transfer aborted because duplicate element names exist in the target model." 
                       FontWeight="SemiBold" FontSize="12" Foreground="#D32F2F" VerticalAlignment="Center" TextWrapping="Wrap" Width="640"/>
        </StackPanel>

        <!-- DataGrid of Duplicates -->
        <DataGrid Grid.Row="1" x:Name="DuplicatesDataGrid" AutoGenerateColumns="False" 
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" 
                  BorderBrush="#D0D0D0" BorderThickness="1" SelectionMode="Extended" SelectionUnit="FullRow"
                  IsReadOnly="True" ClipboardCopyMode="ExcludeHeader" Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Category / Group" Binding="{Binding Categoria}" Width="150" FontSize="11">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Family / Hierarchy" Binding="{Binding Familia}" Width="150" FontSize="11">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="6,4"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Element Class" Binding="{Binding Clase}" Width="130" FontSize="11">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="Foreground" Value="#555555"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Duplicate Name" Binding="{Binding Nombre}" Width="*" FontSize="11">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="#D32F2F"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button Content="Copy Selected" Grid.Column="0" Width="110" Height="28" Click="CopySelected_Click" 
                    Background="#E0E0E0" BorderBrush="#CCCCCC" BorderThickness="1" FontWeight="SemiBold"/>
            <Button Content="Copy All" Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" Width="100" Height="28" Click="CopyAll_Click" 
                    Background="#E0E0E0" BorderBrush="#CCCCCC" BorderThickness="1" FontWeight="SemiBold"/>
            
            <Button Content="OK" Grid.Column="2" Width="90" Height="28" Click="Ok_Click" 
                    Background="#007ACC" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
