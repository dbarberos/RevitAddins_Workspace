                                                       FontSize="11.5" 
                                                       Foreground="#333333" 
                                                       Cursor="Hand"
                                                       Margin="0,0,0,3"
                                                       ToolTip="When enabled, downloaded families are saved into subfolders organized by their Revit category."/>

                                             <!-- 2. Set Default View as 3D -->
                                             <CheckBox Content="Set Default View as 3D" 
                                                       Style="{StaticResource SwitchStyle}"
                                                       IsChecked="{Binding SetDefaultView3DOnDownload}" 
                                                       VerticalAlignment="Center" 
                                                       FontSize="11.5" 
                                                       Foreground="#333333" 
                                                       Cursor="Hand"
                                                       Margin="0,0,0,3"
                                                       ToolTip="When enabled, sets the default preview view of downloaded families to 3D before saving."/>

