<Window x:Class="TransferPlus.Views.TransferPlusView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TransferPlus.Views"
        xmlns:viewmodels="clr-namespace:TransferPlus.ViewModels"
        mc:Ignorable="d"
        Title="TransferPlus" Height="840"
        Icon="pack://application:,,,/TransferPlus;component/Resources/Icons/TransferPlus32x32.png"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Width" Value="885"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRenamePanelOpen}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width" To="1385" Duration="0:0:0.3">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width" To="885" Duration="0:0:0.3">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TransferPlus;component/Resources/Styles/TransferPlusStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <local:NegativeConverter x:Key="NegativeConverter"/>
            
            <HierarchicalDataTemplate x:Key="CheckboxTreeTemplate" DataType="{x:Type viewmodels:TreeItemViewModel}" ItemsSource="{Binding Children}">
                <Grid Margin="2,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" IsThreeState="True" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="NodeNameText" Grid.Column="1" Text="{Binding Name}" FontWeight="Normal" Foreground="#333333" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                    <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="#888888" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="15,0,10,0"/>
                </Grid>
                <HierarchicalDataTemplate.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsMouseOver}" Value="True">
                        <Setter TargetName="NodeNameText" Property="Foreground" Value="#007ACC"/>
                    </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="BorderBrush" Value="#e8e8e8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#000000" Opacity="0.03" BlurRadius="5" ShadowDepth="2"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FilterPlusTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#333"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <Style x:Key="StandardCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFamiliesManagerActive}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FamiliesManagerCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFamiliesManagerActive}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="*"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRenamePanelOpen}" Value="True">
                                <Setter Property="Width" Value="Auto"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRenamePanelOpen}" Value="True">
                                <Setter Property="Width" Value="*"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Apply filter from -->
                <RowDefinition Height="*"/>    <!-- Row 1: Main Tree + Right Side Cards -->
                <RowDefinition Height="Auto"/> <!-- Row 2: Submit Buttons -->
            </Grid.RowDefinitions>

        <!-- TOP ROW: SOURCE SELECT AND INCLUDE LINKS -->
        <Border Grid.Row="0" Margin="0,0,0,5" Padding="0,0,0,8" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Apply transfer from:" FontWeight="Bold" FontSize="12" Margin="0,0,0,5" Foreground="#333"/>
                    <Border BorderBrush="#007ACC" BorderThickness="1.5" CornerRadius="4" Height="30" Background="White" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding SourceDocuments}" SelectedItem="{Binding SelectedSourceDocument}" DisplayMemberPath="Nombre" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding EsVinculo}" Value="True"/>
                                                <Condition Binding="{Binding DataContext.CopyLinks, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </Border>
                </StackPanel>

                <CheckBox Grid.Column="1" Content="Include Links as Source" IsChecked="{Binding CopyLinks}" Style="{StaticResource SwitchStyle}" VerticalAlignment="Bottom" Margin="10,0,9,3"/>
            </Grid>
        </Border>
        
        <!-- MAIN ROW -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="451"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="376"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Source Selection, Explorer TreeView, Destination Selection -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Transfer To header -->
                    <RowDefinition Height="0.525*"/> <!-- Transfer To ListBox (reduced by 30%) -->
                    <RowDefinition Height="Auto"/> <!-- What header -->
                    <RowDefinition Height="Auto"/> <!-- Tree columns header -->
                    <RowDefinition Height="2*"/>   <!-- TreeView -->
                </Grid.RowDefinitions>

                <!-- Transfer To -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Transfer to:" FontWeight="Bold" FontSize="12" Foreground="#333" Margin="0"/>
                    <TextBlock Text="{Binding CheckedDestinationsText}" FontSize="11" Foreground="#666" Margin="10,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Row="1" BorderBrush="#ddd" BorderThickness="1" Background="White" Margin="0,0,0,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DestinationDocuments}" Margin="10,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" Margin="0,3" VerticalContentAlignment="Center" Cursor="Hand">
                                        <CheckBox.Content>
                                            <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center" Margin="0" FontSize="12" Foreground="#222" FontWeight="Normal"/>
                                        </CheckBox.Content>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- What Header -->
                <TextBlock Grid.Row="2" Text="What:" FontWeight="Bold" FontSize="12" Margin="0,5,0,5" Foreground="#333"/>

                <!-- TreeView Header Row -->
                <Border Grid.Row="3" Background="#f0f0f0" BorderBrush="#ddd" BorderThickness="1,1,1,0" Padding="5,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center" Margin="0">
                            <TextBlock Text="Elements" FontWeight="SemiBold" FontSize="11" Foreground="#555" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Button Command="{Binding ExpandAllCommand}" Style="{StaticResource HeaderIconButtonStyle}" ToolTip="Expand All" VerticalAlignment="Center">
                                <Path Data="M0,0 L10,0 L5,8 Z" Fill="#666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Command="{Binding CollapseAllCommand}" Style="{StaticResource HeaderIconButtonStyle}" ToolTip="Collapse All" VerticalAlignment="Center">
                                <Path Data="M5,0 L10,8 L0,8 Z" Fill="#666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Count" FontWeight="SemiBold" FontSize="11" Foreground="#555" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                    </Grid>
                </Border>

                <!-- TreeView container -->
                <Border Grid.Row="4" BorderBrush="#ddd" BorderThickness="1" Background="White">
                    <TreeView FlowDirection="LeftToRight" 
                              ItemsSource="{Binding RootNodes}" 
                              ItemTemplate="{StaticResource CheckboxTreeTemplate}"
                              SelectedItemChanged="TreeView_SelectedItemChanged"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              BorderThickness="0" Background="Transparent">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
                                <Setter Property="Background" Value="#f9f9f9"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <!-- Header row acts as background for whole line. Border is White for gap -->
                                                <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="0,0,0,1" SnapsToDevicePixels="true">
                                                    <Grid>
                                                         <Grid.ColumnDefinitions>
                                                             <ColumnDefinition Width="Auto"/>
                                                             <ColumnDefinition Width="*"/>
                                                         </Grid.ColumnDefinitions>
                                                         <!-- Expander Toggle -->
                                                         <ToggleButton x:Name="Expander" Grid.Column="0" Margin="{Binding IndentMargin}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                                             <ToggleButton.Template>
                                                                 <ControlTemplate TargetType="ToggleButton">
                                                                     <Border Width="20" Height="20" Background="Transparent" Cursor="Hand">
                                                                         <TextBlock x:Name="ExpanderText" Text="▶" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10" Foreground="Gray"/>
                                                                     </Border>
                                                                     <ControlTemplate.Triggers>
                                                                         <Trigger Property="IsChecked" Value="True">
                                                                             <Setter TargetName="ExpanderText" Property="Text" Value="▼"/>
                                                                         </Trigger>
                                                                     </ControlTemplate.Triggers>
                                                                 </ControlTemplate>
                                                             </ToggleButton.Template>
                                                         </ToggleButton>
                                                         <!-- Content Row -->
                                                         <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                    </Grid>
                                                </Border>
                                                <!-- No margin on ItemsHost to avoid WPF default indentation cutting off Backgrounds -->
                                                <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="false">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                                <Trigger Property="HasItems" Value="false">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="true">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#007ACC"/>
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                        <Setter Property="Background" Value="#e8f5e9"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked}" Value="{x:Null}">
                                        <Setter Property="Background" Value="#fff8e1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Border>
            </Grid>

            <!-- Separator -->

            <!-- Right Column: Settings & Options -->
            <Border Grid.Column="2" Margin="10,0,0,0">
                <ScrollViewer FlowDirection="RightToLeft" VerticalScrollBarVisibility="Auto">
                    <StackPanel FlowDirection="LeftToRight" Margin="0,0,9,0">
                        
                        <!-- Filter Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Search Box -->
                                    <RowDefinition Height="Auto"/> <!-- Search Toggles -->
                                </Grid.RowDefinitions>
                                <!-- Search Row -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Filter:" FontWeight="Bold" FontSize="12" Foreground="#999" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="2" BorderBrush="#e0e0e0" BorderThickness="1"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                         <Button Content="Apply" Command="{Binding FilterTreeCommand}" Padding="12,3" VerticalAlignment="Center">
                                             <Button.Style>
                                                 <Style TargetType="Button">
                                                     <Setter Property="Background" Value="#007ACC"/>
                                                     <Setter Property="Foreground" Value="White"/>
                                                     <Setter Property="BorderThickness" Value="0"/>
                                                     <Setter Property="Cursor" Value="Hand"/>
                                                     <Setter Property="Template">
                                                         <Setter.Value>
                                                             <ControlTemplate TargetType="Button">
                                                                 <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                                     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                 </Border>
                                                             </ControlTemplate>
                                                         </Setter.Value>
                                                     </Setter>
                                                     <Style.Triggers>
                                                         <Trigger Property="IsEnabled" Value="False">
                                                             <Setter Property="Background" Value="#F3F3F3"/>
                                                             <Setter Property="Foreground" Value="#B0B0B0"/>
                                                             <Setter Property="BorderBrush" Value="Transparent"/>
                                                         </Trigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </Button.Style>
                                         </Button>
                                     </StackPanel>
                                </Grid>
             
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                                     <CheckBox Content="Use OR" IsChecked="{Binding FilterUseOr}" Style="{StaticResource SwitchStyle}" FontSize="11" Margin="0,0,10,0"/>
                                     <CheckBox Content="Only by name" IsChecked="{Binding FilterOnlyNames}" Style="{StaticResource SwitchStyle}" FontSize="11" Margin="0,0,10,0"/>
                                     <CheckBox Content="Use Regex" IsChecked="{Binding FilterUseRegex}" Style="{StaticResource SwitchStyle}" FontSize="11" Margin="0,0,0,0"/>

                                     <!-- RegEx Helper Button for Filter -->
                                     <ToggleButton x:Name="BtnFilterRegexHelper" Width="20" Height="20" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Regex help" ToolTipService.InitialShowDelay="600">
                                         <ToggleButton.Template>
                                             <ControlTemplate TargetType="ToggleButton">
                                                 <Border CornerRadius="10" Background="#F3F3F3" BorderThickness="1" BorderBrush="#E0E0E0">
                                                     <TextBlock Text="i" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#555" FontWeight="SemiBold" FontSize="10" FontStyle="Italic"/>
                                                 </Border>
                                             </ControlTemplate>
                                         </ToggleButton.Template>
                                     </ToggleButton>

                                     <Popup IsOpen="{Binding IsChecked, ElementName=BtnFilterRegexHelper, Mode=TwoWay}" StaysOpen="False" PlacementTarget="{Binding ElementName=BtnFilterRegexHelper}" Placement="Bottom" AllowsTransparency="True" Margin="0,5,0,0">
                                         <Border Background="White" BorderBrush="#ccc" BorderThickness="1" CornerRadius="4" Padding="10" Width="400" MaxHeight="500">
                                             <Border.Effect>
                                                 <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                                             </Border.Effect>
                                             <ScrollViewer MaxHeight="450" VerticalScrollBarVisibility="Auto">
                                                 <StackPanel>
                                                     <StackPanel.Resources>
                                                         <Style TargetType="Button">
                                                             <Setter Property="Background" Value="Transparent"/>
                                                             <Setter Property="BorderThickness" Value="0"/>
                                                             <Setter Property="Padding" Value="5"/>
                                                             <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                             <Setter Property="Cursor" Value="Hand"/>
                                                         </Style>
                                                     </StackPanel.Resources>
                                                     <TextBlock Text="Regex Help (Filter)" FontWeight="Bold" Margin="0,0,0,15" FontSize="14"/>
                                                     <!-- Category: Basic Matching & Anchors -->
                                                     <TextBlock Text="Basic Matching &amp; Anchors" FontWeight="Bold" Foreground="#333" Margin="0,10,0,5" FontSize="11"/>
                                                     <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="^[\w\s\W]+$" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                                         <Grid Margin="0,0,0,5" Width="355">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="110"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                                 <TextBlock Text="^[\w\s\W]+$" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="9.5" Foreground="#111"/>
                                                             </Border>
                                                             <TextBlock Grid.Column="1" Text="Selects the full title completely" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                         </Grid>
                                                     </Button>
                                                     <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="text" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                                         <Grid Margin="0,0,0,5" Width="355">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="110"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                                 <TextBlock Text="text" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                             </Border>
                                                             <TextBlock Grid.Column="1" Text="Matches the exact text" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                         </Grid>
                                                     </Button>
                                                     <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="c.sa" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                                         <Grid Margin="0,0,0,5" Width="355">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="110"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                                 <TextBlock Text="c.sa" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                             </Border>
                                                             <TextBlock Grid.Column="1" Text="Matches any single character (e.g. casa, cosa)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                         </Grid>
                                                     </Button>
                                                     <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="^" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                                         <Grid Margin="0,0,0,5" Width="355">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="110"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                                 <TextBlock Text="^" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                             </Border>
                                                             <TextBlock Grid.Column="1" Text="Start of string anchor" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                         </Grid>
                                                     </Button>
                                                     <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="$" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                                         <Grid Margin="0,0,0,5" Width="355">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="110"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                                 <TextBlock Text="$" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                             </Border>
                                                             <TextBlock Grid.Column="1" Text="End of string anchor" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                         </Grid>
                                                     </Button>
                                                     <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="^text" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                                         <Grid Margin="0,0,0,5" Width="355">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="110"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                                 <TextBlock Text="^text" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                             </Border>
                                                             <TextBlock Grid.Column="1" Text="Starts with 'text'" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                         </Grid>
                                                     </Button>
                                                     <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="text$" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                                         <Grid Margin="0,0,0,5" Width="355">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="110"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                                 <TextBlock Text="text$" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                             </Border>
                                                             <TextBlock Grid.Column="1" Text="Ends with 'text'" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                         </Grid>
                                                     </Button>
                                                     <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter=".*text.*" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
