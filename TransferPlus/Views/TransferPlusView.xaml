        </Grid>
        
        <!-- PowerRename Panel (Sidebar) -->
        <Grid Grid.Column="1" x:Name="ColRenameParent">
            <Border x:Name="RenamePanel" ClipToBounds="True" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0"
                    HorizontalAlignment="Left" Width="{Binding ElementName=ColRenameParent, Path=ActualWidth}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="MaxWidth" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRenamePanelOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="MaxWidth" To="2000" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="MaxWidth" To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                
                <Grid Margin="15" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Body (Controls and Previews) -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Controls (aligned with Apply transfer from ComboBox) -->
                    <StackPanel Grid.Row="0" Margin="0,21,0,15">
                        <!-- Find Input -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Center">
                                <TextBox x:Name="FindTextBox" Text="{Binding RenameSearchText, UpdateSourceTrigger=PropertyChanged}" Padding="2" VerticalAlignment="Center" BorderBrush="#e0e0e0" BorderThickness="1"/>
                                <TextBlock Text="Find" Foreground="#aaa" Margin="5,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=FindTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            
                            <!-- RegEx Helper Button -->
                            <ToggleButton x:Name="BtnRegexHelper" Grid.Column="1" Width="20" Height="20" Margin="5,0,0,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Regex help" ToolTipService.InitialShowDelay="600">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border CornerRadius="10" Background="#F3F3F3" BorderThickness="1" BorderBrush="#E0E0E0">
                                            <TextBlock Text="i" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#555" FontWeight="SemiBold" FontSize="10" FontStyle="Italic"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            
                            <Popup IsOpen="{Binding IsChecked, ElementName=BtnRegexHelper, Mode=TwoWay}" StaysOpen="False" PlacementTarget="{Binding ElementName=BtnRegexHelper}" Placement="Bottom" AllowsTransparency="True" Margin="0,5,0,0">
                                <Border Background="White" BorderBrush="#ccc" BorderThickness="1" CornerRadius="4" Padding="10" Width="400" MaxHeight="500">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="450" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                                <StackPanel.Resources>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Padding" Value="5"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                    </Style>
                                                </StackPanel.Resources>
                                                <TextBlock Text="Regex Help" FontWeight="Bold" Margin="0,0,0,15" FontSize="14"/>
                                                <!-- Category: Basic Matching & Anchors -->
                                                <TextBlock Text="Basic Matching &amp; Anchors" FontWeight="Bold" Foreground="#333" Margin="0,10,0,5" FontSize="11"/>
                                                <Button Command="{Binding InsertRegexHelperCommand}" CommandParameter="^[\w\s\W]+$" Click="CloseRegexPopup" HorizontalAlignment="Stretch">
                                                    <Grid Margin="0,0,0,5" Width="355">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                            <TextBlock Text="^[\w\s\W]+$" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="9.5" Foreground="#111"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="Selects the full title completely" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                    </Grid>
                                                </Button>
                                                <Button Command="{Binding InsertRegexHelperCommand}" CommandParameter="text" Click="CloseRegexPopup" HorizontalAlignment="Stretch">
                                                    <Grid Margin="0,0,0,5" Width="355">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                            <TextBlock Text="text" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="Matches the exact text" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                    </Grid>
                                                </Button>
                                                <Button Command="{Binding InsertRegexHelperCommand}" CommandParameter="c.sa" Click="CloseRegexPopup" HorizontalAlignment="Stretch">
                                                    <Grid Margin="0,0,0,5" Width="355">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="*"/>
