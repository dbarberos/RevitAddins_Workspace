<Window x:Class="TransferPlus.Views.TransferPlusView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:TransferPlus.ViewModels"
        mc:Ignorable="d"
        Title="TransferPlus v5.0.0" Height="800" Width="1000"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance viewModels:TransferPlusViewModel}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TransferPlus;component/Resources/Styles/TransferPlusStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <HierarchicalDataTemplate DataType="{x:Type viewModels:TreeItemViewModel}" ItemsSource="{Binding Children}">
                <Grid Margin="2,0" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                    
                    <TextBlock Grid.Column="1" Text="{Binding NumText}" Foreground="Gray" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                    
                    <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="Gray" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#fafafa" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Source Selection, Explorer TreeView, Destination Selection -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- From combobox -->
                    <RowDefinition Height="Auto"/> <!-- What header -->
                    <RowDefinition Height="Auto"/> <!-- Tree columns header -->
                    <RowDefinition Height="*"/>    <!-- TreeView -->
                    <RowDefinition Height="Auto"/> <!-- To header -->
                    <RowDefinition Height="180"/>  <!-- Dest listbox -->
                </Grid.RowDefinitions>

                <!-- From Card -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="From:" FontWeight="Bold" FontSize="12" Margin="0,0,0,5" Foreground="#333"/>
                    <ComboBox ItemsSource="{Binding SourceDocuments}" SelectedItem="{Binding SelectedSourceDocument}" DisplayMemberPath="Nombre" Padding="8" Background="White"/>
                </StackPanel>

                <!-- What Header -->
                <TextBlock Grid.Row="1" Text="What:" FontWeight="Bold" FontSize="12" Margin="0,5,0,5" Foreground="#333"/>

                <!-- TreeView Header Row -->
                <Border Grid.Row="2" Background="#f0f0f0" BorderBrush="#ddd" BorderThickness="1,1,1,0" Padding="5,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Elements" FontWeight="SemiBold" FontSize="11" Foreground="#555"/>
                        <TextBlock Grid.Column="1" Text="Num" FontWeight="SemiBold" FontSize="11" Foreground="#555" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="2" Text="Count" FontWeight="SemiBold" FontSize="11" Foreground="#555" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                    </Grid>
                </Border>

                <!-- TreeView -->
                <Border Grid.Row="3" BorderBrush="#ddd" BorderThickness="1" Background="White">
                    <ScrollViewer FlowDirection="RightToLeft" VerticalScrollBarVisibility="Auto">
                        <TreeView FlowDirection="LeftToRight" ItemsSource="{Binding RootNodes}" BorderThickness="0" Background="Transparent" VirtualizingStackPanel.IsVirtualizing="True">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </ScrollViewer>
                </Border>

                <!-- To Header -->
                <TextBlock Grid.Row="4" Text="To:" FontWeight="Bold" FontSize="12" Margin="0,10,0,5" Foreground="#333"/>

                <!-- Destination Documents ListBox -->
                <Border Grid.Row="5" BorderBrush="#ddd" BorderThickness="1" Background="White">
                    <ScrollViewer FlowDirection="RightToLeft" VerticalScrollBarVisibility="Auto">
                        <ItemsControl FlowDirection="LeftToRight" ItemsSource="{Binding DestinationDocuments}" Margin="10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Nombre}" IsChecked="{Binding Checked, Mode=TwoWay}" Margin="0,4" FontSize="12"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Separator -->
            <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Center" Background="#e0e0e0" Margin="0,5"/>

            <!-- Right Column: Settings & Options -->
            <Border Grid.Column="2" Margin="10,0,0,0">
                <ScrollViewer FlowDirection="RightToLeft" VerticalScrollBarVisibility="Auto">
                    <StackPanel FlowDirection="LeftToRight" Margin="0,0,15,0">
                        
                        <!-- Include Links Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <CheckBox Content="Include Links as Source" IsChecked="{Binding CopyLinks}" Style="{StaticResource SwitchStyle}" Margin="0,4"/>
                                <TextBlock Text="Transform By:" FontWeight="SemiBold" FontSize="11" Margin="0,6,0,3" Foreground="#555"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="None" IsChecked="{Binding TransformNone}" Margin="0,0,12,0"/>
                                    <RadioButton Content="Link" IsChecked="{Binding TransformLink}" Margin="0,0,12,0"/>
                                    <RadioButton Content="Shared" IsChecked="{Binding TransformShared}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Search Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,8" VerticalContentAlignment="Center"/>
                                <Button Grid.Row="1" Grid.Column="0" Content="Search Next" Command="{Binding FilterTreeCommand}" Padding="6" Margin="0,0,5,0" Background="#f0f0f0" BorderBrush="#ccc"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" Content="Regex" IsChecked="{Binding FilterUseRegex}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Manage Checked Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Manage Checked:" Style="{StaticResource FilterPlusTextBlockStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" Grid.Column="0" Content="Delete" Command="{Binding DeleteElementsCommand}" Margin="2" Padding="6" Background="White" Foreground="#C80000" BorderBrush="#FFC1C1" BorderThickness="1"/>
                                    <Button Grid.Row="0" Grid.Column="1" Content="UPPER Case" Command="{Binding ChangeCaseCommand}" CommandParameter="upper" Margin="2" Padding="6" Background="White" BorderBrush="#ccc"/>
                                    
                                    <Button Grid.Row="1" Grid.Column="0" Content="Add Prefix" Command="{Binding AddPrefixCommand}" Margin="2" Padding="6" Background="White" BorderBrush="#ccc"/>
                                    <Button Grid.Row="1" Grid.Column="1" Content="lower Case" Command="{Binding ChangeCaseCommand}" CommandParameter="lower" Margin="2" Padding="6" Background="White" BorderBrush="#ccc"/>
                                    
                                    <Button Grid.Row="2" Grid.Column="0" Content="Add Suffix" Command="{Binding AddSuffixCommand}" Margin="2" Padding="6" Background="White" BorderBrush="#ccc"/>
                                    <Button Grid.Row="2" Grid.Column="1" Content="Proper Case" Command="{Binding ChangeCaseCommand}" CommandParameter="proper" Margin="2" Padding="6" Background="White" BorderBrush="#ccc"/>
                                    
                                    <Button Grid.Row="3" Grid.Column="0" Content="Find Replace" Command="{Binding FindReplaceCommand}" Margin="2" Padding="6" Background="White" BorderBrush="#ccc"/>
                                    
                                    <Button Grid.Row="4" Grid.Column="0" Content="Find Replace Number:" Margin="2" Padding="6" Background="White" BorderBrush="#ccc"/>
                                    <Button Grid.Row="4" Grid.Column="1" Content="Advanced Rename" Margin="2" Padding="6" Background="White" BorderBrush="#ccc"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Elements Checked Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Elements Checked:" Style="{StaticResource FilterPlusTextBlockStyle}"/>
                                <TextBlock Text="{Binding CheckedElementsCount}" FontSize="24" FontWeight="Bold" Foreground="#007ACC" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Options Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="On Duplicates: " VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="#555"/>
                                    <RadioButton Content="Ok" IsChecked="{Binding OverrideDuplicates}" Margin="6,0,10,0"/>
                                    <RadioButton Content="Abort" IsChecked="{Binding CancelDuplicates}" Margin="0,0,10,0"/>
                                    <RadioButton Content="Ask User" IsChecked="{Binding AskDuplicates}"/>
                                </StackPanel>
                                
                                <CheckBox Content="Accept on all Dialogs" IsChecked="{Binding AcceptAllWarnings}" Style="{StaticResource SwitchStyle}" Margin="0,4"/>
                                
                                <CheckBox Content="Transfer Sheet with Views" IsChecked="{Binding IncludeSheetsWithViews}" Style="{StaticResource SwitchStyle}" Margin="0,4"/>
                                <StackPanel Margin="20,2,0,6">
                                    <CheckBox Content="Use Legend if Exists in Target" IsChecked="{Binding UseLegendIfExists}" Style="{StaticResource SwitchStyle}" Margin="0,3"/>
                                    <CheckBox Content="Use Schedule if Exists in Target" IsChecked="{Binding UseScheduleIfExists}" Style="{StaticResource SwitchStyle}" Margin="0,3"/>
                                    <CheckBox Content="Use Assembly Views if Exists in Targ" IsChecked="{Binding UseAssemblyViewsIfExists}" Style="{StaticResource SwitchStyle}" Margin="0,3"/>
                                </StackPanel>

                                <CheckBox Content="Transfer Callouts of Views" IsChecked="{Binding IncludeCallouts}" Style="{StaticResource SwitchStyle}" Margin="0,4"/>
                                <CheckBox Content="Transfer View Elements (Ask User)" IsChecked="{Binding IncludeViewElements}" Style="{StaticResource SwitchStyle}" Margin="0,4"/>
                                <CheckBox Content="Force Level in Level Base Views (Ask User)" IsChecked="{Binding ForceLevelInLevelBaseViews}" Style="{StaticResource SwitchStyle}" Margin="0,4"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Row: Filter and Command Buttons -->
        <Grid Grid.Row="1" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Bottom Left: Filters -->
            <StackPanel Grid.Column="0">
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Filter Elements: " VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#333"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="5,0"/>
                    <Button Grid.Column="2" Content="Clear" Command="{Binding ClearFilterCommand}" Padding="8,4" Background="#f0f0f0" BorderBrush="#ccc"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="95,0,0,0">
                    <CheckBox Content="Use OR (default AND)" IsChecked="{Binding FilterUseOr}" Margin="0,0,15,0"/>
                    <CheckBox Content="Only Use Names" IsChecked="{Binding FilterOnlyNames}" Margin="0,0,15,0"/>
                    <CheckBox Content="Use Regex" IsChecked="{Binding FilterUseRegex}"/>
                </StackPanel>
            </StackPanel>

            <!-- Bottom Right: Execution Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Transfer Single" Command="{Binding TransferCommand}" Width="130" Height="36" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="Select" Width="90" Height="36" Background="White" BorderBrush="#ccc" Margin="0,0,8,0"/>
                <Button Content="View Log" Width="90" Height="36" Background="White" BorderBrush="#ccc"/>
            </StackPanel>
        </Grid>

        <!-- Busy Overlay -->
        <Grid Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="10" Padding="25" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1" BorderBrush="#ddd">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <ProgressBar Value="{Binding ProgressPercentage}" IsIndeterminate="{Binding ProgressPercentage, Converter={x:Null}}" Width="250" Height="8"/>
                    <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0}%}" HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="11" Foreground="Gray"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>