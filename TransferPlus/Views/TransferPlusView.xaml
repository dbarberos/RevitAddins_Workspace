        <!-- PowerRename Panel (Sidebar) -->
        <Grid Grid.Column="1" x:Name="ColRenameParent">
            <Border x:Name="RenamePanel" ClipToBounds="True" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0"
                    HorizontalAlignment="Left" Width="{Binding ElementName=ColRenameParent, Path=ActualWidth}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="MaxWidth" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRenamePanelOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="MaxWidth" To="2000" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="MaxWidth" To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                
                <Grid Margin="15" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Body (Controls and Previews) -->
