                                                    <Grid Margin="0,0,0,5" Width="470">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8,0" MinHeight="35" Margin="0,0,10,0">
                                                            <TextBlock Text="$ff" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="Milliseconds represented only by the first two digits." VerticalAlignment="Center" Foreground="#555" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Button>
                                                <Button Command="{Binding InsertDateHelperCommand}" CommandParameter="$f" Click="CloseDatePopup">
                                                    <Grid Margin="0,0,0,5" Width="470">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8,0" MinHeight="35" Margin="0,0,10,0">
                                                            <TextBlock Text="$f" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="Milliseconds represented only by the first digit." VerticalAlignment="Center" Foreground="#555" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Button>
                                                <TextBlock Text="Replace using advanced counter syntax" FontWeight="Bold" Margin="0,15,0,10" FontSize="12" Foreground="#333"/>
                                                <Button Command="{Binding InsertDateHelperCommand}" CommandParameter="${}" Click="CloseDatePopup">
                                                    <Grid Margin="0,0,0,5" Width="470">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8,0" MinHeight="35" Margin="0,0,10,0">
                                                            <TextBlock Text="${}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="A simple counter that can be used anywhere in a string." VerticalAlignment="Center" Foreground="#555" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Button>
                                                <Button Command="{Binding InsertDateHelperCommand}" CommandParameter="${start=10}" Click="CloseDatePopup">
                                                    <Grid Margin="0,0,0,5" Width="470">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8,0" MinHeight="35" Margin="0,0,10,0">
                                                            <TextBlock Text="${start=10}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="A counter with a custom starting value." VerticalAlignment="Center" Foreground="#555" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Button>
                                                <Button Command="{Binding InsertDateHelperCommand}" CommandParameter="${increment=5}" Click="CloseDatePopup">
                                                    <Grid Margin="0,0,0,5" Width="470">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8,0" MinHeight="35" Margin="0,0,10,0">
                                                            <TextBlock Text="${increment=5}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="A counter with a custom increment value." VerticalAlignment="Center" Foreground="#555" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Button>
                                                <Button Command="{Binding InsertDateHelperCommand}" CommandParameter="${padding=8}" Click="CloseDatePopup">
                                                    <Grid Margin="0,0,0,5" Width="470">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8,0" MinHeight="35" Margin="0,0,10,0">
                                                            <TextBlock Text="${padding=8}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="Counter with a custom number of padding zeros." VerticalAlignment="Center" Foreground="#555" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Button>
                                                <Button Command="{Binding InsertDateHelperCommand}" CommandParameter="${increment=3,padding=4,start=900}" Click="CloseDatePopup">
                                                    <Grid Margin="0,0,0,5" Width="470">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8,0" MinHeight="35" Margin="0,0,10,0">
                                                            <TextBlock Text="${increment=3,padding=4,start=900}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="A counter that displays numbers with custom increment, padding and start." VerticalAlignment="Center" Foreground="#555" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Button>
                                                <TextBlock Text="Replace with random values" FontWeight="Bold" Margin="0,15,0,10" FontSize="12" Foreground="#333"/>
                                                <Button Command="{Binding InsertDateHelperCommand}" CommandParameter="${rstringalnum=9}" Click="CloseDatePopup">
                                                    <Grid Margin="0,0,0,5" Width="470">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8,0" MinHeight="35" Margin="0,0,10,0">
                                                            <TextBlock Text="${rstringalnum=9}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="Random string with uppercase letters, lowercase letters, and numbers." VerticalAlignment="Center" Foreground="#555" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Button>
                                                <Button Command="{Binding InsertDateHelperCommand}" CommandParameter="${rstringalpha=13}" Click="CloseDatePopup">
                                                    <Grid Margin="0,0,0,5" Width="470">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8,0" MinHeight="35" Margin="0,0,10,0">
                                                            <TextBlock Text="${rstringalpha=13}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="Random string with uppercase and lowercase letters." VerticalAlignment="Center" Foreground="#555" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Button>
                                                <Button Command="{Binding InsertDateHelperCommand}" CommandParameter="${rstringdigit=36}" Click="CloseDatePopup">
                                                    <Grid Margin="0,0,0,5" Width="470">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8,0" MinHeight="35" Margin="0,0,10,0">
                                                            <TextBlock Text="${rstringdigit=36}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="Random string with digits between 0 and 9, length 36." VerticalAlignment="Center" Foreground="#555" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Button>
                                                <Button Command="{Binding InsertDateHelperCommand}" CommandParameter="${ruuidv4}" Click="CloseDatePopup">
                                                    <Grid Margin="0,0,0,5" Width="470">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8,0" MinHeight="35" Margin="0,0,10,0">
                                                            <TextBlock Text="${ruuidv4}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="Random UUID according to v4 specification." VerticalAlignment="Center" Foreground="#555" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Text Format -->
                        <TextBlock Text="Text format:" Margin="0,0,0,8" Foreground="#555" FontSize="12"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Foreground" Value="#333"/>
                                    <Setter Property="Background" Value="#F3F3F3"/>
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Margin" Value="0,0,4,0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="#007ACC"/>
                                            <Setter Property="BorderBrush" Value="#007ACC"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#EBEBEB"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsChecked" Value="True"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" Value="#005A9E"/>
                                        </MultiTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Resources>
                            <!-- ToggleButtons for Casing -->
                            <ToggleButton Content="aa" ToolTip="Lowercase" IsChecked="{Binding IsFormatLowercase, Mode=TwoWay}" Width="36" Height="32"/>
                            <ToggleButton Content="AA" ToolTip="Uppercase" IsChecked="{Binding IsFormatUppercase, Mode=TwoWay}" Width="36" Height="32"/>
                            <ToggleButton Content="Aa" ToolTip="Title Case" IsChecked="{Binding IsFormatTitleCase, Mode=TwoWay}" Width="36" Height="32"/>
                            <ToggleButton Content="Aa Aa" ToolTip="Capitalize Each Word" IsChecked="{Binding IsFormatCapitalizeEach, Mode=TwoWay}" Width="52" Height="32" Margin="0,0,15,0"/>
                            
                            <!-- ToggleButtons for Enumeration and Random -->
                            <ToggleButton ToolTip="Enumerate Items" IsChecked="{Binding RenameEnumerateItems, Mode=TwoWay}" Width="36" Height="32">
                                <Viewbox Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" 
                                          Data="M2 3h2v1.5h-1v1h1v1.5H2v1h3v-5H2v1zm0 7h3v-1H3v-1h2v-1H2v-1h3v5H2v-1zm1 5h1v1.5H3v1h1V20H2v1h3v-5H2v1zm4-12h14v2H7V4zm0 7h14v2H7v-2zm0 7h14v2H7v-2z"/>
                                </Viewbox>
                            </ToggleButton>
                            <ToggleButton Content="🔀" ToolTip="Randomize Items" IsChecked="{Binding RenameRandomizeItems, Mode=TwoWay}" Width="36" Height="32"/>

                            <!-- Help Info Button for Text Format -->
                            <Button Command="{Binding OpenNumberingSettingsCommand}" Width="36" Height="32" Margin="0,0,15,0" ToolTip="Configure numbering sequence">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Foreground" Value="#333"/>
                                        <Setter Property="Background" Value="#F3F3F3"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                        <TextBlock Text="i" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" FontStyle="Italic"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#EBEBEB"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- RadioButtons stacked vertically -->
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <RadioButton Content="Apply all" GroupName="RenameApplyGroup" IsChecked="{Binding RenameApplyAll, Mode=TwoWay}" FontSize="10.5" Foreground="#555" Margin="0,0,0,3"/>
                                <RadioButton Content="Apply only filtered" GroupName="RenameApplyGroup" IsChecked="{Binding RenameApplyOnlyFiltered, Mode=TwoWay}" FontSize="10.5" Foreground="#555"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Preview DataGrid -->
                    <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="1">
                        <DataGrid ItemsSource="{Binding RenamePreviewItems}" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  IsReadOnly="False"
                                  HeadersVisibility="Column"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#f0f0f0">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#333333" />
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMatchingFilter}" Value="True">
                                            <Setter Property="Background" Value="#CCE8FF"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True" />
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=IsKeyboardFocusWithin}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="White" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True" />
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=IsKeyboardFocusWithin}" Value="False" />
                                                <Condition Binding="{Binding IsMatchingFilter}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#CCE8FF" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="30">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox IsChecked="{Binding DataContext.SelectAllRenameItems, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Original" Binding="{Binding OriginalName}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="New Name" Binding="{Binding NewName}" Width="*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="#007ACC"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True"/>
                                                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=IsKeyboardFocusWithin}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- Actions Footer -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="Close Rename" Command="{Binding CloseRenamePanelCommand}" Width="100" Height="30">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#E1E1E1"/>
                                <Setter Property="BorderBrush" Value="#707070"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Style.Resources>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#F3F3F3"/>
                                        <Setter Property="Foreground" Value="#B0B0B0"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

        <!-- Busy Overlay -->
        <Grid Grid.ColumnSpan="2" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="10" Padding="25" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1" BorderBrush="#ddd">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <ProgressBar Value="{Binding ProgressPercentage}" IsIndeterminate="{Binding ProgressPercentage, Converter={x:Null}}" Width="250" Height="8"/>
                    <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0}%}" HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="11" Foreground="Gray"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>