                                                                 <TextBlock Text=".*text.*" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                             </Border>
                                                             <TextBlock Grid.Column="1" Text="Contains 'text' anywhere" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                         </Grid>
                                                     </Button>

                                                     <!-- Category: Character Classes -->
                                                     <TextBlock Text="Character Classes" FontWeight="Bold" Foreground="#333" Margin="0,15,0,5" FontSize="11"/>
                                                     <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="\d" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                                         <Grid Margin="0,0,0,5" Width="355">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="110"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                                 <TextBlock Text="\d" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                             </Border>
                                                             <TextBlock Grid.Column="1" Text="Any single digit (0-9)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                         </Grid>
                                                     </Button>
                                                     <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="\D" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                                         <Grid Margin="0,0,0,5" Width="355">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="110"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                                 <TextBlock Text="\D" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                             </Border>
                                                             <TextBlock Grid.Column="1" Text="Any non-digit character" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                         </Grid>
                                                     </Button>
                                                     <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="\w" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                                         <Grid Margin="0,0,0,5" Width="355">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="110"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                                 <TextBlock Text="\w" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                             </Border>
                                                             <TextBlock Grid.Column="1" Text="Word character (letter, digit, _)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                         </Grid>
                                                     </Button>
                                                     <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="\s" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                                         <Grid Margin="0,0,0,5" Width="355">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="110"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                                 <TextBlock Text="\s" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                             </Border>
                                                             <TextBlock Grid.Column="1" Text="Whitespace character (space, tab)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                         </Grid>
                                                     </Button>
                                                     <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="[aeiou]" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                                         <Grid Margin="0,0,0,5" Width="355">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="110"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                                 <TextBlock Text="[aeiou]" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                             </Border>
                                                             <TextBlock Grid.Column="1" Text="Any single character in set" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                         </Grid>
                                                     </Button>
                                                     <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="[^0-9]" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                                         <Grid Margin="0,0,0,5" Width="355">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="110"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                                 <TextBlock Text="[^0-9]" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                             </Border>
                                                             <TextBlock Grid.Column="1" Text="Any character NOT in set" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                         </Grid>
                                                     </Button>
                                                     <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="^[A-Za-z]+$" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                                         <Grid Margin="0,0,0,5" Width="355">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="110"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                                 <TextBlock Text="^[A-Za-z]+$" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="9.5" Foreground="#111"/>
                                                             </Border>
                                                             <TextBlock Grid.Column="1" Text="Only letters (no numbers/symbols)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                         </Grid>
                                                     </Button>
                                                     <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="^\d+$" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                                         <Grid Margin="0,0,0,5" Width="355">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="110"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                                 <TextBlock Text="^\d+$" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                             </Border>
                                                             <TextBlock Grid.Column="1" Text="Only digits (no letters/symbols)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                         </Grid>
                                                     </Button>

                                                     <!-- Category: Quantifiers & Multipliers -->
                                                     <TextBlock Text="Quantifiers &amp; Multipliers" FontWeight="Bold" Foreground="#333" Margin="0,15,0,5" FontSize="11"/>
                                                     <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="+" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                                         <Grid Margin="0,0,0,5" Width="355">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="110"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                                 <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                             </Border>
                                                             <TextBlock Grid.Column="1" Text="One or more occurrences" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                         </Grid>
                                                     </Button>
                                                     <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="?" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                                         <Grid Margin="0,0,0,5" Width="355">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="110"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                                 <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                             </Border>
                                                             <TextBlock Grid.Column="1" Text="Zero or one occurrence (optional)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                         </Grid>
                                                     </Button>
                                                     <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="*" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                                         <Grid Margin="0,0,0,5" Width="355">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="110"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                                 <TextBlock Text="*" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                             </Border>
                                                             <TextBlock Grid.Column="1" Text="Zero or more occurrences" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                         </Grid>
                                                     </Button>
                                                     <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="\d{3}" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                                         <Grid Margin="0,0,0,5" Width="355">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="110"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                                 <TextBlock Text="\d{3}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                             </Border>
                                                             <TextBlock Grid.Column="1" Text="Exactly 3 digits" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                         </Grid>
                                                     </Button>

                                                     <!-- Category: Or & Grouping -->
                                                     <TextBlock Text="Or &amp; Grouping" FontWeight="Bold" Foreground="#333" Margin="0,15,0,5" FontSize="11"/>
                                                     <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="gato|perro" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                                         <Grid Margin="0,0,0,5" Width="355">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="110"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                                 <TextBlock Text="gato|perro" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                             </Border>
                                                             <TextBlock Grid.Column="1" Text="Matches 'gato' OR 'perro'" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                                         </Grid>
                                                     </Button>
                                                 </StackPanel>
                                             </ScrollViewer>
                                         </Border>
                                     </Popup>
                                 </StackPanel>
                            </Grid>
                        </Border>

                        <!-- On Duplicates Card -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="15,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="On Duplicates:" FontWeight="Bold" FontSize="12" Foreground="#999" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton Content="Keep Original" GroupName="OnDuplicatesGroup" IsChecked="{Binding KeepOriginal}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    <RadioButton Content="Abort Transaction" GroupName="OnDuplicatesGroup" IsChecked="{Binding AbortTransaction}" Margin="0,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" Content="Append Suffix:" GroupName="OnDuplicatesGroup" IsChecked="{Binding AppendSuffix}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Height="22" VerticalContentAlignment="Center" Padding="2" Text="{Binding DuplicatesSuffixText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding AppendSuffix}" VerticalAlignment="Center" BorderBrush="#e0e0e0" BorderThickness="1"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- On Views & Geometry Card -->
                        <Border Style="{StaticResource StandardCardStyle}">
                            <StackPanel>
                                <TextBlock Text="On Views:" FontWeight="Bold" FontSize="12" Foreground="#999" Margin="0,0,0,8"/>
                                
                                <CheckBox Content="Accept on all Dialogs" IsChecked="{Binding AcceptAllWarnings}" Style="{StaticResource SwitchStyle}" Margin="0,4"/>
                                
                                <CheckBox Content="Transfer Sheet with Views" IsChecked="{Binding IncludeSheetsWithViews}" Style="{StaticResource SwitchStyle}" Margin="0,4"/>
                                <StackPanel Margin="20,2,0,6">
                                    <CheckBox Content="Use Legend if Exists in Target" IsChecked="{Binding UseLegendIfExists}" Style="{StaticResource SwitchStyle}" Margin="0,3"/>
                                    <CheckBox Content="Use Schedule if Exists in Target" IsChecked="{Binding UseScheduleIfExists}" Style="{StaticResource SwitchStyle}" Margin="0,3"/>
                                    <CheckBox Content="Use Assembly Views if Exist in Target" IsChecked="{Binding UseAssemblyViewsIfExists}" Style="{StaticResource SwitchStyle}" Margin="0,3"/>
                                </StackPanel>
                                
                                <CheckBox Content="Transfer Callouts of Views" IsChecked="{Binding IncludeCallouts}" Style="{StaticResource SwitchStyle}" Margin="0,4"/>
                                <CheckBox Content="Transfer Sections &amp; Details of Views" IsChecked="{Binding IncludeSections}" Style="{StaticResource SwitchStyle}" Margin="0,4"/>
                                <CheckBox Content="Transfer View Elements" IsChecked="{Binding IncludeViewElements}" Style="{StaticResource SwitchStyle}" Margin="0,4"/>
                                <CheckBox Content="Force Level in Level Base Views" IsChecked="{Binding ForceLevelInLevelBaseViews}" Style="{StaticResource SwitchStyle}" Margin="0,4"/>
                                
                                <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Margin="0,10,0,10"/>
                                
                                <TextBlock Text="Transform By:" FontWeight="Bold" FontSize="12" Foreground="#999" Margin="0,0,0,8"
                                           ToolTipService.InitialShowDelay="400"
                                           ToolTip="Transfer Coordinate System&#x0a;&#x0a;Defines the coordinate system and transformation matrix applied when transferring 3D model elements, view crop boxes, sections, elevations, and callouts.&#x0a;&#x0a;(Does not affect project standards, family definitions in browser, or schedules)."/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <RadioButton Content="None" GroupName="TransformByGroup" IsChecked="{Binding TransformNone}" Margin="0,0,15,0"
                                                 ToolTipService.InitialShowDelay="400"
                                                 ToolTip="Internal Origin (0, 0, 0)&#x0a;&#x0a;• Applies to: 3D Elements, View Crop Boxes, Sections, Elevations, and Callouts.&#x0a;• Behavior: Strictly aligns the source Internal Origin (0,0,0) with the active model's Internal Origin, ignoring any visual link movement or rotation.&#x0a;• Recommended: When both models share the exact same Origin-to-Origin insertion point."/>
                                    <RadioButton Content="Link" GroupName="TransformByGroup" IsChecked="{Binding TransformLink}" Margin="0,0,15,0"
                                                 ToolTipService.InitialShowDelay="400"
                                                 ToolTip="Link Instance Transform (Default / WYSIWYG)&#x0a;&#x0a;• Applies to: 3D Elements, View Crop Boxes, Sections, Elevations, and Callouts.&#x0a;• Behavior: Honors the current position and rotation of the link instance on screen. Transferred elements will land exactly where you visually see them in the model view.&#x0a;• Recommended: Standard choice for transfers from loaded Revit links."/>
                                    <RadioButton Content="Shared" GroupName="TransformByGroup" IsChecked="{Binding TransformShared}"
                                                 ToolTipService.InitialShowDelay="400"
                                                 ToolTip="Shared Coordinates (Survey Point)&#x0a;&#x0a;• Applies to: 3D Elements, View Crop Boxes, Sections, Elevations, and Callouts.&#x0a;• Behavior: Calculates position and rotation using the published Shared Coordinate system and Survey Point offset between both project files.&#x0a;• Recommended: For master plans, infrastructure, or projects where buildings use localized axes linked via shared geographical coordinates."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- Family Details Card -->
                        <Border Style="{StaticResource FamiliesManagerCardStyle}" Height="315">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Card Header Row: Title on Left, Category & Version Metadata on Right (when 1 family selected) -->
                                <Grid Grid.Row="0" Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                     <TextBlock Grid.Column="0" Text="{Binding FamilyDetailsCardTitle}" FontWeight="Bold" FontSize="12" Foreground="#999" VerticalAlignment="Top"/>
                                 </Grid>

                                <!-- Placeholder text when NO family is selected in tree -->
                                <TextBlock Grid.Row="1" Text="Select or click a family in the tree to view details" 
                                           Foreground="#999" FontStyle="Italic" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFamilyDetails}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Details Content: Visible when a family is selected or checked -->
                                <Grid Grid.Row="1">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFamilyDetails}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                     <Grid Grid.Row="0" VerticalAlignment="Top">
                                         <!-- Single Family Selected -->
                                         <Grid>
                                             <Grid.Style>
                                                 <Style TargetType="Grid">
                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding IsSingleFamilyDetails}" Value="True">
                                                             <Setter Property="Visibility" Value="Visible"/>
                                                         </DataTrigger>
                                                         <MultiDataTrigger>
                                                             <MultiDataTrigger.Conditions>
                                                                 <Condition Binding="{Binding IsSingleFamilyDetails}" Value="True"/>
                                                                 <Condition Binding="{Binding SelectedFamily}" Value="{x:Null}" />
                                                             </MultiDataTrigger.Conditions>
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                         </MultiDataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </Grid.Style>
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="Auto"/> <!-- Left: Thumbnail + Host -->
                                                 <ColumnDefinition Width="*"/>    <!-- Right: Family Name + Type + Category -->
                                             </Grid.ColumnDefinitions>
                                             
                                             <!-- Left Column: High-Res 128x128 Thumbnail Container -->
                                             <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,14,0">
                                                 <Border Width="128" Height="128" Background="#FAFAFA" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="4" VerticalAlignment="Top">
                                                     <Grid>
                                                         <Image Source="{Binding SelectedFamilyThumbnail}" Stretch="Uniform" Margin="2"/>
                                                         <ProgressBar IsIndeterminate="True" Width="24" Height="24" 
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Visibility="{Binding SelectedFamily.IsLoadingThumbnail, Converter={StaticResource BoolToVis}}"/>
                                                     </Grid>
                                                 </Border>
                                             </StackPanel>
                                             
                                                                      <!-- Right Column: Family Name, Type, Category, Revit Version, Host, File size, Last modified (Title stacked above property value with 50% reduced uniform spacing) -->
                                             <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,0,0,0">
                                                 <!-- Family Name -->
                                                 <TextBlock Text="{Binding SelectedFamily.Name}" 
                                                            FontWeight="Bold" FontSize="12" Foreground="#111111"
                                                            TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                            ToolTip="{Binding SelectedFamily.Name}" Margin="0,0,0,0"/>

                                                 <!-- Type Name (Visible when a type node is selected in tree) -->
                                                 <StackPanel Margin="0,-1,0,0">
                                                     <StackPanel.Style>
                                                         <Style TargetType="StackPanel">
                                                             <Setter Property="Visibility" Value="Visible"/>
                                                             <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding SelectedSymbol}" Value="{x:Null}">
                                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                                 </DataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </StackPanel.Style>
                                                     <TextBlock Text="Type" FontWeight="Bold" FontSize="10" Foreground="#111111" Margin="0,0,0,-2"/>
                                                     <TextBlock Text="{Binding SelectedSymbol.Name}" FontSize="10" Foreground="#333333" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedSymbol.Name}" Margin="0,0,0,-1"/>
                                                 </StackPanel>

                                                 <!-- Category -->
                                                 <StackPanel Margin="0,-1,0,0">
                                                     <TextBlock Text="Category" FontWeight="Bold" FontSize="10" Foreground="#111111" Margin="0,0,0,-2"/>
                                                     <TextBlock Text="{Binding SelectedFamily.CategoryName}" FontSize="10" Foreground="#333333" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedFamily.CategoryName}" Margin="0,0,0,-1"/>
                                                 </StackPanel>

                                                 <!-- Revit Version -->
                                                 <StackPanel Margin="0,-1,0,0">
                                                     <TextBlock Text="Revit" FontWeight="Bold" FontSize="10" Foreground="#111111" Margin="0,0,0,-2"/>
                                                     <TextBlock Text="{Binding SelectedFamily.RevitVersion}" FontSize="10" Foreground="#333333" Margin="0,0,0,-1"/>
                                                 </StackPanel>

                                                 <!-- Host Type -->
                                                 <StackPanel Margin="0,-1,0,0">
                                                     <TextBlock Text="Host" FontWeight="Bold" FontSize="10" Foreground="#111111" Margin="0,0,0,-2"/>
                                                     <TextBlock Text="{Binding SelectedFamily.HostTypeDescription}" FontSize="10" Foreground="#333333" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedFamily.HostTypeDescription}" Margin="0,0,0,-1"/>
                                                 </StackPanel>

                                                 <!-- File size -->
                                                 <StackPanel Margin="0,-1,0,0">
                                                     <TextBlock Text="File size" FontWeight="Bold" FontSize="10" Foreground="#111111" Margin="0,0,0,-2"/>
                                                     <TextBlock Text="{Binding SelectedFamily.FileSizeFormatted}" FontSize="10" Foreground="#333333" Margin="0,0,0,-1"/>
                                                 </StackPanel>

                                                 <!-- Last modified -->
                                                 <StackPanel Margin="0,-1,0,0">
                                                     <TextBlock Text="Last modified" FontWeight="Bold" FontSize="10" Foreground="#111111" Margin="0,0,0,-2"/>
                                                     <TextBlock Text="{Binding SelectedFamily.LastModifiedFormatted}" FontSize="10" Foreground="#333333" Margin="0,0,0,0"/>
                                                 </StackPanel>
                                             </StackPanel>
                                         </Grid>

                                        <!-- Multiple Families Selected -->
                                        <TextBlock Text="Multiple families selected" Foreground="#999" FontStyle="Italic" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSingleFamilyDetails}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    
                                    <!-- Separator Line -->
                                    <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Margin="0,2,0,3"/>
                                    
                                     <!-- Action Buttons Row (Left-aligned: Delete, Download, and 3 Stacked Download Option RadioButtons) -->
