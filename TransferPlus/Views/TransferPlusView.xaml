<Window x:Class="TransferPlus.Views.TransferPlusView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:TransferPlus.ViewModels"
        mc:Ignorable="d"
        Title="TransferPlus" Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance viewModels:TransferPlusViewModel}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TransferPlus;component/Resources/Styles/TransferPlusStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <HierarchicalDataTemplate DataType="{x:Type viewModels:TreeItemViewModel}" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Margin="2,0">
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Category}" Foreground="Gray" Margin="10,0,0,0" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#fafafa">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: TreeView with Left-sided scrollbar via RTL -->
        <Border Grid.Column="0" Margin="10">
            <ScrollViewer FlowDirection="RightToLeft" VerticalScrollBarVisibility="Auto">
                <TreeView FlowDirection="LeftToRight" ItemsSource="{Binding RootNodes}" BorderThickness="0" Background="Transparent" VirtualizingStackPanel.IsVirtualizing="True">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="Margin" Value="0,2"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </ScrollViewer>
        </Border>

        <!-- Middle Column: Separator -->
        <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Center" Background="#e0e0e0" Margin="0,10"/>

        <!-- Right Column: Controls -->
        <Border Grid.Column="2" Margin="10">
            <StackPanel>
                <!-- Filter Card -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Search Elements" Style="{StaticResource FilterPlusTextBlockStyle}"/>
                        <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,10"/>
                    </StackPanel>
                </Border>

                <!-- Source Document Card -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Source Document" Style="{StaticResource FilterPlusTextBlockStyle}"/>
                        <ComboBox ItemsSource="{Binding OpenDocuments}" SelectedItem="{Binding SelectedSourceDocument}" DisplayMemberPath="Title" Margin="0,0,0,10"/>
                    </StackPanel>
                </Border>

                <!-- Options Card -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Options" Style="{StaticResource FilterPlusTextBlockStyle}"/>
                        <CheckBox Content="Overwrite Duplicate Types" IsChecked="{Binding OverrideDuplicates}" Style="{StaticResource SwitchStyle}" Margin="0,5"/>
                    </StackPanel>
                </Border>
                
                <Button Content="Transfer Selected" Command="{Binding TransferCommand}" Margin="0,15,0,0" Padding="10" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Busy Overlay -->
        <Grid Grid.ColumnSpan="3" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="10" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>