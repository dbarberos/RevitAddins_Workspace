                                         <Button Command="{Binding DownloadSelectedFamiliesCommand}" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Download Family">
                                             <Button.Template>
                                                 <ControlTemplate TargetType="Button">
                                                     <Border x:Name="border" Background="Transparent" CornerRadius="4" Padding="4">
                                                         <Viewbox Width="18" Height="18">
                                                             <Path Data="M12,16L7,11H10V4H14V11H17L12,16M5,18H19V20H5V18Z" Fill="#777" x:Name="iconPath"/>
                                                         </Viewbox>
                                                     </Border>
                                                     <ControlTemplate.Triggers>
                                                         <Trigger Property="IsMouseOver" Value="True">
                                                             <Setter TargetName="border" Property="Background" Value="#eeeeee"/>
                                                             <Setter TargetName="iconPath" Property="Fill" Value="#333"/>
                                                         </Trigger>
                                                         <Trigger Property="IsPressed" Value="True">
                                                             <Setter TargetName="border" Property="Background" Value="#dddddd"/>
                                                         </Trigger>
