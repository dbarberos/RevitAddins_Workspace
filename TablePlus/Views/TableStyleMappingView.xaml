<Window x:Class="TablePlus.Views.TableStyleMappingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:TablePlus.ViewModels"
        xmlns:local="clr-namespace:TablePlus.Views"
        mc:Ignorable="d"
        x:Name="StyleMappingWindow"
        Title="TablePlus — Table Graphic &amp; Header Design"
        Width="580" Height="740"
        MinWidth="520" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        Foreground="#0F172A"
        FontFamily="Segoe UI, Inter, Arial"
        FontSize="13"
        Icon="pack://application:,,,/TablePlus;component/Resources/Icons/TablePlus32x32.png">

    <Window.Resources>
        <!-- COLOR PALETTE BRUSHES -->
        <SolidColorBrush x:Key="WindowBgBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CardBorderHoverBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0284C7"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0369A1"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#075985"/>
        <SolidColorBrush x:Key="PrimaryDisabledBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>

        <!-- CONVERTERS -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:HexStringToBrushConverter x:Key="HexToBrush"/>

        <!-- Card Container Border Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.04" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Ghost Button Style -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource CardBorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Toggle Switch Style -->
        <Style x:Key="SwitchStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="BackgroundBorder" Width="36" Height="20" Background="#CBD5E1" CornerRadius="10" Padding="2" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="16" Height="16" Fill="White" HorizontalAlignment="Left">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="16" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Text Box Style -->
        <Style x:Key="CleanTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource CardBorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean ComboBox Style -->
        <Style x:Key="CleanComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>

        <!-- Color Swatch Button Style -->
        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="bdr" Property="BorderThickness" Value="2.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER ZONE -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Table Graphic &amp; Header Design" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                    <Run Text="Configuring view: "/>
                    <Run Text="{Binding ViewName}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                </TextBlock>
            </StackPanel>

            <Border Grid.Column="1" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                <TextBlock Text="🎨 Custom Styles" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
            </Border>
        </Grid>

        <!-- SCROLLABLE BODY ZONE -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12" Padding="0,0,4,0">
            <StackPanel>

                <!-- CARD 1: GRID LINES STYLE -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="📏" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Table Gridlines" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Select the Revit Line Style used to draw exterior borders and interior cell dividers." 
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <ComboBox Style="{StaticResource CleanComboBoxStyle}"
                                  ItemsSource="{Binding AvailableLineStyles}"
                                  SelectedItem="{Binding SelectedGridLineStyle}"
                                  Height="34"/>
                    </StackPanel>
                </Border>

                <!-- CARD 2: BODY CELL TYPOGRAPHY -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🔤" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Body Cell Typography" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Revit TextNoteType assigned to standard data cells across the table body." 
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <ComboBox Style="{StaticResource CleanComboBoxStyle}"
                                  ItemsSource="{Binding AvailableTextStyles}"
                                  SelectedItem="{Binding SelectedBodyTextStyle}"
                                  Height="34"/>
                    </StackPanel>
                </Border>

                <!-- CARD 3: HEADER ROW STYLING OVERRIDES -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👑" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Header Row Overrides" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Apply distinct typography and background shading to the topmost row." 
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>

                            <CheckBox Grid.Column="1" 
                                      Style="{StaticResource SwitchStyle}"
                                      IsChecked="{Binding HeaderCustomStyleEnabled}"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- EXPANDABLE CONTENT WHEN ENABLED -->
                        <StackPanel IsEnabled="{Binding HeaderCustomStyleEnabled}" Opacity="{Binding HeaderCustomStyleEnabled, Converter={StaticResource BoolToVis}, FallbackValue=1.0}">

                            <!-- HEADER TEXT NOTE TYPE -->
                            <TextBlock Text="Header Text Style (TextNoteType)" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource CleanComboBoxStyle}"
                                      ItemsSource="{Binding AvailableTextStyles}"
                                      SelectedItem="{Binding SelectedHeaderTextStyle}"
                                      Height="34" Margin="0,0,0,12"/>

                            <!-- HEADER BACKGROUND FILL COLOR -->
                            <TextBlock Text="Header Background Shading (Hex Color)" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="32" CornerRadius="6,0,0,6" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,1,0,1"
                                        Background="{Binding HeaderFillColorHex, Converter={StaticResource HexToBrush}}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource CleanTextBoxStyle}" Height="32" 
                                         Text="{Binding HeaderFillColorHex, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- PRESET FILL COLORS -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="Presets:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ItemsControl ItemsSource="{Binding PresetColors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ColorSwatchButtonStyle}"
                                                    Background="{Binding Converter={StaticResource HexToBrush}}"
                                                    Command="{Binding DataContext.SelectPresetFillColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- HEADER TEXT COLOR -->
                            <TextBlock Text="Header Text Color (Hex Color)" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="32" CornerRadius="6,0,0,6" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,1,0,1"
                                        Background="{Binding HeaderTextColorHex, Converter={StaticResource HexToBrush}}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource CleanTextBoxStyle}" Height="32" 
                                         Text="{Binding HeaderTextColorHex, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- PRESET TEXT COLORS -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="Presets:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ItemsControl ItemsSource="{Binding PresetColors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ColorSwatchButtonStyle}"
                                                    Background="{Binding Converter={StaticResource HexToBrush}}"
                                                    Command="{Binding DataContext.SelectPresetTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- LIVE MINI PREVIEW -->
                            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10"
                                    Background="{Binding HeaderFillColorHex, Converter={StaticResource HexToBrush}}">
                                <TextBlock Text="SAMPLE HEADER TITLE — 123.45 m²" 
                                           FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"
                                           Foreground="{Binding HeaderTextColorHex, Converter={StaticResource HexToBrush}}"/>
                            </Border>

                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER ZONE -->
        <Border Grid.Row="2" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Content="Cancel" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}"
                        CommandParameter="{Binding ElementName=StyleMappingWindow}"/>

                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="Apply &amp; Save"
                        Command="{Binding SaveCommand}"
                        CommandParameter="{Binding ElementName=StyleMappingWindow}"/>
            </Grid>
        </Border>

    </Grid>
</Window>
