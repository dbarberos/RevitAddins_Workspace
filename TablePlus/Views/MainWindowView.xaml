            <!-- CARD 2: ORGANIZE (ORIGIN & ARRANGE) -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Width="350" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Headers (Organize: & ARRANGE) -->
                        <RowDefinition Height="*"/>    <!-- Row 1: Columns Content -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Col 0: Origin -->
                        <ColumnDefinition Width="1"/>    <!-- Col 1: Separator -->
                        <ColumnDefinition Width="*"/>    <!-- Col 2: Arrange -->
                    </Grid.ColumnDefinitions>

                    <!-- Row 0, Col 0: Title "Organize:" -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Organize:" FontWeight="Bold" FontSize="12" Foreground="#999" Margin="0,0,12,6" VerticalAlignment="Center"/>

                    <!-- Row 0, Col 2: Subtitle "ARRANGE" (Aligned with Organize: title) -->
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="ARRANGE" FontSize="9" FontWeight="SemiBold" Foreground="#999" Margin="12,0,0,6" VerticalAlignment="Center"/>

                    <!-- Col 1: Vertical Separator (spanning rows 0 & 1) -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Background="#E0E0E0" Margin="0,2,0,2"/>

                    <!-- Row 1, Col 0: Origin Options -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="ORIGIN" FontSize="9" FontWeight="SemiBold" Foreground="#999" Margin="0,0,0,5"/>

                        <CheckBox Content="Drafting Views (Table)" IsChecked="{Binding OriginDraftingViews}" FontSize="11" Margin="0,0,0,5">
                            <CheckBox.ToolTip>
                                <ToolTip MaxWidth="250">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Drafting Views (Table)</Bold><LineBreak/>
                                        Collects 2D vector tables generated in standard Drafting Views.
                                    </TextBlock>
                                </ToolTip>
                            </CheckBox.ToolTip>
                        </CheckBox>

                        <CheckBox Content="Legends" IsChecked="{Binding OriginLegends}" FontSize="11" Margin="0,0,0,5">
                            <CheckBox.ToolTip>
                                <ToolTip MaxWidth="250">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Legends (Legend Views)</Bold><LineBreak/>
                                        Collects vector tables created in Legend Views, allowing placement across multiple sheets simultaneously.
                                    </TextBlock>
                                </ToolTip>
                            </CheckBox.ToolTip>
                        </CheckBox>

                        <CheckBox Content="Schedules" IsChecked="{Binding OriginSchedules}" FontSize="11" Margin="0,0,0,0">
                            <CheckBox.ToolTip>
                                <ToolTip MaxWidth="250">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Schedules (Schedule Views)</Bold><LineBreak/>
                                        Collects tabular data and calculation sheets imported into or managed as Schedule views.
                                    </TextBlock>
                                </ToolTip>
                            </CheckBox.ToolTip>
                        </CheckBox>
                    </StackPanel>

                    <!-- Row 1, Col 2: Arrange Switches -->
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="12,0,0,0">
                        <CheckBox Content="Sort by Category" IsChecked="{Binding SortByCategory}" Style="{StaticResource SwitchStyle}" FontSize="11" Margin="0,0,0,5">
                            <CheckBox.ToolTip>
                                <ToolTip MaxWidth="250">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Sort by Category</Bold><LineBreak/>
                                        Groups table views by their target Revit category and view classification.
                                    </TextBlock>
                                </ToolTip>
                            </CheckBox.ToolTip>
                        </CheckBox>

                        <CheckBox Content="Sort by Name" IsChecked="{Binding SortByName}" Style="{StaticResource SwitchStyle}" FontSize="11" Margin="0,0,0,5">
                            <CheckBox.ToolTip>
                                <ToolTip MaxWidth="250">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Sort by Name</Bold><LineBreak/>
                                        Displays all collected tables in a flat alphabetical order sorted from A to Z.
                                    </TextBlock>
                                </ToolTip>
                            </CheckBox.ToolTip>
                        </CheckBox>

                        <CheckBox Content="Sort by Sheet" IsChecked="{Binding SortBySheet}" Style="{StaticResource SwitchStyle}" FontSize="11" Margin="0,0,0,5">
                            <CheckBox.ToolTip>
                                <ToolTip MaxWidth="250">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Sort by Sheet</Bold><LineBreak/>
                                        Organizes tables according to the sheet (Number - Name) where each table view is placed.
                                    </TextBlock>
                                </ToolTip>
                            </CheckBox.ToolTip>
                        </CheckBox>

                        <CheckBox Content="Sort by View" IsChecked="{Binding SortByView}" Style="{StaticResource SwitchStyle}" FontSize="11" Margin="0,0,0,0">
                            <CheckBox.ToolTip>
                                <ToolTip MaxWidth="250">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Sort by View</Bold><LineBreak/>
                                        Organizes tables directly under their parent host view hierarchy.
                                    </TextBlock>
                                </ToolTip>
                            </CheckBox.ToolTip>
                        </CheckBox>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 1: LOWER DATA ZONE (VIRTUALIZED DATAGRID WITH 11 COLUMNS) -->
        <Border Grid.Row="1" x:Name="DataGridContainer" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="0" Padding="0" Margin="0,0,0,12"
                AllowDrop="True"
                DragEnter="TablesDataGrid_DragEnter"
                DragOver="TablesDataGrid_DragOver"
                DragLeave="TablesDataGrid_DragLeave"
                Drop="TablesDataGrid_Drop">
            <Grid>
                <DataGrid x:Name="TablesDataGrid"
                          AllowDrop="True"
                          DragEnter="TablesDataGrid_DragEnter"
                          DragOver="TablesDataGrid_DragOver"
                          DragLeave="TablesDataGrid_DragLeave"
                          Drop="TablesDataGrid_Drop"
                          ItemsSource="{Binding FilteredTables}"
                      SelectedItem="{Binding SelectedTable}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserResizeColumns="True"
                      FrozenColumnCount="2"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F0F0"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      Background="White"
                      RowStyle="{StaticResource TableRowStyle}"
                      ColumnHeaderStyle="{StaticResource TableHeaderStyle}"
                      ScrollViewer.CanContentScroll="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      EnableRowVirtualization="True">

                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <Expander IsExpanded="True" BorderThickness="0">
                                                <Expander.Template>
                                                    <ControlTemplate TargetType="{x:Type Expander}">
                                                        <DockPanel>
                                                            <Border DockPanel.Dock="Top" 
                                                                    Background="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type GroupItem}}, Converter={StaticResource GroupItemToBg}}" 
                                                                    BorderBrush="#E2E8F0" 
                                                                    BorderThickness="0,0,0,1" 
                                                                    MinHeight="26" 
                                                                    Padding="0,2">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="42"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Group CheckBox at Column 0 (Width 42) -->
                                                                    <CheckBox Grid.Column="0" 
                                                                              Click="GroupCheckBox_Click"
                                                                              Loaded="GroupCheckBox_Loaded"
                                                                              IsThreeState="True"
                                                                              HorizontalAlignment="Center" 
                                                                              VerticalAlignment="Center"/>

                                                                    <!-- Group Expander Toggle at Column 1 start -->
                                                                    <ToggleButton Grid.Column="1" 
                                                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                                  ClickMode="Press"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type GroupItem}}, Converter={StaticResource GroupItemToIndentMargin}}">
                                                                        <ToggleButton.Template>
                                                                            <ControlTemplate TargetType="ToggleButton">
                                                                                <Border Width="18" Height="20" Background="Transparent" Cursor="Hand">
                                                                                    <TextBlock x:Name="ExpanderText" Text="▶" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10" Foreground="#555555"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsChecked" Value="True">
                                                                                        <Setter TargetName="ExpanderText" Property="Text" Value="▼"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </ToggleButton.Template>
                                                                    </ToggleButton>

                                                                    <!-- Group Name & Item Count -->
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#333333" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                        <TextBlock Text="{Binding ItemCount, StringFormat='({0})'}" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <ContentPresenter x:Name="ExpandSite" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" DockPanel.Dock="Bottom" Focusable="False" Visibility="Visible"/>
                                                        </DockPanel>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsExpanded" Value="False">
                                                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Expander.Template>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>

                <DataGrid.Columns>

                    <!-- COL 1: SELECTION CHECKBOX (FROZEN 1, FIXED 42px, NO RIGHT DIVIDER, EXPAND/COLLAPSE IN HEADER) -->
                    <DataGridTemplateColumn Width="42" MinWidth="42" MaxWidth="42" CanUserResize="False" HeaderStyle="{StaticResource CheckboxColumnHeaderStyle}">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Command="{Binding DataContext.CollapseAllCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        Style="{StaticResource HeaderIconButtonStyle}" ToolTip="Collapse All" Width="18" Height="18" Margin="1,0">
                                    <Path Data="M4,1 L8,7 L0,7 Z" Fill="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button Command="{Binding DataContext.ExpandAllCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        Style="{StaticResource HeaderIconButtonStyle}" ToolTip="Expand All" Width="18" Height="18" Margin="1,0">
                                    <Path Data="M0,1 L8,1 L4,7 Z" Fill="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>                    <!-- COL 2: REVIT VIEW NAME (FROZEN 2, EDITABLE TEXTBOX - OPTION B) -->
                    <DataGridTemplateColumn Header="View Name" Width="190" MinWidth="140" CanUserResize="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="0">
                                    <TextBox Text="{Binding ViewName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                             Style="{StaticResource DataGridTextBoxStyle}" 
                                             LostFocus="ViewNameTextBox_LostFocus" 
                                             KeyDown="ViewNameTextBox_KeyDown"
                                             FontWeight="SemiBold"
                                             Margin="8,2,6,2"
                                             ToolTip="Click to edit table view name in Revit. Press Enter or tab away to commit."/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 3: SOURCE TYPE BADGE -->
                    <DataGridTemplateColumn Header="Src" Width="55" MinWidth="45" CanUserResize="True" HeaderStyle="{StaticResource CenteredTableHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#F1F5F9" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SourceBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 4: STATUS BADGE -->
                    <DataGridTemplateColumn Header="Status" Width="115" MinWidth="85" CanUserResize="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusToBg}}"
                                        BorderThickness="1" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        ToolTip="{Binding StatusTooltip}">
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="#E2E8F0"/>
                                    </Border.BorderBrush>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusToText}}" 
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 5: SOURCE FILE -->
                    <DataGridTemplateColumn Header="Source File" Width="220" MinWidth="110" CanUserResize="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SourceFileName}" VerticalAlignment="Center" Margin="6,0" 
                                           FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceFilePath}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 6: WORKSHEET DROPDOWN -->
                    <DataGridTemplateColumn Header="Worksheet / Page" Width="150" MinWidth="120" CanUserResize="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding AvailableSheets}" 
                                          SelectedItem="{Binding SelectedSheetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectionChanged="WorksheetComboBox_SelectionChanged"
                                          BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                          FontSize="12" Margin="4,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 7: REGION / RANGE DROPDOWN -->
                    <DataGridTemplateColumn Header="Region / Range" Width="140" MinWidth="110" CanUserResize="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding AvailableRegionModes}" 
                                          SelectedItem="{Binding SelectedRegionMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                          FontSize="12" Margin="4,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 8: VIEW TYPE DROPDOWN -->
                    <DataGridTemplateColumn Header="View Type" Width="115" MinWidth="90" CanUserResize="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding AvailableViewTypes}" 
                                          SelectedItem="{Binding ViewType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                          FontSize="12" Margin="4,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}, ConverterParameter=Compact}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 9: VIEW SCALE DROPDOWN -->
                    <DataGridTemplateColumn Header="Scale" Width="75" MinWidth="60" CanUserResize="True" HeaderStyle="{StaticResource CenteredTableHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ComboBox ItemsSource="{Binding AvailableScales}" 
                                              SelectedItem="{Binding ViewScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding IsScaleApplicable, Converter={StaticResource BoolToVis}}"
                                              BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                              FontSize="12" Margin="4,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat='1:{0}'}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="N/A" 
                                               Foreground="#888888" 
                                               FontSize="12" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsScaleApplicable, Converter={StaticResource InvBoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 10: IMPORT TYPE DROPDOWN -->
                    <DataGridTemplateColumn Header="Type" Width="85" MinWidth="70" CanUserResize="True" HeaderStyle="{StaticResource CenteredTableHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding AvailableImportTypes}" 
                                          SelectedItem="{Binding ImportType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                          FontSize="12" Margin="4,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}, ConverterParameter=Compact}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 11: AUTO-SYNC CHECKBOX -->
                    <DataGridTemplateColumn Header="Auto-Sync" Width="80" MinWidth="70" CanUserResize="True" HeaderStyle="{StaticResource CenteredTableHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsAutoSyncEnabled, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
                                          ToolTip="Check to automatically sync on project open"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 12: BLACK & WHITE CHECKBOX -->
                    <DataGridTemplateColumn Header="B&amp;W" Width="55" MinWidth="45" CanUserResize="True" HeaderStyle="{StaticResource CenteredTableHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsBlackAndWhite, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
                                          ToolTip="Force solid black text/lines and suppress cell fills"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 13: DESIGN BUTTON -->
                    <DataGridTemplateColumn Header="Design" Width="95" MinWidth="80" CanUserResize="True" HeaderStyle="{StaticResource CenteredTableHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButtonStyle}" Padding="6,3" Margin="4,0"
                                        Content="🎨 Design..." HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Command="{Binding DataContext.OpenDesignWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Configure line styles, body typography, and header overrides"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <!-- Drag & Drop Visual Overlay (Lighter translucent gray background with white inner card) -->
            <Border x:Name="DropOverlay" Background="#60E0E0E0" BorderThickness="0" 
                    Margin="0,29,10,10"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <Border Background="#FFFFFF" CornerRadius="8" BorderThickness="0" 
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                    </Border.Effect>
                    <TextBlock Text="Drop your file here to create or link a table" 
                               FontWeight="Bold" FontSize="12" Foreground="#999" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Border>
        </Grid>
    </Border>

        <!-- ROW 2: FOOTER ZONE (WITHOUT DIVIDING SEPARATOR LINE) -->
        <Border Grid.Row="2" BorderThickness="0" Padding="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Bottom Left: Configuration Cog, Tables Selected Card, and Health Indicators (Clean Minimalist HUD, Flush to Bottom) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <Button Command="{Binding OpenConfigurationCommand}" Margin="0,0,10,0" VerticalAlignment="Bottom" Cursor="Hand" ToolTip="Configuration &amp; Sources">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="12" Padding="4">
                                    <Viewbox Width="18" Height="18">
                                        <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.97 19.05,5.05L16.56,6.05C16.04,5.66 15.47,5.34 14.86,5.12L14.47,2.5C14.43,2.25 14.22,2.07 13.97,2.07H9.97C9.72,2.07 9.5,2.25 9.47,2.5L9.09,5.12C8.47,5.34 7.9,5.66 7.38,6.05L4.89,5.05C4.67,4.97 4.4,5.05 4.27,5.27L2.27,8.73C2.15,8.95 2.2,9.22 2.39,9.37L4.5,11C4.47,11.34 4.45,11.67 4.45,12C4.45,12.33 4.47,12.65 4.5,12.97L2.39,14.63C2.2,14.78 2.15,15.05 2.27,15.27L4.27,18.73C4.4,18.95 4.67,19.03 4.89,18.95L7.38,17.95C7.9,18.34 8.47,18.66 9.09,18.88L9.47,21.5C9.5,21.75 9.72,21.93 9.97,21.93H13.97C14.22,21.93 14.43,21.75 14.47,21.5L14.86,18.88C15.47,18.66 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" Fill="#777" x:Name="iconPath"/>
                                    </Viewbox>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#eeeeee"/>
                                        <Setter TargetName="iconPath" Property="Fill" Value="#333"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#dddddd"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border Background="#ffffff" CornerRadius="8" Padding="15,6" BorderBrush="#e0e0e0" BorderThickness="1" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding SelectedCount}" FontSize="24" FontWeight="Medium" VerticalAlignment="Bottom" Foreground="#333" Margin="0,0,0,0"/>
                            <TextBlock Text=" / " FontSize="16" FontWeight="Normal" VerticalAlignment="Bottom" Foreground="#888" Margin="4,0,4,2"/>
                            <TextBlock Text="{Binding TotalCount}" FontSize="16" FontWeight="Normal" VerticalAlignment="Bottom" Foreground="#666" Margin="0,0,10,2"/>
                            <TextBlock Text="tables selected" VerticalAlignment="Bottom" Foreground="#666" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,3"/>
                        </StackPanel>
                    </Border>

                    <!-- System Health & Status Indicators (Clean Minimalist HUD, No Card Border, Flush to Bottom) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="14,0,0,0">
                        <!-- Round Rescan Button (Matching Cog Style & Colors) -->
                        <Button Command="{Binding RefreshInventoryCommand}" Margin="0,0,8,0" VerticalAlignment="Bottom" Cursor="Hand">
                            <Button.ToolTip>
                                <ToolTip MaxWidth="280">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Rescan Model (F5)</Bold><LineBreak/>
                                        Scans the Revit document to discover new table views and re-checks Excel timestamps on disk.
                                    </TextBlock>
                                </ToolTip>
                            </Button.ToolTip>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="12" Padding="4">
                                        <Viewbox Width="18" Height="18">
                                            <Path Data="M12,4V1L8,5L12,9V6A6,6 0 0,1 18,12C18,13.22 17.64,14.36 17,15.31L18.46,16.76C19.43,15.37 20,13.75 20,12A8,8 0 0,0 12,4M12,18A6,6 0 0,1 6,12C6,10.78 6.36,9.64 7,8.69L5.54,7.24C4.57,8.63 4,10.25 4,12A8,8 0 0,0 12,20V23L16,19L12,15V18Z" 
                                                  Fill="#777" x:Name="iconPath"/>
                                        </Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#eeeeee"/>
                                            <Setter TargetName="iconPath" Property="Fill" Value="#333"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#dddddd"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Up to Date Circle Badge (Solid Green) -->
                        <Button Command="{Binding FilterByStatusBadgeCommand}" CommandParameter="Up to Date" Style="{StaticResource CleanBadgeButtonStyle}" Margin="0,0,6,2" VerticalAlignment="Bottom">
                            <Button.ToolTip>
                                <ToolTip MaxWidth="260">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Up to Date</Bold><LineBreak/>
                                        Tables fully synchronized with their source files on disk. Click to filter.
                                    </TextBlock>
                                </ToolTip>
                            </Button.ToolTip>
                            <Border Background="#10B981" Width="22" Height="22" CornerRadius="11">
                                <TextBlock Text="{Binding UpToDateCount}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>

                        <!-- Modified Circle Badge (Solid Amber/Yellow) -->
                        <Button Command="{Binding FilterByStatusBadgeCommand}" CommandParameter="Modified" Style="{StaticResource CleanBadgeButtonStyle}" Margin="0,0,6,2" VerticalAlignment="Bottom">
                            <Button.ToolTip>
                                <ToolTip MaxWidth="260">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>Modified</Bold><LineBreak/>
                                        Tables whose source Excel files on disk have been edited and require synchronization. Click to filter.
                                    </TextBlock>
                                </ToolTip>
                            </Button.ToolTip>
                            <Border Background="#F59E0B" Width="22" Height="22" CornerRadius="11">
                                <TextBlock Text="{Binding ModifiedCount}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>

                        <!-- File Missing Circle Badge (Solid Red) -->
                        <Button Command="{Binding FilterByStatusBadgeCommand}" CommandParameter="File Missing" Style="{StaticResource CleanBadgeButtonStyle}" Margin="0,0,10,2" VerticalAlignment="Bottom">
                            <Button.ToolTip>
                                <ToolTip MaxWidth="260">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="15" Foreground="#333333">
                                        <Bold>File Missing</Bold><LineBreak/>
                                        Tables whose source Excel file cannot be found at the specified path. Click to filter.
                                    </TextBlock>
                                </ToolTip>
                            </Button.ToolTip>
                            <Border Background="#EF4444" Width="22" Height="22" CornerRadius="11">
                                <TextBlock Text="{Binding FileNotFoundCount}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>

                        <!-- Live Telemetry / Status Message in Light Gray (Aligned to Bottom) -->
                        <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,4" MaxWidth="320">
                            <TextBlock Text="{Binding BusyStatusMessage}" FontSize="11.5" Foreground="#888888" 
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" ToolTip="{Binding BusyStatusMessage}"/>
                            <ProgressBar Height="2.5" IsIndeterminate="{Binding IsBusy}" Value="{Binding ProgressValue}" 
                                         Foreground="{StaticResource PrimaryBrush}" Background="#E2E8F0" BorderThickness="0" Margin="0,2,0,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Bottom Right: Action Buttons (Cancel, Sync, Delete, Add Table - TransferPlus Style) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource TransferSecondaryButtonStyle}" Content="Cancel" Margin="0,0,5,0"
                            Width="90" Height="30" Click="CloseButton_Click" IsCancel="True"
                            ToolTip="Close TablePlus dashboard"/>

                    <Button Style="{StaticResource TransferSecondaryButtonStyle}" Content="Sync" Margin="0,0,5,0"
                            Width="80" Height="30" Command="{Binding SyncSelectedCommand}"
                            IsEnabled="{Binding HasSelectedTables}"
                            ToolTip="Synchronize selected tables with source files"/>

                    <Button Style="{StaticResource TransferSecondaryButtonStyle}" Content="Delete" Margin="0,0,5,0"
                            Width="80" Height="30" Command="{Binding DeleteSelectedCommand}"
                            IsEnabled="{Binding HasSelectedTables}"
                            ToolTip="Permanently delete selected tables and their Revit views"/>

                    <Button Style="{StaticResource TransferPrimaryButtonStyle}" Content="Add Table" Margin="0"
                            Width="120" Height="30" Command="{Binding AddTableCommand}"
                            ToolTip="Import a new Excel spreadsheet into a Revit Drafting or Legend view"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
