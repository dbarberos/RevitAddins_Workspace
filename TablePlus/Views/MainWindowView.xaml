<Window x:Class="TablePlus.Views.MainWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:TablePlus.ViewModels"
        xmlns:local="clr-namespace:TablePlus.Views"
        mc:Ignorable="d"
        x:Name="DashboardWindow"
        Title="TablePlus — Master Table Dashboard"
        Width="1180" Height="780"
        MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Foreground="#0F172A"
        FontFamily="Segoe UI, Inter, Arial"
        FontSize="13"
        Icon="pack://application:,,,/TablePlus;component/Resources/Icons/TablePlus32x32.png">

    <Window.Resources>
        <!-- PALETTE BRUSHES -->
        <SolidColorBrush x:Key="WindowBgBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CardBorderHoverBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0284C7"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0369A1"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#075985"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="SuccessHoverBrush" Color="#059669"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>

        <!-- CONVERTERS -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <local:StatusToTextConverter x:Key="StatusToText"/>
        <local:StatusToBrushConverter x:Key="StatusToBrush"/>
        <local:StatusToBgBrushConverter x:Key="StatusToBg"/>
        <local:ViewTypeToTextConverter x:Key="ViewTypeToText"/>

        <!-- Card Container Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.04" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{StaticResource PrimaryPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.6"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success Green Button -->
        <Style x:Key="SuccessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{StaticResource SuccessHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.6"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Ghost Button -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource CardBorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerGhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#FEF2F2"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Input Box -->
        <Style x:Key="CleanTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource CardBorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean ComboBox Style -->
        <Style x:Key="CleanComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>

        <!-- Table Row Double Click Style -->
        <Style x:Key="TableRowStyle" TargetType="DataGridRow">
            <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0F2FE"/>
                    <Setter Property="Foreground" Value="#0369A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Table Column Header Style -->
        <Style x:Key="TableHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="CenteredTableHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource TableHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- HEADER -->
            <RowDefinition Height="Auto"/> <!-- 3 UPPER CARDS -->
            <RowDefinition Height="*"/>    <!-- VIRTUALIZED DATAGRID -->
            <RowDefinition Height="Auto"/> <!-- FOOTER -->
        </Grid.RowDefinitions>

        <!-- ROW 0: BRANDING & STATUS COUNTERS -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <Border Background="{StaticResource PrimaryBrush}" CornerRadius="6" Padding="6,4" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="TABLEPLUS" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock Text="Master Table Dashboard" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Manage, synchronize, and format imported spreadsheets, schedules, and drawing tables." 
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- COUNTERS PILL -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#F1F5F9" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total Tables: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Selected: " Foreground="#065F46" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedCount}" FontWeight="Bold" Foreground="#047857" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Pending / Out of Date: " Foreground="#92400E" FontSize="12"/>
                        <TextBlock Text="{Binding OutOfDateCount}" FontWeight="Bold" Foreground="#B45309" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ROW 1: UPPER CONTROL ZONE (3 ACTION CARDS) -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/> <!-- CARD 1: ACTIONS -->
                <ColumnDefinition Width="2.2*"/> <!-- CARD 2: FILTERS & SEARCH -->
                <ColumnDefinition Width="1.6*"/> <!-- CARD 3: REFRESH & DIAGNOSTICS -->
            </Grid.ColumnDefinitions>

            <!-- CARD 1: ACTIONS -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="⚡" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Table Actions" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <WrapPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="+ Add Table" Margin="0,0,6,6"
                                Command="{Binding AddTableCommand}" ToolTip="Import a new Excel spreadsheet into a Revit Drafting or Legend view"/>

                        <Button Style="{StaticResource SuccessButtonStyle}" Content="🔄 Sync Selected" Margin="0,0,6,6"
                                Command="{Binding SyncSelectedCommand}" ToolTip="Re-read source files and update Revit views for all checked rows"/>

                        <Button Style="{StaticResource GhostButtonStyle}" Content="👁️ Open View" Margin="0,0,6,6"
                                Command="{Binding OpenSelectedViewCommand}" ToolTip="Switch the active Revit view to the selected table"/>

                        <Button Style="{StaticResource DangerGhostButtonStyle}" Content="🗑️ Delete / Unlink" Margin="0,0,0,6"
                                Command="{Binding DeleteSelectedCommand}" ToolTip="Permanently delete Revit view or unlink TablePlus metadata"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- CARD 2: FILTERS & SEARCH -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="4,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔍" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Filters &amp; Search" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- SEARCH BOX -->
                        <TextBox Grid.Column="0" Style="{StaticResource CleanTextBoxStyle}" Height="30" Margin="0,0,6,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filter tables by view name or source file"/>

                        <!-- VIEW TYPE FILTER -->
                        <ComboBox Grid.Column="1" Style="{StaticResource CleanComboBoxStyle}" Height="30" Margin="0,0,6,0"
                                  ItemsSource="{Binding ViewTypeFilterOptions}"
                                  SelectedItem="{Binding SelectedViewTypeFilter}"/>

                        <!-- STATUS FILTER -->
                        <ComboBox Grid.Column="2" Style="{StaticResource CleanComboBoxStyle}" Height="30"
                                  ItemsSource="{Binding StatusFilterOptions}"
                                  SelectedItem="{Binding SelectedStatusFilter}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- CARD 3: STATUS & DIAGNOSTICS -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="4,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="System Status" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Padding="6,2" Content="🔄" 
                                Command="{Binding RefreshInventoryCommand}" ToolTip="Rescan Revit document"/>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BusyStatusMessage}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" 
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                        <ProgressBar Height="4" IsIndeterminate="{Binding IsBusy}" Value="{Binding ProgressValue}" 
                                     Foreground="{StaticResource PrimaryBrush}" Background="#E2E8F0" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 2: LOWER DATA ZONE (VIRTUALIZED DATAGRID WITH 11 COLUMNS) -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,0,0,12">
            <DataGrid x:Name="TablesDataGrid"
                      ItemsSource="{Binding FilteredTables}"
                      SelectedItem="{Binding SelectedTable}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      Background="White"
                      RowStyle="{StaticResource TableRowStyle}"
                      ColumnHeaderStyle="{StaticResource TableHeaderStyle}"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      EnableRowVirtualization="True">

                <DataGrid.Columns>

                    <!-- COL 1: SELECTION CHECKBOX WITH HEADER CHECKBOX -->
                    <DataGridTemplateColumn Width="42" HeaderStyle="{StaticResource CenteredTableHeaderStyle}">
                        <DataGridTemplateColumn.Header>
                            <CheckBox IsChecked="{Binding DataContext.IsSelectAllChecked, RelativeSource={RelativeSource AncestorType=Window}}"
                                      ToolTip="Select All / None" HorizontalAlignment="Center"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 2: SOURCE TYPE BADGE -->
                    <DataGridTemplateColumn Header="Src" Width="55" HeaderStyle="{StaticResource CenteredTableHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#F1F5F9" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SourceBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 3: STATUS BADGE -->
                    <DataGridTemplateColumn Header="Status" Width="115">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusToBg}}"
                                        BorderThickness="1" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        ToolTip="{Binding StatusTooltip}">
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="#E2E8F0"/>
                                    </Border.BorderBrush>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusToText}}" 
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 4: REVIT VIEW NAME -->
                    <DataGridTemplateColumn Header="View Name" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ViewName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" 
                                           VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis"
                                           ToolTip="Double-click to open this view"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 5: VIEW TYPE -->
                    <DataGridTemplateColumn Header="View Type" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ViewType, Converter={StaticResource ViewTypeToText}}" 
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 6: VIEW SCALE -->
                    <DataGridTemplateColumn Header="Scale" Width="65" HeaderStyle="{StaticResource CenteredTableHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FormattedScale}" Foreground="{StaticResource TextSecondaryBrush}" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 7: SOURCE FILE -->
                    <DataGridTemplateColumn Header="Source File" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SourceFileName}" Foreground="{StaticResource TextSecondaryBrush}" 
                                           VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SourceFilePath}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 8: WORKSHEET DROPDOWN -->
                    <DataGridTemplateColumn Header="Worksheet / Range" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Style="{StaticResource CleanComboBoxStyle}"
                                          ItemsSource="{Binding AvailableSheets}"
                                          SelectedItem="{Binding SelectedSheetName}"
                                          SelectionChanged="WorksheetComboBox_SelectionChanged"
                                          Height="26" VerticalAlignment="Center" Margin="4,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 9: AUTO-SYNC CHECKBOX -->
                    <DataGridTemplateColumn Header="Auto-Sync" Width="78" HeaderStyle="{StaticResource CenteredTableHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsAutoSyncEnabled, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ToolTip="Check to automatically sync on project open"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 10: BLACK & WHITE CHECKBOX -->
                    <DataGridTemplateColumn Header="B&amp;W" Width="52" HeaderStyle="{StaticResource CenteredTableHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsBlackAndWhite, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ToolTip="Force solid black text/lines and suppress cell fills"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 11: DESIGN BUTTON -->
                    <DataGridTemplateColumn Header="Design" Width="95" HeaderStyle="{StaticResource CenteredTableHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButtonStyle}" Padding="6,3" Margin="4,0"
                                        Content="🎨 Design..." HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Command="{Binding DataContext.OpenDesignWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Configure line styles, body typography, and header overrides"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ROW 3: FOOTER ZONE -->
        <Border Grid.Row="3" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💡 Tip: Double-click any row to immediately switch to its Revit view." 
                               FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Content="Close" Margin="0,0,8,0"
                        Click="CloseButton_Click"/>

                <Button Grid.Column="2" Style="{StaticResource SuccessButtonStyle}" Content="🔄 Sync Selected"
                        Command="{Binding SyncSelectedCommand}"/>
            </Grid>
        </Border>

    </Grid>
</Window>
