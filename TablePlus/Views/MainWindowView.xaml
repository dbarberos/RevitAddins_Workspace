<Window x:Class="TablePlus.Views.MainWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:TablePlus.ViewModels"
        xmlns:local="clr-namespace:TablePlus.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        x:Name="DashboardWindow"
        Title="TablePlus"
        Width="1180" Height="780"
        MinWidth="900" MinHeight="550"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA"
        Foreground="#333333"
        FontFamily="Segoe UI, Inter, Arial"
        FontSize="13"
        Icon="pack://application:,,,/TablePlus;component/Resources/Icons/TablePlus32x32.png">

    <Window.Resources>
        <!-- TransferPlus ScrollBar Slim Parameters (10px Width & Height) -->
        <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">10</sys:Double>
        <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">10</sys:Double>

        <!-- PALETTE BRUSHES -->
        <SolidColorBrush x:Key="WindowBgBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="CardBorderHoverBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0062A3"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#004F85"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="SuccessHoverBrush" Color="#059669"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#333333"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#555555"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#888888"/>

        <!-- CONVERTERS -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <local:StatusToTextConverter x:Key="StatusToText"/>
        <local:StatusToBrushConverter x:Key="StatusToBrush"/>
        <local:StatusToBgBrushConverter x:Key="StatusToBg"/>
        <local:ViewTypeToTextConverter x:Key="ViewTypeToText"/>

        <!-- Card Container Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.04" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{StaticResource PrimaryPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.6"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success Green Button -->
        <Style x:Key="SuccessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{StaticResource SuccessHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.6"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Ghost Button -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource CardBorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerGhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#FEF2F2"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Input Box -->
        <Style x:Key="CleanTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource CardBorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean ComboBox Style -->
        <Style x:Key="CleanComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>

        <!-- Custom Toggle Switch CheckBox Style (TransferPlus Style) -->
        <Style x:Key="SwitchStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" Cursor="Hand">
                            <Border x:Name="Background" Width="28" Height="14" Background="#ddd" CornerRadius="7" Padding="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="White" HorizontalAlignment="Left">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="#777"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" 
                                                             To="14" 
                                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" 
                                                             To="0" 
                                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Table Row Double Click Style -->
        <Style x:Key="TableRowStyle" TargetType="DataGridRow">
            <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#F0F0F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="MinHeight" Value="26"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CCE8FF"/>
                    <Setter Property="Foreground" Value="#007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Table Column Header Style (Matches TransferPlus Elements Explorer Header) -->
        <Style x:Key="TableHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="SeparatorBrush" Value="#CCCCCC"/>
            <Setter Property="SeparatorVisibility" Value="Visible"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>

        <Style x:Key="CenteredTableHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource TableHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Checkbox Column Header Style (No right border, seamless merge with View Name) -->
        <Style x:Key="CheckboxColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource TableHeaderStyle}">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="SeparatorVisibility" Value="Collapsed"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Header Icon Flat Button Style (Matches TransferPlus) -->
        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="10" Padding="4">
                            <Viewbox Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e0e0e0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#d0d0d0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TransferPlus Secondary Action Button Style (Cancel, Sync, Delete) -->
        <Style x:Key="TransferSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E1E1E1"/>
            <Setter Property="BorderBrush" Value="#707070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#CCE8FF"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#C5C5C5"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#303030"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Background" Value="#F3F3F3"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#B0B0B0"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TransferPlus Primary Action Button Style (Add Table / Transfer Now) -->
        <Style x:Key="TransferPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="BorderBrush" Value="#007ACC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#CCE8FF"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#005B9A"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#005B9A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Background" Value="#F3F3F3"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#B0B0B0"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- UPPER CONTROL ZONE -->
            <RowDefinition Height="*"/>    <!-- VIRTUALIZED DATAGRID -->
            <RowDefinition Height="Auto"/> <!-- FOOTER -->
        </Grid.RowDefinitions>

        <!-- ROW 0: UPPER CONTROL ZONE (FILTERS & STATUS CARDS) -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- CARD 1: FILTERS & SEARCH (COMPACT HALF-WIDTH) -->
                <ColumnDefinition Width="Auto"/> <!-- CARD 2: REFRESH & DIAGNOSTICS -->
                <ColumnDefinition Width="*"/>    <!-- OPEN SPACE (PREVENTS CARDS FROM STRETCHING ACROSS ROW) -->
            </Grid.ColumnDefinitions>

            <!-- CARD 1: FILTER (TRANSFERPLUS STYLE) -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Width="376" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search Box -->
                        <RowDefinition Height="Auto"/> <!-- Search Toggles -->
                    </Grid.RowDefinitions>

                    <!-- Search Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Filter:" FontWeight="Bold" FontSize="12" Foreground="#999" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="4,2" BorderBrush="#e0e0e0" BorderThickness="1" Height="26">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ApplyFilterCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Button Content="Apply" Command="{Binding ApplyFilterCommand}" Padding="12,3" VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#007ACC"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#F3F3F3"/>
                                                <Setter Property="Foreground" Value="#B0B0B0"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Search Toggles Row -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <CheckBox Content="Use OR" IsChecked="{Binding FilterUseOr}" Style="{StaticResource SwitchStyle}" FontSize="11" Margin="0,0,10,0"/>
                        <CheckBox Content="Only by name" IsChecked="{Binding FilterOnlyNames}" Style="{StaticResource SwitchStyle}" FontSize="11" Margin="0,0,10,0"/>
                        <CheckBox Content="Use Regex" IsChecked="{Binding FilterUseRegex}" Style="{StaticResource SwitchStyle}" FontSize="11" Margin="0,0,0,0"/>

                        <!-- RegEx Helper Button for Filter -->
                        <ToggleButton x:Name="BtnFilterRegexHelper" Width="20" Height="20" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Regex help" ToolTipService.InitialShowDelay="600">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border CornerRadius="10" Background="#F3F3F3" BorderThickness="1" BorderBrush="#E0E0E0">
                                        <TextBlock Text="i" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#555" FontWeight="SemiBold" FontSize="10" FontStyle="Italic"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup IsOpen="{Binding IsChecked, ElementName=BtnFilterRegexHelper, Mode=TwoWay}" StaysOpen="False" PlacementTarget="{Binding ElementName=BtnFilterRegexHelper}" Placement="Bottom" AllowsTransparency="True" Margin="0,5,0,0">
                            <Border Background="White" BorderBrush="#ccc" BorderThickness="1" CornerRadius="4" Padding="10" Width="400" MaxHeight="500">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                                </Border.Effect>
                                <ScrollViewer MaxHeight="450" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <StackPanel.Resources>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="5"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                            </Style>
                                        </StackPanel.Resources>
                                        <TextBlock Text="Regex Help (Filter)" FontWeight="Bold" Margin="0,0,0,15" FontSize="14"/>
                                        <!-- Category: Basic Matching & Anchors -->
                                        <TextBlock Text="Basic Matching &amp; Anchors" FontWeight="Bold" Foreground="#333" Margin="0,10,0,5" FontSize="11"/>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="^[\w\s\W]+$" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text="^[\w\s\W]+$" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="9.5" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Selects the full title completely" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="text" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text="text" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Matches the exact text" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="c.sa" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text="c.sa" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Matches any single character (e.g. casa, cosa)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="^" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text="^" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Start of string anchor" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="$" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text="$" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="End of string anchor" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="^text" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text="^text" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Starts with 'text'" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="text$" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text="text$" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Ends with 'text'" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter=".*text.*" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text=".*text.*" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Contains 'text' anywhere" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>

                                        <!-- Category: Character Classes -->
                                        <TextBlock Text="Character Classes" FontWeight="Bold" Foreground="#333" Margin="0,15,0,5" FontSize="11"/>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="\d" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text="\d" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Any single digit (0-9)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="\D" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text="\D" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Any non-digit character" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="\w" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text="\w" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Word character (letter, digit, _)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="\s" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text="\s" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Whitespace character (space, tab)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="[aeiou]" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text="[aeiou]" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Any single character in set" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="[^0-9]" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text="[^0-9]" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Any character NOT in set" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="^[A-Za-z]+$" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text="^[A-Za-z]+$" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="9.5" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Only letters (no numbers/symbols)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="^\d+$" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text="^\d+$" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Only digits (no letters/symbols)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>

                                        <!-- Category: Quantifiers & Multipliers -->
                                        <TextBlock Text="Quantifiers &amp; Multipliers" FontWeight="Bold" Foreground="#333" Margin="0,15,0,5" FontSize="11"/>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="+" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="One or more occurrences" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="?" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Zero or one occurrence (optional)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="*" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text="*" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Zero or more occurrences" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="\d{3}" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text="\d{3}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Exactly 3 digits" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>

                                        <!-- Category: Or & Grouping -->
                                        <TextBlock Text="Or &amp; Grouping" FontWeight="Bold" Foreground="#333" Margin="0,15,0,5" FontSize="11"/>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="gato|perro" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text="gato|perro" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Matches 'gato' OR 'perro'" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>

                                        <!-- Category: Not Contain (Negative Matching) -->
                                        <TextBlock Text="Not Contain (Negative Matching)" FontWeight="Bold" Foreground="#333" Margin="0,15,0,5" FontSize="11"/>
                                        <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="^(?!.*text).*$" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,5" Width="355">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,10,0">
                                                    <TextBlock Text="^(?!.*text).*$" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="9" Foreground="#111"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Does not contain 'text' (matches everything else)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10.5"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CARD 2: STATUS & DIAGNOSTICS -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Width="260" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="System Status" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Padding="6,2" Content="🔄" 
                                Command="{Binding RefreshInventoryCommand}" ToolTip="Rescan Revit document"/>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BusyStatusMessage}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" 
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                        <ProgressBar Height="4" IsIndeterminate="{Binding IsBusy}" Value="{Binding ProgressValue}" 
                                     Foreground="{StaticResource PrimaryBrush}" Background="#E2E8F0" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 1: LOWER DATA ZONE (VIRTUALIZED DATAGRID WITH 11 COLUMNS) -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="0" Padding="0" Margin="0,0,0,12">
            <DataGrid x:Name="TablesDataGrid"
                      ItemsSource="{Binding FilteredTables}"
                      SelectedItem="{Binding SelectedTable}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserResizeColumns="True"
                      FrozenColumnCount="2"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F0F0"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      Background="White"
                      RowStyle="{StaticResource TableRowStyle}"
                      ColumnHeaderStyle="{StaticResource TableHeaderStyle}"
                      ScrollViewer.CanContentScroll="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      EnableRowVirtualization="True">

                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.Panel>
                            <ItemsPanelTemplate>
                                <DataGridRowsPresenter/>
                            </ItemsPanelTemplate>
                        </GroupStyle.Panel>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <Expander IsExpanded="{Binding DataContext.IsAllGroupExpanded, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                      BorderThickness="0">
                                                <Expander.Template>
                                                    <ControlTemplate TargetType="{x:Type Expander}">
                                                        <DockPanel>
                                                            <Border DockPanel.Dock="Top" 
                                                                    Background="#F4F6F8" 
                                                                    BorderBrush="#E2E8F0" 
                                                                    BorderThickness="0,0,0,1" 
                                                                    MinHeight="26" 
                                                                    Padding="0,2">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="42"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Group CheckBox at Column 0 (Width 42) -->
                                                                    <CheckBox Grid.Column="0" 
                                                                              IsChecked="{Binding DataContext.IsSelectAllChecked, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              IsThreeState="True"
                                                                              HorizontalAlignment="Center" 
                                                                              VerticalAlignment="Center"/>

                                                                    <!-- Group Expander Toggle at Column 1 start -->
                                                                    <ToggleButton Grid.Column="1" 
                                                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                                  ClickMode="Press"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="2,0,4,0">
                                                                        <ToggleButton.Template>
                                                                            <ControlTemplate TargetType="ToggleButton">
                                                                                <Border Width="18" Height="20" Background="Transparent" Cursor="Hand">
                                                                                    <TextBlock x:Name="ExpanderText" Text="▶" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10" Foreground="#555555"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsChecked" Value="True">
                                                                                        <Setter TargetName="ExpanderText" Property="Text" Value="▼"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </ToggleButton.Template>
                                                                    </ToggleButton>

                                                                    <!-- Group Name ('All') & Item Count -->
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#333333" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                        <TextBlock Text="{Binding ItemCount, StringFormat='({0})'}" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <ContentPresenter x:Name="ExpandSite" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" DockPanel.Dock="Bottom" Focusable="False" Visibility="Visible"/>
                                                        </DockPanel>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsExpanded" Value="False">
                                                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Expander.Template>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>

                <DataGrid.Columns>

                    <!-- COL 1: SELECTION CHECKBOX (FROZEN 1, FIXED 42px, NO RIGHT DIVIDER, EXPAND/COLLAPSE IN HEADER) -->
                    <DataGridTemplateColumn Width="42" MinWidth="42" MaxWidth="42" CanUserResize="False" HeaderStyle="{StaticResource CheckboxColumnHeaderStyle}">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Command="{Binding DataContext.CollapseAllCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        Style="{StaticResource HeaderIconButtonStyle}" ToolTip="Collapse All" Width="18" Height="18" Margin="1,0">
                                    <Path Data="M4,1 L8,7 L0,7 Z" Fill="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button Command="{Binding DataContext.ExpandAllCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        Style="{StaticResource HeaderIconButtonStyle}" ToolTip="Expand All" Width="18" Height="18" Margin="1,0">
                                    <Path Data="M0,1 L8,1 L4,7 Z" Fill="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 2: REVIT VIEW NAME (FROZEN 2, CLEAN VIEW NAME HEADER) -->
                    <DataGridTemplateColumn Header="View Name" Width="200" MinWidth="140" CanUserResize="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="0">
                                    <TextBlock Text="{Binding ViewName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" 
                                               VerticalAlignment="Center" Margin="16,0,6,0" TextTrimming="CharacterEllipsis"
                                               ToolTip="Double-click to open this view"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 3: SOURCE TYPE BADGE -->
                    <DataGridTemplateColumn Header="Src" Width="60" MinWidth="45" CanUserResize="True" HeaderStyle="{StaticResource CenteredTableHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#F1F5F9" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SourceBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 4: STATUS BADGE -->
                    <DataGridTemplateColumn Header="Status" Width="120" MinWidth="85" CanUserResize="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusToBg}}"
                                        BorderThickness="1" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        ToolTip="{Binding StatusTooltip}">
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="#E2E8F0"/>
                                    </Border.BorderBrush>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusToText}}" 
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 5: VIEW TYPE -->
                    <DataGridTemplateColumn Header="View Type" Width="110" MinWidth="85" CanUserResize="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ViewType, Converter={StaticResource ViewTypeToText}}" 
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 6: VIEW SCALE -->
                    <DataGridTemplateColumn Header="Scale" Width="70" MinWidth="55" CanUserResize="True" HeaderStyle="{StaticResource CenteredTableHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FormattedScale}" Foreground="{StaticResource TextSecondaryBrush}" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 7: SOURCE FILE -->
                    <DataGridTemplateColumn Header="Source File" Width="260" MinWidth="110" CanUserResize="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SourceFileName}" Foreground="{StaticResource TextSecondaryBrush}" 
                                           VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SourceFilePath}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 8: WORKSHEET DROPDOWN -->
                    <DataGridTemplateColumn Header="Worksheet / Range" Width="160" MinWidth="135" CanUserResize="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Style="{StaticResource CleanComboBoxStyle}"
                                          ItemsSource="{Binding AvailableSheets}"
                                          SelectedItem="{Binding SelectedSheetName}"
                                          SelectionChanged="WorksheetComboBox_SelectionChanged"
                                          Height="26" VerticalAlignment="Center" Margin="4,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 9: AUTO-SYNC CHECKBOX -->
                    <DataGridTemplateColumn Header="Auto-Sync" Width="85" MinWidth="75" CanUserResize="True" HeaderStyle="{StaticResource CenteredTableHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsAutoSyncEnabled, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ToolTip="Check to automatically sync on project open"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 10: BLACK & WHITE CHECKBOX -->
                    <DataGridTemplateColumn Header="B&amp;W" Width="58" MinWidth="48" CanUserResize="True" HeaderStyle="{StaticResource CenteredTableHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsBlackAndWhite, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ToolTip="Force solid black text/lines and suppress cell fills"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COL 11: DESIGN BUTTON -->
                    <DataGridTemplateColumn Header="Design" Width="95" MinWidth="80" CanUserResize="True" HeaderStyle="{StaticResource CenteredTableHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButtonStyle}" Padding="6,3" Margin="4,0"
                                        Content="🎨 Design..." HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Command="{Binding DataContext.OpenDesignWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Configure line styles, body typography, and header overrides"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ROW 2: FOOTER ZONE (WITHOUT DIVIDING SEPARATOR LINE) -->
        <Border Grid.Row="2" BorderThickness="0" Padding="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Bottom Left: Configuration & Sources Cog and Tables Selected Card (Flush to Bottom) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <Button Command="{Binding OpenConfigurationCommand}" Margin="0,0,10,0" VerticalAlignment="Bottom" Cursor="Hand" ToolTip="Configuration &amp; Sources">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="12" Padding="4">
                                    <Viewbox Width="18" Height="18">
                                        <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.97 19.05,5.05L16.56,6.05C16.04,5.66 15.47,5.34 14.86,5.12L14.47,2.5C14.43,2.25 14.22,2.07 13.97,2.07H9.97C9.72,2.07 9.5,2.25 9.47,2.5L9.09,5.12C8.47,5.34 7.9,5.66 7.38,6.05L4.89,5.05C4.67,4.97 4.4,5.05 4.27,5.27L2.27,8.73C2.15,8.95 2.2,9.22 2.39,9.37L4.5,11C4.47,11.34 4.45,11.67 4.45,12C4.45,12.33 4.47,12.65 4.5,12.97L2.39,14.63C2.2,14.78 2.15,15.05 2.27,15.27L4.27,18.73C4.4,18.95 4.67,19.03 4.89,18.95L7.38,17.95C7.9,18.34 8.47,18.66 9.09,18.88L9.47,21.5C9.5,21.75 9.72,21.93 9.97,21.93H13.97C14.22,21.93 14.43,21.75 14.47,21.5L14.86,18.88C15.47,18.66 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" Fill="#777" x:Name="iconPath"/>
                                    </Viewbox>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#eeeeee"/>
                                        <Setter TargetName="iconPath" Property="Fill" Value="#333"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#dddddd"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border Background="#ffffff" CornerRadius="8" Padding="15,6" BorderBrush="#e0e0e0" BorderThickness="1" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding SelectedCount}" FontSize="24" FontWeight="Medium" VerticalAlignment="Bottom" Foreground="#333" Margin="0,0,0,0"/>
                            <TextBlock Text=" / " FontSize="16" FontWeight="Normal" VerticalAlignment="Bottom" Foreground="#888" Margin="4,0,4,2"/>
                            <TextBlock Text="{Binding TotalCount}" FontSize="16" FontWeight="Normal" VerticalAlignment="Bottom" Foreground="#666" Margin="0,0,10,2"/>
                            <TextBlock Text="tables selected" VerticalAlignment="Bottom" Foreground="#666" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,3"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Bottom Right: Action Buttons (Cancel, Sync, Delete, Add Table - TransferPlus Style) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource TransferSecondaryButtonStyle}" Content="Cancel" Margin="0,0,5,0"
                            Width="90" Height="30" Click="CloseButton_Click" IsCancel="True"
                            ToolTip="Close TablePlus dashboard"/>

                    <Button Style="{StaticResource TransferSecondaryButtonStyle}" Content="Sync" Margin="0,0,5,0"
                            Width="80" Height="30" Command="{Binding SyncSelectedCommand}"
                            IsEnabled="{Binding HasSelectedTables}"
                            ToolTip="Synchronize selected tables with source files"/>

                    <Button Style="{StaticResource TransferSecondaryButtonStyle}" Content="Delete" Margin="0,0,5,0"
                            Width="80" Height="30" Command="{Binding DeleteSelectedCommand}"
                            IsEnabled="{Binding HasSelectedTables}"
                            ToolTip="Permanently delete selected tables and their Revit views"/>

                    <Button Style="{StaticResource TransferPrimaryButtonStyle}" Content="Add Table" Margin="0"
                            Width="120" Height="30" Command="{Binding AddTableCommand}"
                            ToolTip="Import a new Excel spreadsheet into a Revit Drafting or Legend view"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
