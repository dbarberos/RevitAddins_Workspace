<Window x:Class="TablePlus.Views.TableImportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:TablePlus.Views"
        xmlns:viewmodels="clr-namespace:TablePlus.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        x:Name="TableImportWindow"
        Title="TablePlus — Add Tables"
        Width="550" Height="690"
        MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA"
        Foreground="#333333"
        FontFamily="Segoe UI, Inter, -apple-system, sans-serif"
        FontSize="12.5"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Icon="pack://application:,,,/TablePlus;component/Resources/Icons/TablePlus32x32.png">

    <Window.Resources>
        <!-- TransferPlus / TablePlus ScrollBar Slim Parameters (10px Width & Height) -->
        <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">10</sys:Double>
        <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">10</sys:Double>

        <!-- Table Column Header Style (Matches MainWindow / TransferPlus) -->
        <Style x:Key="TableHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="SeparatorBrush" Value="#CCCCCC"/>
            <Setter Property="SeparatorVisibility" Value="Visible"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>

        <Style x:Key="CenteredTableHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource TableHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <!-- Custom Toggle Switch CheckBox Style (TransferPlus Style) -->
        <Style x:Key="SwitchStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" Cursor="Hand">
                            <Border x:Name="Background" Width="28" Height="14" Background="#ddd" CornerRadius="7" Padding="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="White" HorizontalAlignment="Left">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="#777"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" 
                                                             To="14" 
                                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" 
                                                             To="0" 
                                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- COLOR PALETTE BRUSHES -->
        <SolidColorBrush x:Key="WindowBgBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="CardBorderHoverBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="FileRowBorderAndSheetBgBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="RowHoverBrush" Color="#E0F2FE"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0062A3"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#004C80"/>
        <SolidColorBrush x:Key="PrimaryDisabledBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="SuccessBgBrush" Color="#ECFDF5"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="ErrorBgBrush" Color="#FEF2F2"/>

        <!-- CONVERTERS -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <views:EnumDisplayConverter x:Key="EnumDisplayConverter"/>
        <views:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <!-- Expand / Collapse Chevron Button Template (Bound directly to IsExpanded) -->
        <ControlTemplate x:Key="ChevronButtonTemplate" TargetType="Button">
            <Border Background="Transparent" Width="20" Height="20" Cursor="Hand">
                <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 0 8 Z" Fill="#64748B" 
                      HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="6" Height="8"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform Angle="0"/>
                    </Path.RenderTransform>
                </Path>
            </Border>
            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Arrow" Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="90"/>
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Style for Area / Region ComboBox Items with Thin Separator Line -->
        <Style x:Key="RegionComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="───">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Height" Value="5"/>
                    <Setter Property="MinHeight" Value="1"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,1"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                <Border BorderThickness="0,0,0,1" BorderBrush="#CBD5E1" Margin="2,2,2,2" SnapsToDevicePixels="True"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="---">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Height" Value="5"/>
                    <Setter Property="MinHeight" Value="1"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,1"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                <Border BorderThickness="0,0,0,1" BorderBrush="#CBD5E1" Margin="2,2,2,2" SnapsToDevicePixels="True"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Path Column Context Menu for Absolute / Relative Switching -->
        <ContextMenu x:Key="PathContextMenu">
            <MenuItem Header="Absolute Path" 
                      IsChecked="{Binding IsRelativePath, Converter={StaticResource InverseBooleanConverter}}"
                      Command="{Binding SwitchToAbsolutePathCommand}"/>
            <MenuItem Header="Relative Path" 
                      IsChecked="{Binding IsRelativePath}"
                      Command="{Binding SwitchToRelativePathCommand}"/>
        </ContextMenu>

        <!-- Card Container Border Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.04" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Ghost Button Style -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Text Box Style -->
        <Style x:Key="DataGridTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12,10,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Filter Card -->
            <RowDefinition Height="*"/>    <!-- 1: Batch Items DataGrid -->
            <RowDefinition Height="Auto"/> <!-- 2: Table Properties Card -->
            <RowDefinition Height="Auto"/> <!-- 3: Error & Progress -->
            <RowDefinition Height="Auto"/> <!-- 4: Footer with Selection, Cancel & Apply -->
        </Grid.RowDefinitions>

        <!-- ROW 0: FILTER CARD (TRANSFERPLUS / TABLEPLUS STYLE) -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="10,7" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Search Box -->
                    <RowDefinition Height="Auto"/> <!-- Search Toggles -->
                </Grid.RowDefinitions>

                <!-- Search Row -->
                <Grid Grid.Row="0" Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Filter:" FontWeight="Bold" FontSize="12" Foreground="#999" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="4,2" BorderBrush="#e0e0e0" BorderThickness="1" Height="26">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding ApplyFilterCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Button Content="Apply" Command="{Binding ApplyFilterCommand}" Padding="12,3" VerticalAlignment="Center" Height="26">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#007ACC"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#0062A3"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#F3F3F3"/>
                                            <Setter Property="Foreground" Value="#B0B0B0"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Search Toggles Row -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <CheckBox Content="Use OR" IsChecked="{Binding FilterUseOr}" Style="{StaticResource SwitchStyle}" FontSize="11" Margin="0,0,10,0"/>
                    <CheckBox Content="Only by name" IsChecked="{Binding FilterOnlyNames}" Style="{StaticResource SwitchStyle}" FontSize="11" Margin="0,0,10,0"/>
                    <CheckBox Content="Use Regex" IsChecked="{Binding FilterUseRegex}" Style="{StaticResource SwitchStyle}" FontSize="11" Margin="0,0,0,0"/>

                    <!-- RegEx Helper Button for Filter -->
                    <ToggleButton x:Name="BtnFilterRegexHelper" Width="18" Height="18" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Regex help" ToolTipService.InitialShowDelay="600">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border CornerRadius="9" Background="#F3F3F3" BorderThickness="1" BorderBrush="#E0E0E0">
                                    <TextBlock Text="i" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#555" FontWeight="SemiBold" FontSize="10" FontStyle="Italic"/>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Popup IsOpen="{Binding IsChecked, ElementName=BtnFilterRegexHelper, Mode=TwoWay}" StaysOpen="False" PlacementTarget="{Binding ElementName=BtnFilterRegexHelper}" Placement="Bottom" AllowsTransparency="True" Margin="0,5,0,0">
                        <Border Background="White" BorderBrush="#ccc" BorderThickness="1" CornerRadius="4" Padding="10" Width="380" MaxHeight="450">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                            </Border.Effect>
                            <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <StackPanel.Resources>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="4"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </Style>
                                    </StackPanel.Resources>
                                    <TextBlock Text="Regex Help (Filter)" FontWeight="Bold" Margin="0,0,0,12" FontSize="13"/>
                                    <!-- Category: Basic Matching &amp; Anchors -->
                                    <TextBlock Text="Basic Matching &amp; Anchors" FontWeight="Bold" Foreground="#333" Margin="0,8,0,4" FontSize="11"/>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="^[\w\s\W]+$" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text="^[\w\s\W]+$" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="9.5" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Selects the full title completely" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="text" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text="text" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Matches the exact text" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="c.sa" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text="c.sa" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Matches any single character (e.g. casa, cosa)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="^" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text="^" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Start of string anchor" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="$" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text="$" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="End of string anchor" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="^text" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text="^text" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Starts with 'text'" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="text$" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text="text$" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Ends with 'text'" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter=".*text.*" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text=".*text.*" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Contains 'text' anywhere" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>

                                    <!-- Category: Character Classes -->
                                    <TextBlock Text="Character Classes" FontWeight="Bold" Foreground="#333" Margin="0,12,0,4" FontSize="11"/>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="\d" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text="\d" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Any single digit (0-9)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="\D" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text="\D" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Any non-digit character" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="\w" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text="\w" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Word character (letter, digit, _)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="\s" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text="\s" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Whitespace character (space, tab)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="[aeiou]" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text="[aeiou]" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Any single character in set" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="[^0-9]" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text="[^0-9]" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Any character NOT in set" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="^[A-Za-z]+$" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text="^[A-Za-z]+$" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="9.5" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Only letters (no numbers/symbols)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="^\d+$" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text="^\d+$" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Only digits (no letters/symbols)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>

                                    <!-- Category: Quantifiers &amp; Multipliers -->
                                    <TextBlock Text="Quantifiers &amp; Multipliers" FontWeight="Bold" Foreground="#333" Margin="0,12,0,4" FontSize="11"/>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="+" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="One or more occurrences" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="?" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Zero or one occurrence (optional)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="*" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text="*" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Zero or more occurrences" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="\d{3}" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text="\d{3}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Exactly 3 digits" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>

                                    <!-- Category: Or &amp; Grouping -->
                                    <TextBlock Text="Or &amp; Grouping" FontWeight="Bold" Foreground="#333" Margin="0,12,0,4" FontSize="11"/>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="gato|perro" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text="gato|perro" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Matches 'gato' OR 'perro'" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>

                                    <!-- Category: Not Contain (Negative Matching) -->
                                    <TextBlock Text="Not Contain (Negative Matching)" FontWeight="Bold" Foreground="#333" Margin="0,12,0,4" FontSize="11"/>
                                    <Button Command="{Binding InsertFilterRegexHelperCommand}" CommandParameter="^(?!.*text).*$" Click="CloseFilterRegexPopup" HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4" Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="26" Margin="0,0,8,0">
                                                <TextBlock Text="^(?!.*text).*$" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="9" Foreground="#111"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Does not contain 'text' (matches everything else)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: BATCH FILES DATAGRID (STRAIGHT BORDERS - CORNER RADIUS 0) -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="0" Padding="0">
            <DataGrid ItemsSource="{Binding FilteredBatchFiles}" 
                      SelectedItem="{Binding SelectedBatchFile}"
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserResizeColumns="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="White"
                      BorderThickness="0"
                      MinRowHeight="32"
                      RowHeaderWidth="0"
                      SelectionMode="Single"
                      ColumnHeaderStyle="{StaticResource TableHeaderStyle}"
                      ScrollViewer.CanContentScroll="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      EnableRowVirtualization="True">

                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>
                </DataGrid.Resources>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type DataGridRow}">
                                    <SelectiveScrollingGrid>
                                        <SelectiveScrollingGrid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </SelectiveScrollingGrid.RowDefinitions>

                                        <!-- File line: White background with Light Gray perimeter border -->
                                        <Border Grid.Row="0" x:Name="FileRowBorder"
                                                SelectiveScrollingGrid.SelectiveScrollingOrientation="Both"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{StaticResource FileRowBorderAndSheetBgBrush}"
                                                BorderThickness="1"
                                                Margin="0,1,0,1"
                                                MinHeight="32"
                                                SnapsToDevicePixels="True">
                                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" 
                                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Border>

                                        <!-- Sheet lines: Light Gray background with NO perimeter border, collapsed when IsExpanded is false -->
                                        <Border Grid.Row="1" x:Name="SheetRowsBorder"
                                                SelectiveScrollingGrid.SelectiveScrollingOrientation="Both"
                                                Background="{StaticResource FileRowBorderAndSheetBgBrush}"
                                                BorderThickness="0"
                                                Margin="0,0,0,2"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                                SnapsToDevicePixels="True">
                                            <StackPanel Margin="0,2,0,5">
                                                <!-- Master Row: "All worksheets" (Hierarchical select-all, visible when multiple sheets exist) -->
                                                <Border BorderThickness="0" Padding="14,3,12,3"
                                                        Visibility="{Binding HasMultipleSheets, Converter={StaticResource BoolToVis}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid Height="26">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Tri-State CheckBox for All Worksheets -->
                                                        <CheckBox Grid.Column="0" 
                                                                  IsThreeState="True"
                                                                  IsChecked="{Binding AreAllWorksheetsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand"
                                                                  ToolTip="Select / Deselect all worksheets"/>

                                                        <!-- Title: All worksheets -->
                                                        <TextBlock Grid.Column="1" Text="All worksheets" 
                                                                   FontWeight="SemiBold" FontSize="11.5" Foreground="#1E293B" 
                                                                   VerticalAlignment="Center"/>

                                                        <!-- Selection status count -->
                                                        <TextBlock Grid.Column="2" 
                                                                   Text="{Binding ViewsCount, StringFormat='{}{0} selected'}" 
                                                                   FontSize="10.5" Foreground="#64748B" FontWeight="Medium"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Individual Worksheet Lines -->
                                                <ItemsControl ItemsSource="{Binding Sheets}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderThickness="0" Padding="32,2,12,2"
                                                                    PreviewMouseLeftButtonDown="SheetRow_PreviewMouseLeftButtonDown"
                                                                    Cursor="Hand">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
                                                                            </Trigger>
                                                                            <DataTrigger Binding="{Binding IsRowSelected}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid Height="26">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Checkbox for sheet selection -->
                                                                    <CheckBox Grid.Column="0" 
                                                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand"/>

                                                                    <!-- Sheet Name (clean text without icon) -->
                                                                    <TextBlock Grid.Column="1" Text="{Binding SheetName}" FontSize="11.5" FontWeight="Medium" 
                                                                               Foreground="#334155" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                                    <!-- Printable Area / Region dropdown at the far right -->
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                        <TextBlock Text="Area:" FontSize="11" Foreground="#64748B" 
                                                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                        <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="0" Background="White" Height="24">
                                                                            <ComboBox ItemsSource="{Binding AvailableRegions}"
                                                                                      SelectedItem="{Binding SelectedRegion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                      ItemContainerStyle="{StaticResource RegionComboBoxItemStyle}"
                                                                                      Width="145" Height="22"
                                                                                      BorderThickness="0" Background="Transparent"
                                                                                      VerticalContentAlignment="Center" FontSize="11" Padding="4,0"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </SelectiveScrollingGrid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="FileRowBorder" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="FileRowBorder" Property="Background" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <!-- Col 0: Views (Arrow on Left + Count on Right) -->
                    <DataGridTemplateColumn Header="Views" Width="68">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,4,0">
                                    <Button Click="ChevronButton_Click"
                                            Visibility="{Binding HasSheets, Converter={StaticResource BoolToVis}}"
                                            Width="20" Height="20" Margin="0,0,4,0"
                                            Cursor="Hand" Background="Transparent" BorderThickness="0"
                                            Focusable="False" ClickMode="Press"
                                            ToolTip="Expand / Collapse worksheets"
                                            Template="{StaticResource ChevronButtonTemplate}"/>
                                    <TextBlock Text="{Binding ViewsCount}" FontWeight="Bold" FontSize="12" 
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" 
                                               MinWidth="16" TextAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Col 1: Sheet Icon Header / File Type Icon in cell -->
                    <DataGridTemplateColumn Width="36" HeaderStyle="{StaticResource CenteredTableHeaderStyle}">
                        <DataGridTemplateColumn.Header>
                            <Image Source="pack://application:,,,/TablePlus;component/Resources/Icons/SheetHeader16.png"
                                   Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   ToolTip="File Type"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding FileTypeIconUri}" 
                                       Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       ToolTip="{Binding SourceType}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Col 2: File Name without extension -->
                    <DataGridTemplateColumn Header="File" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileNameWithoutExtension}" 
                                           FontWeight="SemiBold" FontSize="12" 
                                           Foreground="{StaticResource TextPrimaryBrush}" 
                                           VerticalAlignment="Center" Margin="6,0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FileName}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Col 3: Path (with Right-Click Context Menu) -->
                    <DataGridTemplateColumn Header="Path" Width="*" MinWidth="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" ContextMenu="{StaticResource PathContextMenu}">
                                    <TextBlock Text="{Binding DisplayPath}" 
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" 
                                               VerticalAlignment="Center" Margin="6,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ToolTipPath}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ROW 2: TABLE PROPERTIES CARD -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" CornerRadius="0" Padding="12,10" Margin="0,0,0,6">
            <StackPanel Orientation="Vertical">
                <!-- Card Header Title -->
                <TextBlock Text="Table properties" FontWeight="Bold" FontSize="12" Foreground="#999" Margin="0,0,0,8"/>

                <!-- Properties Stack -->
                <Grid IsEnabled="{Binding HasSelectedSheetRow}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Origin -->
                        <RowDefinition Height="Auto"/> <!-- Type of view -->
                        <RowDefinition Height="Auto"/> <!-- Scale -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: Origin -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Origin:" 
                               FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" 
                               VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="0" Background="White" Height="26" Margin="0,0,0,6">
                        <ComboBox ItemsSource="{Binding AvailableImportTypes}"
                                  SelectedItem="{Binding SelectedSheetRow.SelectedImportType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  BorderThickness="0" Background="Transparent"
                                  VerticalContentAlignment="Center" FontSize="11.5" Padding="6,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}, ConverterParameter=Compact}" 
                                               FontSize="11.5" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Border>

                    <!-- Row 1: Type of view -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Type of view:" 
                               FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" 
                               VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="0" Background="White" Height="26" Margin="0,0,0,6">
                        <ComboBox ItemsSource="{Binding AvailableViewTypes}"
                                  SelectedItem="{Binding SelectedSheetRow.SelectedViewType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  BorderThickness="0" Background="Transparent"
                                  VerticalContentAlignment="Center" FontSize="11.5" Padding="6,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}, ConverterParameter=Compact}" 
                                               FontSize="11.5" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Border>

                    <!-- Row 2: Scale -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Scale:" 
                               FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" 
                               VerticalAlignment="Center"/>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="0" Background="White" Height="26">
                        <TextBox Text="{Binding SelectedSheetRow.ScaleInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" FontSize="11.5" Padding="6,0"
                                 ToolTip="Numeric scale value applied to the imported table relative to the origin (e.g., 1, 50, 100)"/>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ROW 3: ERROR BANNER & PROGRESS -->
        <StackPanel Grid.Row="3" Margin="0,6,0,0">
            <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,4"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="11" TextWrapping="Wrap"/>
            </Border>

            <ProgressBar IsIndeterminate="True" Height="3" Background="#E2E8F0" Foreground="{StaticResource PrimaryBrush}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- ROW 4: ACTION FOOTER -->
        <Border Grid.Row="4" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Selection Dropdown -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Selection:" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="3" Background="White" Height="26" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding BatchSelectionOptions}"
                                  SelectedItem="{Binding SelectedBatchSelectionOption}"
                                  SelectionChanged="SelectionComboBox_SelectionChanged"
                                  Width="115" Height="24"
                                  BorderThickness="0" Background="Transparent"
                                  VerticalContentAlignment="Center" FontSize="11" Padding="4,0"/>
                    </Border>
                </StackPanel>

                <!-- Center: Status / Selected count badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border Background="#E0F2FE" CornerRadius="3" Padding="6,2" VerticalAlignment="Center"
                            Visibility="{Binding CanImportBatch, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SelectedBatchCount, StringFormat='{}{0} selected'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#0369A1"/>
                    </Border>
                </StackPanel>

                <!-- Right: Cancel and Apply Buttons -->
                <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0" Height="28" Padding="12,4"/>
                <Button Grid.Column="3" Content="Apply" Command="{Binding ImportBatchTablesCommand}" 
                        IsEnabled="{Binding CanImportBatch}" Style="{StaticResource PrimaryButtonStyle}" Height="28" Padding="16,4"/>
            </Grid>
        </Border>
    </Grid>
</Window>
