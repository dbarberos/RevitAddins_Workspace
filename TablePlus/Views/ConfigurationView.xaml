<Window x:Class="TablePlus.Views.ConfigurationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:TablePlus.ViewModels"
        xmlns:models="clr-namespace:TablePlus.Models"
        Title="Config" Height="680" Width="740"
        MinWidth="680" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/TablePlus;component/Resources/Icons/TablePlus32x32.png"
        Topmost="True" Background="#f5f5f5"
        x:Name="ConfigWindow">
    <Window.DataContext>
        <viewmodels:ConfigurationViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="SwitchStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" Cursor="Hand">
                            <Border x:Name="Background" Width="36" Height="18" Background="#ddd" CornerRadius="9" Padding="2" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="14" Height="14" Fill="White" HorizontalAlignment="Left">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="#bbb"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="18" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Tab Options Block -->
            <RowDefinition Height="Auto"/> <!-- Row 1: Contextual Toggle -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Soft Green Header Banner -->
            <RowDefinition Height="Auto"/> <!-- Row 3: Action Toolbar (+, pencil, trashcan) -->
            <RowDefinition Height="*"/>    <!-- Row 4: Sources DataGrid / ListView -->
            <RowDefinition Height="Auto"/> <!-- Row 5: Restart Note -->
            <RowDefinition Height="Auto"/> <!-- Row 6: Bottom Buttons -->
        </Grid.RowDefinitions>

        <!-- White Content Block (Tab Options) -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,10" BorderBrush="#e8e8e8" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Tab Option (*)" FontWeight="500" Margin="0,0,0,8" Foreground="#333"/>

                <RadioButton Content="Place TablePlus on Add-Ins tab (default)" IsChecked="{Binding IsAddInsDefaultTabSelected}" Margin="0,0,0,6"/>
                <RadioButton Content="Place on Revit Manage tab (Manage Project)" IsChecked="{Binding IsRevitDefaultSelected}" Margin="0,0,0,6"/>
                <RadioButton Content="Place on tab named:" IsChecked="{Binding IsCustomSelected}" Margin="0,0,0,4"/>

                <TextBox Text="{Binding CustomTabName, UpdateSourceTrigger=PropertyChanged}" 
                         IsEnabled="{Binding IsCustomSelected}" 
                         Margin="24,0,0,0" Padding="6,4" Width="220" HorizontalAlignment="Left" 
                         BorderBrush="#e0e0e0" BorderThickness="1" Background="#fafafa"/>
            </StackPanel>
        </Border>

        <!-- Contextual New Table Toggle -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5,0,0,10">
            <CheckBox Content="Create new linked table from right-click context menu" 
                      IsChecked="{Binding UseAsContextualFilter}" 
                      Style="{StaticResource SwitchStyle}"
                      VerticalAlignment="Center" Foreground="#555"/>

            <Button Command="{Binding ShowHelpDialogCommand}" Margin="12,0,0,0" VerticalAlignment="Center" Cursor="Hand" Background="Transparent" BorderThickness="0" ToolTip="Help">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Viewbox Width="18" Height="18">
                            <Path Data="M10,19H13V22H10V19M12,2C17.35,2 19,5.33 19,8C19,11.75 14.99,11.91 14.18,14.03C13.97,14.59 13.79,15.05 13.79,15.05H10.11L10.1,14.33C10.1,11.67 12,11 13.1,9.83C13.92,8.96 13.9,8.11 13.9,7.8C13.9,6.5 12.8,5.9 12,5.9C10.69,5.9 9.83,6.67 9.83,6.67L8.22,3.83C8.22,3.83 9.71,2 12,2Z" 
                                  Fill="#bbb" x:Name="helpIcon"/>
                        </Viewbox>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="helpIcon" Property="Fill" Value="#777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- Soft Green Header Banner -->
        <Border Grid.Row="2" Background="#E8F5E9" BorderBrush="#C3E6CB" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
            <TextBlock Text="This view allows you to manage the external sources used for table creation and spreadsheets (.xlsx, .xlsm, .xls, .csv) in the application. You can add new table sources, edit existing ones, or remove sources that are no longer needed. Each source can be activated or deactivated, and its active status determines which sources will be displayed in the 'Add Table' creation window. Use the controls provided to organize and maintain your table sources efficiently."
                       Foreground="#155724" FontSize="11.5" TextWrapping="Wrap" LineHeight="16"/>
        </Border>

        <!-- Action Toolbar -->
        <Border Grid.Row="3" Padding="2,0,2,6">
            <StackPanel Orientation="Horizontal">
                <!-- Add Button -->
                <Button Command="{Binding AddSourceCommand}" CommandParameter="{Binding ElementName=ConfigWindow}" 
                        Width="28" Height="28" Margin="0,0,8,0" Cursor="Hand" ToolTip="Add Table Source">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="Transparent" CornerRadius="4" Padding="4">
                                <Viewbox Width="18" Height="18">
                                    <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="#777" x:Name="iconPath"/>
                                </Viewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#eeeeee"/>
                                    <Setter TargetName="iconPath" Property="Fill" Value="#333"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#dddddd"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Edit Button -->
                <Button Command="{Binding EditSourceCommand}" CommandParameter="{Binding ElementName=ConfigWindow}" 
                        Width="28" Height="28" Margin="0,0,8,0" Cursor="Hand" ToolTip="Edit Table Source">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="Transparent" CornerRadius="4" Padding="4">
                                <Viewbox Width="18" Height="18">
                                    <Path Data="M14.06,9.02L14.98,9.94L5.92,19H5V18.08L14.06,9.02M17.66,3C17.41,3 17.15,3.1 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18.17,3.09 17.92,3 17.66,3M14.06,6.19L3,17.25V21H6.75L17.81,9.94L14.06,6.19Z" Fill="#777" x:Name="iconPath"/>
                                </Viewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#eeeeee"/>
                                    <Setter TargetName="iconPath" Property="Fill" Value="#333"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#dddddd"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Remove Button -->
                <Button Command="{Binding RemoveSourceCommand}" 
                        Width="28" Height="28" Cursor="Hand" ToolTip="Remove Table Source">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="Transparent" CornerRadius="4" Padding="4">
                                <Viewbox Width="18" Height="18">
                                    <Path Data="M16,9V19H8V9H16M14.5,3H9.5L8.5,4H5V6H19V4H15.5L14.5,3M18,7H6V19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7Z" Fill="#777" x:Name="iconPath"/>
                                </Viewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#eeeeee"/>
                                    <Setter TargetName="iconPath" Property="Fill" Value="#333"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#dddddd"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- Data Grid / ListView -->
        <Border Grid.Row="4" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
            <ListView ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      BorderThickness="0" Background="Transparent" MinHeight="160">
                <ListView.View>
                    <GridView>
                        <!-- Active CheckBox Column -->
                        <GridViewColumn Header="Active" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:TableSourceItemModel}">
                                    <CheckBox IsChecked="{Binding IsActive}" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Name Column -->
                        <GridViewColumn Header="Name" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:TableSourceItemModel}">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Source Description Column -->
                        <GridViewColumn Header="Source" Width="440">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:TableSourceItemModel}">
                                    <TextBlock Text="{Binding SourceDescription}" Foreground="#555555" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Restart Note -->
        <TextBlock Grid.Row="5" Text="* You must restart Revit in order to apply ribbon tab changes." 
                   FontStyle="Italic" Foreground="#999" TextWrapping="Wrap" Margin="5,0,0,6"/>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="6" Margin="0,6,0,0">
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0">
                <Hyperlink Command="{Binding OpenPrivacyPolicyCommand}" Foreground="#007ACC" TextDecorations="None">
                    Privacy Policy
                </Hyperlink>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Logs Window" Command="{Binding ToggleDebugWindowCommand}" 
                        Width="92" Height="24" Margin="0,0,10,0" Background="White" BorderBrush="#ccc" BorderThickness="1">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Cancel" Command="{Binding CancelCommand}" CommandParameter="{Binding ElementName=ConfigWindow}" 
                        Width="92" Height="24" Margin="0,0,10,0" Background="White" BorderBrush="#ccc" BorderThickness="1">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Save" Command="{Binding SaveCommand}" CommandParameter="{Binding ElementName=ConfigWindow}" 
                        Width="92" Height="24" Background="#007ACC" Foreground="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
