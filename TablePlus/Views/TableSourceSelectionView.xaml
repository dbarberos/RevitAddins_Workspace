<Window x:Class="TablePlus.Views.TableSourceSelectionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:TablePlus.ViewModels"
        mc:Ignorable="d"
        x:Name="SourceSelectionWin"
        Title="TablePlus"
        Width="620" Height="170"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FAFAFA"
        Foreground="#1E293B"
        FontFamily="Segoe UI, Inter, Arial"
        FontSize="12.5"
        Icon="pack://application:,,,/TablePlus;component/Resources/Icons/TablePlus32x32.png">

    <Window.Resources>
        <!-- iOS Style Switch matching MainWindowView.xaml -->
        <Style x:Key="SwitchStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" Cursor="Hand">
                            <Border x:Name="Background" Width="28" Height="14" Background="#ddd" CornerRadius="7" Padding="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="White" HorizontalAlignment="Left">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="#777"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" 
                                                             To="14" 
                                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" 
                                                             To="0" 
                                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Background" Property="Opacity" Value="0.4"/>
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title matching Filter & Organize card header style (FontWeight="Bold", FontSize="12", Foreground="#999") -->
        <TextBlock Grid.Row="0" 
                   Text="Select the source of your file/s:" 
                   FontWeight="Bold" 
                   FontSize="12" 
                   Foreground="#999" 
                   Margin="0,0,0,8" 
                   HorizontalAlignment="Left"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Dropdown matching TransferPlus top input structure, style, and dimensions -->
            <Border Grid.Column="0" BorderBrush="#007ACC" BorderThickness="1.5" CornerRadius="4" Height="32" Background="White" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding Sources}" 
                          SelectedItem="{Binding SelectedSource}" 
                          DisplayMemberPath="DisplayName" 
                          Background="Transparent" 
                          BorderThickness="0" 
                          VerticalContentAlignment="Center" 
                          Padding="10,0"
                          FontSize="12"/>
            </Border>

            <!-- Action Button to the right -->
            <Button Grid.Column="1" Content="Select" 
                    Command="{Binding SelectCommand}" 
                    CommandParameter="{Binding ElementName=SourceSelectionWin}"
                    Height="32" Padding="26,0" Margin="12,0,0,0"
                    Foreground="White" FontWeight="SemiBold" FontSize="12.5"
                    BorderThickness="0" Cursor="Hand" IsDefault="True">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#007ACC"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0062A3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004C80"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Row 2: Relative Path Switch (Enabled only for local disk / folder sources) -->
        <CheckBox Grid.Row="2" 
                  Content="Use relative path" 
                  IsChecked="{Binding IsRelativePath}" 
                  IsEnabled="{Binding IsRelativePathEnabled}" 
                  Style="{StaticResource SwitchStyle}" 
                  FontSize="11" 
                  Foreground="#475569" 
                  Margin="0,14,0,0" 
                  HorizontalAlignment="Left">
            <CheckBox.ToolTip>
                <ToolTip MaxWidth="280">
                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#333333">
                        <Bold>Relative Path</Bold><LineBreak/>
                        When enabled, table file links are saved as relative paths instead of absolute paths. Only applicable to local storage sources.
                    </TextBlock>
                </ToolTip>
            </CheckBox.ToolTip>
        </CheckBox>
    </Grid>
</Window>
