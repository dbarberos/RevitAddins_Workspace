<Window x:Class="TablePlus.Views.CloudFileBrowserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:TablePlus.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="740" Height="520"
        MinWidth="580" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#FAFAFA"
        Foreground="#1E293B"
        FontFamily="Segoe UI, Inter, Arial"
        FontSize="12.5"
        Icon="pack://application:,,,/TablePlus;component/Resources/Icons/TablePlus32x32.png">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0062A3"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button Style -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Search & Select All Tools -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Error / Progress -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding WindowTitle}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding SourceDetails}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- TOOLBAR: SEARCH & SELECT ALL -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Box -->
            <Border Grid.Column="0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Background="White" Height="30" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" Margin="8,0,4,0" VerticalAlignment="Center" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                             Padding="4,0,8,0" FontSize="12" ToolTip="Type to filter files by name"/>
                </Grid>
            </Border>

            <!-- Quick Selection Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Select All" Command="{Binding SelectAllCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0,0,6,0"/>
                <Button Content="Deselect All" Command="{Binding DeselectAllCommand}" Style="{StaticResource GhostButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- FILES DATAGRID -->
        <Border Grid.Row="2" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Background="White">
            <DataGrid ItemsSource="{Binding ItemsView}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9"
                      Background="White"
                      BorderThickness="0"
                      RowHeight="32"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <!-- Col 0: CheckBox Selection -->
                    <DataGridTemplateColumn Width="46">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Col 1: File Name -->
                    <DataGridTemplateColumn Header="File Name" Width="*" SortMemberPath="FileName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" Margin="6,0" 
                                           FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Col 2: Size -->
                    <DataGridTextColumn Header="Size" Width="100" Binding="{Binding FormattedSize}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,12,0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Col 3: Last Modified -->
                    <DataGridTextColumn Header="Modified" Width="140" Binding="{Binding LastModified}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="6,0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ERROR / BUSY BANNER -->
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <!-- Error Banner -->
            <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="11.5" TextWrapping="Wrap"/>
            </Border>

            <!-- Busy Progress -->
            <ProgressBar IsIndeterminate="True" Height="4" Background="#E2E8F0" Foreground="{StaticResource PrimaryBrush}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- FOOTER ACTIONS -->
        <Border Grid.Row="4" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <Border Background="#E0F2FE" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding CanConfirm, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} selected'}" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0,0,10,0" Height="32"/>
                <Button Grid.Column="2" Content="OK" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}" Style="{StaticResource PrimaryButtonStyle}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
