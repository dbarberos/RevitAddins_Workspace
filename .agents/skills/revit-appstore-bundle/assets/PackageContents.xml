  <CompanyDetails
    Name="{{Author}}"
    Url="https://apps.autodesk.com/en/Publisher/PublisherHomepage"
    Email="{{Email}}" />

  <!-- The components will be dynamically injected here by the PowerShell script -->
  {{Components}}

</ApplicationPackage>
