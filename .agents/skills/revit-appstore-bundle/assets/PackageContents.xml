<?xml version="1.0" encoding="utf-8"?>
<ApplicationPackage
  SchemaVersion="1.0"
  AppVersion="{{Version}}"
  Author="{{Author}}"
  Description="{{AppName}}"
  Name="{{AppName}}"
  ProductCode="{{ProductCode}}"
  OnlineDocumentation="https://dbdev-dbarberos.github.io/PrivacyPolicy/"
  ProductType="Application"
  Icon="./Contents/Resources/Icons/RibbonIcon32.png"
