<Window x:Class="FilterPlus.Views.SelectionFilterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:viewmodels="clr-namespace:FilterPlus.ViewModels"
        xmlns:services="clr-namespace:FilterPlus.Services"
        xmlns:converters="clr-namespace:FilterPlus.Converters"
        mc:Ignorable="d"
        Title="FilterPlus" Height="937" Width="940"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/FilterPlus;component/Resources/Icons/RibbonIcon32.png"
        Topmost="True" Background="#f5f5f5">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:EnumToBoolConverter x:Key="EnumToBool"/>
        <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">10</sys:Double>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5,15,0,0"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>

        <HierarchicalDataTemplate x:Key="CheckboxTreeTemplate" DataType="{x:Type viewmodels:TreeItemViewModel}" ItemsSource="{Binding Children}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="2,4">
                    <CheckBox IsChecked="{Binding IsChecked}" IsThreeState="True" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding Name}" FontWeight="Normal" Margin="0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="LightGray" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
            </Grid>
        </HierarchicalDataTemplate>

        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="10" Padding="4">
                            <Viewbox Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#f0f0f0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e0e0e0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwitchStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" Cursor="Hand">
                            <Border x:Name="Background" Width="28" Height="14" Background="#ddd" CornerRadius="7" Padding="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="White" HorizontalAlignment="Left">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="#777"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="14" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/> <!-- Árbol (Flexible, aprox 720px) -->
            <ColumnDefinition Width="10"/> <!-- Separador (Espacio de separación) -->
            <ColumnDefinition Width="376"/> <!-- Filtros y Selección (350px tarjeta + 17px scrollbar + 9px gap) -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- DOCUMENT CONTEXT DISPLAY AND SELECT -->
        <Border Grid.ColumnSpan="3" Grid.Row="0" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Apply FilterPlus with:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#333"/>
                <Border Grid.Column="1" BorderBrush="#007ACC" BorderThickness="1.5" Background="White" CornerRadius="4" Height="30" Padding="8,0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding SelectedModelsText}" VerticalAlignment="Center" Margin="0" Foreground="#333" FontWeight="Normal"/>
                </Border>
                <Button Grid.Column="2" Content="Select" Command="{Binding OpenModelSelectionCommand}" Width="80" Height="30" Margin="0" VerticalAlignment="Center" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- COLUMNA IZQUIERDA: EXPLORADOR JERÁRQUICO -->
        <Grid Grid.Column="0" Grid.Row="1" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Border Grid.Row="0" Background="#f9f9f9" BorderBrush="#d0d0d0" BorderThickness="0,0,0,1" Margin="0,0,10,0" Padding="0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Elements" FontWeight="Bold" Margin="25,0,8,0" VerticalAlignment="Center"/>
                    
                    <Button Grid.Column="1" Command="{Binding ExpandAllCommand}" Style="{StaticResource HeaderIconButtonStyle}" ToolTip="Expand All" VerticalAlignment="Center">
                        <Path Data="M0,0 L10,0 L5,8 Z" Fill="#666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    
                    <Button Grid.Column="2" Command="{Binding CollapseAllCommand}" Style="{StaticResource HeaderIconButtonStyle}" ToolTip="Collapse All" VerticalAlignment="Center">
                        <Path Data="M5,0 L10,8 L0,8 Z" Fill="#666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    
                    <TextBlock Grid.Column="4" Text="Count" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,5,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <TreeView Grid.Row="1" ItemsSource="{Binding RootNodes}" 
                      ItemTemplate="{StaticResource CheckboxTreeTemplate}"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      HorizontalContentAlignment="Stretch"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Standard"
                      BorderThickness="0" Background="Transparent">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
                        <Setter Property="Background" Value="#f9f9f9"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TreeViewItem">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <!-- Header row acts as background for whole line. Border is White for gap -->
                                        <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="0,0,0,1" SnapsToDevicePixels="true">
                                            <!-- The content is indented by IndentMargin from ViewModel -->
                                            <Grid Margin="{Binding IndentMargin}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Expander Toggle -->
                                                <ToggleButton x:Name="Expander" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Width="20" Height="20" Background="Transparent" Cursor="Hand">
                                                                <TextBlock x:Name="ExpanderText" Text="▶" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10" Foreground="Gray"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="ExpanderText" Property="Text" Value="▼"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                <!-- Content Row -->
                                                <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                            </Grid>
                                        </Border>
                                        <!-- No margin on ItemsHost to avoid WPF default indentation cutting off Backgrounds -->
                                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsExpanded" Value="false">
                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                        <Trigger Property="HasItems" Value="false">
                                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                <Setter Property="Background" Value="#e8f5e9"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecked}" Value="{x:Null}">
                                <Setter Property="Background" Value="#fff8e1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </Grid>

        <!-- COLUMNA DERECHA: SELECCIÓN Y FILTROS (con ScrollViewer y scrollbar a la izquierda) -->
        <ScrollViewer Grid.Column="2" Grid.Row="1" FlowDirection="RightToLeft" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Margin="0" Padding="0">
            <Grid FlowDirection="LeftToRight" Grid.IsSharedSizeScope="True" Margin="0,0,9,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Filter Card -->
                <RowDefinition Height="Auto"/> <!-- Select Card -->
                <RowDefinition Height="Auto"/> <!-- Add Checked Card -->
                <RowDefinition Height="Auto"/> <!-- PreSelection Card 1 -->
            </Grid.RowDefinitions>

            <!-- Card de Filtro -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15,10" Margin="0,0,0,10" BorderBrush="#e8e8e8" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search Box -->
                        <RowDefinition Height="Auto"/> <!-- Search Toggles -->
                    </Grid.RowDefinitions>
                    <!-- Search Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Filter:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#999"/>
                        <TextBox Grid.Column="1" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="2" BorderBrush="#e0e0e0" BorderThickness="1"/>
                        
                        <!-- APPLY BUTTON (NOW ON THE RIGHT) -->
                        <Button Grid.Column="2" Content="Apply" Command="{Binding ApplySearchCommand}" Margin="10,0,0,0" VerticalAlignment="Center" Padding="12,3" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
 
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                        <CheckBox Content="Use OR" IsChecked="{Binding IsUseOr}" Style="{StaticResource SwitchStyle}" FontSize="11" Margin="0,0,10,0"/>
                        <CheckBox Content="Only by name" IsChecked="{Binding IsOnlyByName}" Style="{StaticResource SwitchStyle}" FontSize="11" Margin="0,0,10,0"/>
                        <CheckBox Content="Use Regex" IsChecked="{Binding IsUseRegex}" Style="{StaticResource SwitchStyle}" FontSize="11" Margin="0,0,10,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card de Selección -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15,10" Margin="0,0,0,10" BorderBrush="#e8e8e8" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Select" FontWeight="500" Margin="0,0,0,10" Foreground="#333" FontSize="13"/>
                    
                    <Grid Grid.Row="1" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RightPanelCol1"/>
                            <ColumnDefinition Width="20"/> <!-- Separación reducida -->
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RightPanelCol2"/>
                        </Grid.ColumnDefinitions>

                        
                        <!-- Columna Izquierda: Scopes -->
                        <StackPanel Grid.Column="0">
                            <RadioButton Content="Current Selection" 
                                         IsChecked="{Binding CurrentScope, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static services:SelectionScope.CurrentSelection}}" 
                                         Margin="0,0,0,6" FontSize="11"/>
                            <RadioButton Content="Elements Visible" 
                                         IsChecked="{Binding CurrentScope, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static services:SelectionScope.ElementsVisibleInView}}" 
                                         Margin="0,0,0,6" FontSize="11" ToolTip="Elements Visible in View"/>
                            <RadioButton Content="Elements in View" 
                                         IsChecked="{Binding CurrentScope, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static services:SelectionScope.ElementsBelongingToView}}" 
                                         Margin="0,0,0,6" FontSize="11" ToolTip="Elements belonging to View"/>
                            <RadioButton Content="All Model Elements" 
                                         IsChecked="{Binding CurrentScope, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static services:SelectionScope.AllModelElements}}" 
                                         Margin="0,0,0,0" FontSize="11"/>
                        </StackPanel>
                        
                        <!-- Columna Derecha: Toggles -->
                        <StackPanel Grid.Column="2">
                            <CheckBox Content="Only 3D model objects" IsChecked="{Binding IsOnly3DModels}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,6" FontSize="11"/>
                            <CheckBox Content="Only Annotations" IsChecked="{Binding IsOnlyAnnotation}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,6" FontSize="11"/>
                            <CheckBox Content="Has Bounding Box" IsChecked="{Binding HasBoundingBox}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,6" FontSize="11"/>
                            <CheckBox Content="Sort by Phase" IsChecked="{Binding SortByPhase}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,6" FontSize="11"/>
                            <CheckBox Content="Sort by Level" IsChecked="{Binding SortByLevel}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,6" FontSize="11"/>
                            <CheckBox Content="Sort by Workset" IsChecked="{Binding SortByWorkset}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,6" FontSize="11"/>
                            <CheckBox Content="Sort by Model" IsChecked="{Binding SortByModel}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,6" FontSize="11"/>
                            <CheckBox Content="on Live Selection" IsChecked="{Binding IsLiveSelection}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,0" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Card de Increase Checked -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15,10" Margin="0,0,0,10" BorderBrush="#e8e8e8" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Increase Checked" FontWeight="500" Margin="0,0,0,10" Foreground="#333" FontSize="13"/>
                    
                    <Grid Grid.Row="1" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RightPanelCol1"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RightPanelCol2"/>
                        </Grid.ColumnDefinitions>

                        
                        <!-- Columna Izquierda -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="WHAT" FontSize="9" FontWeight="SemiBold" Foreground="#999" Margin="0,0,0,5"/>
                            <CheckBox Content="Same category" IsChecked="{Binding IncreaseWhatSameCategory}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,6" FontSize="11" ToolTip="Finds all elements belonging to the same Categories as your current selection and adds them to the tree."/>
                            <CheckBox Content="Same Family" IsChecked="{Binding IncreaseWhatSameFamily}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,6" FontSize="11" ToolTip="Finds all elements belonging to the same Families as your current selection and adds them to the tree."/>
                            <CheckBox Content="Same Type" IsChecked="{Binding IncreaseWhatSameType}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,6" FontSize="11" ToolTip="Finds all elements of the exact same Types as your current selection and adds them to the tree."/>
                            <CheckBox Content="Same Workset" IsChecked="{Binding IncreaseWhatSameWorkset}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,6" FontSize="11" ToolTip="Finds all elements located in the same Worksets as your current selection and adds them to the tree."/>
                            <CheckBox Content="Host of Element" IsChecked="{Binding IncreaseWhatHostOfElement}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,6" FontSize="11" ToolTip="If you selected hosted elements (e.g., doors), this finds and adds their parent Hosts (e.g., walls) to the tree."/>
                            <CheckBox Content="Hosted Elements" IsChecked="{Binding IncreaseWhatHostedElements}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,6" FontSize="11" ToolTip="If you selected host elements (e.g., walls), this finds and adds all elements hosted by them to the tree."/>
                            <CheckBox Content="Nested Elements" IsChecked="{Binding IncreaseWhatNestedElements}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,6" FontSize="11" ToolTip="If you selected parent families, this finds and adds all their internal nested subcomponents to the tree."/>
                            <CheckBox Content="Joined Elements" IsChecked="{Binding IncreaseWhatJoinedElements}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,6" FontSize="11" ToolTip="Finds all elements that are geometrically joined to your current selection and adds them to the tree."/>
                            <CheckBox Content="Supercomponent" IsChecked="{Binding IncreaseWhatSupercomponent}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,6" FontSize="11" ToolTip="If you selected nested subcomponents, this finds and adds their parent 'Supercomponent' family to the tree."/>
                            <CheckBox Content="Group or Assembly" IsChecked="{Binding IncreaseWhatGroupOfAssembly}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,6" FontSize="11" ToolTip="Finds all elements that belong to the same Model Groups or Assemblies as your current selection and adds them."/>
                            <CheckBox Content="Dependent" IsChecked="{Binding IncreaseWhatDependent}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,6" FontSize="11" ToolTip="Finds all elements that depend on your selection (like tags or dimensions) and adds them."/>
                            <CheckBox Content="Intersects" IsChecked="{Binding IncreaseWhatIntersects}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,6" FontSize="11" ToolTip="Runs a 3D geometric intersection check and adds any elements that physically collide with your selection."/>
                            <CheckBox Content="Same MEP System" IsChecked="{Binding IncreaseWhatSameMEPSystem}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,0" FontSize="11" ToolTip="Finds the MEP networks of your selection and adds all connected physical pipes, ducts, or equipment to the tree."/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="WHERE" FontSize="9" FontWeight="SemiBold" Foreground="#999" Margin="0,0,0,5"/>
                            <RadioButton Content="All model" IsChecked="{Binding IncreaseWhereAllModel}" GroupName="WhereGroup" Margin="0,0,0,6" FontSize="11"/>
                            <RadioButton Content="Current View" IsChecked="{Binding IncreaseWhereCurrentView}" GroupName="WhereGroup" Margin="0,0,0,6" FontSize="11"/>
                            <RadioButton Content="Visible in current view" IsChecked="{Binding IncreaseWhereVisibleInView}" GroupName="WhereGroup" Margin="0,0,0,6" FontSize="11"/>
                            
                            <TextBlock Text="HOW" FontSize="9" FontWeight="SemiBold" Foreground="#999" Margin="0,5,0,5"/>
                            <RadioButton Content="Add ToCurrent" IsChecked="{Binding IncreaseHowAddToCurrent}" GroupName="HowGroup" Margin="0,0,0,6" FontSize="11"/>
                            <RadioButton Content="Create New" IsChecked="{Binding IncreaseHowCreateNew}" GroupName="HowGroup" Margin="0,0,0,6" FontSize="11"/>

                            <TextBlock Text="UNSELECT ELEMENTS IF" FontSize="9" FontWeight="SemiBold" Foreground="#999" Margin="0,5,0,5"/>
                            <CheckBox Content="Belongs to Group" IsChecked="{Binding IncreaseUnselectBelongsToGroup}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,6" FontSize="11"/>
                            <CheckBox Content="Belongs to Assembly" IsChecked="{Binding IncreaseUnselectBelongsToAssembly}" Style="{StaticResource SwitchStyle}" Margin="0,0,0,0" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <!-- APPLY BUTTON -->
                    <Button Grid.Row="2" Content="Apply" Command="{Binding ApplyIncreaseCheckedCommand}" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="12,3" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- Card 1 de PreSelection (Feature 1) -->
            <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="15,10" Margin="0,0,0,10" BorderBrush="#e8e8e8" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Saved Selections" FontWeight="500" Margin="0,0,0,5" Foreground="#333" FontSize="13"/>

                    <!-- Fila Superior: ComboBox ocupando todo el ancho -->
                    <ComboBox Padding="2" BorderBrush="#e0e0e0" BorderThickness="1" Margin="0,5,0,10"
                              ItemsSource="{Binding SavedSelections}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedSavedSelection}"/>

                    <!-- Fila Inferior: Botones alineados a la derecha -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                        <!-- Botón Recover -->
                        <Button Content="Recover" Command="{Binding RecoverSavedSelectionCommand}" Margin="0,0,5,0" Padding="12,3" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#e0e0e0"/>
                                    <Setter Property="Foreground" Value="#666"/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSavedSelectionSelected}" Value="True">
                                            <Setter Property="Background" Value="#007ACC"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="IsEnabled" Value="True"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Botón Delete (Nuevo) -->
                        <Button Content="Delete" Command="{Binding DeleteSavedSelectionCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,5,0" Padding="12,3" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#e0e0e0"/>
                                    <Setter Property="Foreground" Value="#666"/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSavedSelectionSelected}" Value="True">
                                            <Setter Property="Background" Value="#007ACC"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="IsEnabled" Value="True"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Botón Save -->
                        <Button Content="Save" Command="{Binding OpenSaveSelectionDialogCommand}" Margin="0,0,0,0" Padding="12,3" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            </Grid>
        </ScrollViewer>

        <!-- Pestaña Inferior de Estado/Aplicar -->
        <Border Grid.ColumnSpan="3" Grid.Row="2" Background="#f1f1f1" Padding="15" Margin="-15,10,-15,-15">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <Button Command="{Binding OpenConfigurationCommand}" Margin="0,0,10,0" VerticalAlignment="Bottom" Cursor="Hand" ToolTip="Configuration">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="12" Padding="4">
                                    <Viewbox Width="18" Height="18">
                                        <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.97 19.05,5.05L16.56,6.05C16.04,5.66 15.47,5.34 14.86,5.12L14.47,2.5C14.43,2.25 14.22,2.07 13.97,2.07H9.97C9.72,2.07 9.5,2.25 9.47,2.5L9.09,5.12C8.47,5.34 7.9,5.66 7.38,6.05L4.89,5.05C4.67,4.97 4.4,5.05 4.27,5.27L2.27,8.73C2.15,8.95 2.2,9.22 2.39,9.37L4.5,11C4.47,11.34 4.45,11.67 4.45,12C4.45,12.33 4.47,12.65 4.5,12.97L2.39,14.63C2.2,14.78 2.15,15.05 2.27,15.27L4.27,18.73C4.4,18.95 4.67,19.03 4.89,18.95L7.38,17.95C7.9,18.34 8.47,18.66 9.09,18.88L9.47,21.5C9.5,21.75 9.72,21.93 9.97,21.93H13.97C14.22,21.93 14.43,21.75 14.47,21.5L14.86,18.88C15.47,18.66 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" Fill="#777" x:Name="iconPath"/>
                                    </Viewbox>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#eeeeee"/>
                                        <Setter TargetName="iconPath" Property="Fill" Value="#333"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#dddddd"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Border Background="#ffffff" CornerRadius="8" Padding="15,5" HorizontalAlignment="Left" VerticalAlignment="Bottom" BorderBrush="#e0e0e0" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CheckedElementsCount}" FontSize="24" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#333"/>
                            <TextBlock Text="Elements Checked" VerticalAlignment="Center" Foreground="#666" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Content="Pre-Selection" Command="{Binding OpenPreSelectionCommand}" Margin="0,0,5,0" Height="30" Padding="15,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Select in Revit" Command="{Binding PickElementsCommand}" Margin="0,0,5,0" Height="30" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Clear" Command="{Binding ClearFiltersCommand}" Width="80" Margin="0,0,5,0" Height="30">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Apply Selection" Command="{Binding ApplyFilterCommand}" Width="120" Height="30" Margin="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelectionDirty}" Value="True">
                                        <Setter Property="Background" Value="#007ACC"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Grid Grid.ColumnSpan="3" Grid.RowSpan="2" Background="#70FFFFFF" 
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" 
              Margin="-15">
            <Border Background="White" CornerRadius="8" Padding="25,18" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#007ACC" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Direction="-90" RenderingBias="Quality" ShadowDepth="1" Opacity="0.12"/>
                </Border.Effect>
                <StackPanel Width="220">
                    <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" Foreground="#222" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="Please wait a moment..." FontSize="10.5" FontWeight="Normal" Foreground="#777" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
