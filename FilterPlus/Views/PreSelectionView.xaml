<Window x:Class="FilterPlus.Views.PreSelectionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:FilterPlus.ViewModels"
        xmlns:models="clr-namespace:FilterPlus.Models"
        mc:Ignorable="d"
        Title="Filter Rules" Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        Topmost="True" Background="#f5f5f5" ShowInTaskbar="False" ResizeMode="CanResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Template for a Single Rule -->
        <DataTemplate DataType="{x:Type models:PreSelectionRule}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>

                <!-- Property selector -->
                <ComboBox Grid.Column="0" ItemsSource="{Binding Properties}" SelectedItem="{Binding SelectedProperty}" Margin="0,0,10,0" Padding="4" VerticalAlignment="Center"/>

                <!-- Value selector -->
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableValues}" SelectedItem="{Binding SelectedValue}" IsEditable="True" Padding="4" VerticalAlignment="Center"/>

                <!-- Delete button (Red Rounded Dash Vector) -->
                <Button Grid.Column="2" 
                        Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                        CommandParameter="{Binding}"
                        Margin="5,0,0,0" Padding="0" Height="24" Width="24" 
                        Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <!-- Rounded red dash (weight 600, corner radius 1.5) -->
                                            <Border Height="3" Width="12" CornerRadius="1.5" Background="#d9534f" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- Template for a nested Rule Set -->
        <DataTemplate DataType="{x:Type models:PreSelectionRuleSet}">
            <Border BorderThickness="3,1,1,1" CornerRadius="2" Padding="8" Margin="0,5,0,5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#3E7D3F"/> <!-- Green for AND -->
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LogicalOperator}" Value="OR (Any rule may be true)">
                                <Setter Property="BorderBrush" Value="#004F8C"/> <!-- Blue for OR -->
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <!-- Header Row: Operator, Add Rule, Add Set, Delete Set -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" ItemsSource="{Binding LogicalOperators}" SelectedItem="{Binding LogicalOperator}" VerticalAlignment="Center" Padding="4">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Foreground" Value="#3E7D3F"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LogicalOperator}" Value="OR (Any rule may be true)">
                                            <Setter Property="Foreground" Value="#004F8C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <Button Grid.Column="1" Content="Add Rule" 
                                Command="{Binding AddRuleCommand}" 
                                Margin="10,0,0,0" Padding="12,4" VerticalAlignment="Center"/>
                                
                        <Button Grid.Column="2" Content="Add Set" 
                                Command="{Binding AddSetCommand}" 
                                Margin="5,0,0,0" Padding="12,4" VerticalAlignment="Center"/>

                        <!-- Delete Set button (Red Vector X), hidden for Root Set -->
                        <Button Grid.Column="3" 
                                Command="{Binding DataContext.RemoveSetCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                CommandParameter="{Binding}"
                                Margin="10,0,0,0" Padding="0" Height="24" Width="24"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Background="Transparent">
                                                    <!-- Rounded red X (weight 600) to match the dash -->
                                                    <Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="#d9534f" StrokeThickness="3" StrokeEndLineCap="Round" StrokeStartLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Children list with left indentation -->
                    <ItemsControl ItemsSource="{Binding Children}" Margin="20,0,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title / Header -->
            <RowDefinition Height="*"/>    <!-- Rules area -->
            <RowDefinition Height="Auto"/> <!-- Buttons footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="Filter Rules" FontSize="14" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center" Margin="0"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="All Model Elements" 
                             IsChecked="{Binding IsAllModelElements, Mode=TwoWay}" 
                             Margin="0,0,15,0" 
                             VerticalAlignment="Center"/>
                <RadioButton Content="Elements in View" 
                             IsChecked="{Binding IsElementsInView, Mode=TwoWay}" 
                             VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Rules Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,15">
            <!-- Root Rule Set -->
            <ContentControl Content="{Binding RootSet}"/>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="15,5" Margin="0,0,10,0"/>
            <Button Content="Apply" Command="{Binding ApplyCommand}" Padding="15,5" Background="#007ACC" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
