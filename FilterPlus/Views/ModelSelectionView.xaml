<Window x:Class="FilterPlus.Views.ModelSelectionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:FilterPlus.ViewModels"
        mc:Ignorable="d"
        Title="Select model or models" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        Topmost="True" Background="#f5f5f5" ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <!-- Circle-shaped CheckBox style for Toggle All -->
        <Style x:Key="CircularCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <BulletDecorator Background="Transparent" Cursor="Hand">
                            <BulletDecorator.Bullet>
                                <Grid Width="16" Height="16" Margin="0,0,8,0">
                                    <Ellipse x:Name="border" Stroke="#999" StrokeThickness="1.5" Fill="White"/>
                                    <Ellipse x:Name="dot" Width="8" Height="8" Fill="#007ACC" Visibility="Collapsed"/>
                                </Grid>
                            </BulletDecorator.Bullet>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="border" Property="Stroke" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Stroke" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Switch Style for model rows (matching SelectionFilterView.xaml style but with #777) -->
        <Style x:Key="SwitchStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" Cursor="Hand">
                            <Border x:Name="Background" Width="28" Height="14" Background="#ddd" CornerRadius="7" Padding="2" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="White" HorizontalAlignment="Left">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="#777"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="14" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Select all models checkbox -->
            <RowDefinition Height="10"/>   <!-- Space -->
            <RowDefinition Height="*"/>    <!-- Models list -->
            <RowDefinition Height="Auto"/> <!-- Footer buttons -->
        </Grid.RowDefinitions>

        <!-- Header: Toggle All -->
        <Border Grid.Row="0" Background="White" BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="6" Padding="12,10">
            <CheckBox Content="Select all models" 
                      IsChecked="{Binding IsSelectAll, Mode=TwoWay}"
                      Style="{StaticResource CircularCheckBoxStyle}"
                      FontWeight="SemiBold" Foreground="#333"/>
        </Border>

        <!-- Body: Models List -->
        <Border Grid.Row="2" Background="White" BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,15">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Models}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#f0f0f0" BorderThickness="0,0,0,1" Padding="0,8">
                                <CheckBox Style="{StaticResource SwitchStyle}" 
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <TextBlock Text="{Binding DisplayName}" Foreground="#333" FontSize="12.5"/>
                                </CheckBox>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="15,5" Margin="0,0,10,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Apply" Command="{Binding ApplyCommand}" Padding="15,5" Background="#007ACC" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
