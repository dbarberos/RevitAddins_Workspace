                <File Source="..\bin\Release.R24\publish\FilterPlus\Nice3point.Revit.Toolkit.dll" Id="Tlk24"/>
                <File Source="..\bin\Release.R24\publish\FilterPlus\CommunityToolkit.Mvvm.dll" Id="Mvvm24"/>
