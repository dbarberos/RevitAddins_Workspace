            <Component Id="Addin_2027" Guid="431736DA-E479-46C5-AD02-4408B5CB1EDF" Directory="REVIT2027">
                <RegistryValue Root="HKCU" Key="Software\DBDev_dbarberos\FilterPlus\2027" Name="addin" Type="integer" Value="1" KeyPath="yes" />
                <File Source="..\bin\Release.R27\publish\FilterPlus.addin" Id="Ad27"/>
