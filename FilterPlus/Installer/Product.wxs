                <File Source="..\bin\Release.R25\publish\FilterPlus\Nice3point.Revit.Toolkit.dll" Id="Tlk25"/>
                <File Source="..\bin\Release.R25\publish\FilterPlus\CommunityToolkit.Mvvm.dll" Id="Mvvm25"/>
                <RemoveFolder Id="RemoveFolder2025" Directory="FOLDER2025" On="uninstall" />
            </Component>
        </ComponentGroup>

        <!-- Revit 2026 -->
        <ComponentGroup Id="Revit2026Components">
            <Component Id="Addin_2026" Guid="4C153BF1-9C93-4065-A504-6900BC53EFDC" Directory="REVIT2026">
                <RegistryValue Root="HKCU" Key="Software\DBDev_dbarberos\FilterPlus\2026" Name="addin" Type="integer" Value="1" KeyPath="yes" />
